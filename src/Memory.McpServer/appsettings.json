{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=contexthub;Username=contexthub;Password=contexthub",
    "Redis": "localhost:6379"
  },
  "Memory": {
    "Namespace": "contexthub"
  },
  "ContextHub": {
    "Security": {
      "RequireAuthentication": true,
      "BootstrapToken": "",
      "BootstrapTenantSlug": "context-team",
      "BootstrapUsername": "dashboard-service",
      "BootstrapAllowedProjectIds": "ContextHub"
    }
  },
  "Embeddings": {
    "Provider": "Deterministic",
