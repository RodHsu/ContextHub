{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=contexthub;Username=contexthub;Password=contexthub",
    "Redis": "localhost:6379"
  },
  "Memory": {
    "Namespace": "contexthub"
  },
  "Embeddings": {
    "Provider": "Deterministic",
    "Profile": "compact",
    "ModelKey": "",
    "Dimensions": 0,
    "MaxTokens": 0,
    "InferenceThreads": 0,
    "BatchSize": 0
  },
  "DatabaseLogging": {
    "MinimumLevel": "Warning",
    "BatchSize": 50,
    "FlushIntervalSeconds": 2
  },
  "TelemetryRetention": {
    "Enabled": true,
    "HitsRetentionDays": 3,
    "EventsRetentionDays": 7,
    "SummaryRetentionDays": 30,
    "SecurityAuditRetentionDays": 180,
    "RuntimeLogRetentionDays": 30,
    "MaintenanceRunRetentionDays": 180,
    "HitSummaryTopPerBucket": 100,
    "RunAtLocalTime": "03:30",
    "TimeZone": "Asia/Taipei",
    "BatchSize": 5000,
    "EventBatchSize": 1000,
    "TimeWindowDays": 3,
    "DelayBetweenBatchesMs": 250,
    "CommandTimeoutSeconds": 300,
    "MaxDurationMinutes": 15,
    "RunVacuumAnalyzeAfterRetention": true,
    "RunVacuumFullAutomatically": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
