@inherits LayoutComponentBase
@using Memory.Application

<AuthorizeView>
    <Authorized Context="auth">
        @{
            var isAdmin = IsDashboardAdmin(auth.User);
            var groups = DashboardNavigation.VisibleGroups(isAdmin).ToArray();
        }
        <div class="dashboard-shell" data-dashboard-interactive="@(_interactiveReady ? "true" : "false")">
            <div class="shell-progress-strip" aria-hidden="true"></div>
            <input id="dashboard-mobile-nav-toggle" class="mobile-nav-toggle" type="checkbox" aria-hidden="true" tabindex="-1" />
            <label class="mobile-nav-button" for="dashboard-mobile-nav-toggle" aria-label="切換主選單">
                <span class="mobile-nav-button-line"></span>
                <span class="mobile-nav-button-line"></span>
                <span class="mobile-nav-button-line"></span>
            </label>
            <label class="mobile-nav-backdrop" for="dashboard-mobile-nav-toggle" aria-hidden="true"></label>

            <aside class="sidebar" aria-label="主要導覽">
                <div class="sidebar-inner">
                    <div class="brand">
                        <div class="brand-mark">C</div>
                        <div>
                            <div class="brand-title">ContextHub</div>
                            <div class="brand-subtitle">靜默訊號</div>
                        </div>
                    </div>

                    @foreach (var group in groups)
                    {
                        <div class="sidebar-section-label">@group.Label</div>
                        <nav class="sidebar-nav" aria-label="@group.Label">
                            @foreach (var route in group.Items)
                            {
                                <NavLink class="nav-item" href="@route.Href" Match="@route.Match" title="@route.Description">
                                    <span class="nav-icon nav-icon-mark" aria-hidden="true">@route.Mark</span>
                                    <span class="nav-label">@route.Label</span>
                                </NavLink>
                            }
                        </nav>
                    }

                    <div class="sidebar-bottom">
                        <div class="sidebar-build">
                            <span class="sidebar-build-label">管理介面</span>
                            <span class="sidebar-build-value">@BuildMetadata.Current.Version</span>
                            <span class="sidebar-build-time"><ClientLocalTime Value="BuildMetadata.Current.TimestampUtc" /></span>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="main-shell">
                <header class="topbar">
                    <div class="topbar-context">
                        <div class="topbar-title">
                            <span class="status-dot"></span>
                            <span>ContextHub</span>
                        </div>
                        <div class="topbar-subtitle">平台營運與知識治理</div>
                    </div>

                    <div class="topbar-actions">
                        <button type="button"
                                class="command-button"
                                aria-haspopup="dialog"
                                aria-expanded="@_commandPaletteOpen"
                                @onclick="OpenCommandPalette">
                            <span class="command-button-icon" aria-hidden="true">⌕</span>
                            <span class="command-button-label">搜尋功能</span>
                            <span class="command-button-kbd">⌘K</span>
                        </button>
                        <ThemeSwitcher />
                        <span class="topbar-user">@auth.User.Identity?.Name</span>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="ghost-button">登出</button>
                        </form>
                    </div>
                </header>

                <main class="content" id="dashboard-main-content">
                    @Body
                </main>
                <footer class="dashboard-footer">
                    <span>ContextHub</span>
                    <span>平台營運與知識治理主控台</span>
                </footer>
            </div>

            @if (_commandPaletteOpen)
            {
                <div class="command-overlay" role="presentation" @onclick="CloseCommandPalette">
                    <section class="command-palette" role="dialog" aria-modal="true" aria-label="快速切換功能" @onclick:stopPropagation="true">
                        <div class="command-palette-header">
                            <div>
                                <div class="command-palette-eyebrow">Canonical navigation</div>
                                <h2>快速切換功能</h2>
                            </div>
                            <button type="button" class="icon-button" aria-label="關閉快速切換功能" @onclick="CloseCommandPalette">×</button>
                        </div>

                        <div class="command-palette-body">
                            @foreach (var group in groups)
                            {
                                <div class="command-group">
                                    <div class="command-group-title">@group.Label</div>
                                    <div class="command-route-grid">
                                        @foreach (var route in group.Items)
                                        {
                                            <NavLink class="command-route" href="@route.Href" Match="@route.Match" @onclick="CloseCommandPalette">
                                                <span class="command-route-mark" aria-hidden="true">@route.Mark</span>
                                                <span class="command-route-copy">
                                                    <span class="command-route-title">@route.Label</span>
                                                    <span class="command-route-path">@route.Description</span>
                                                </span>
                                            </NavLink>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool _commandPaletteOpen;
    private bool _interactiveReady;

    private static bool IsDashboardAdmin(System.Security.Claims.ClaimsPrincipal user)
        => user.IsInRole(TenantUserRole.Owner.ToString()) ||
           user.IsInRole(TenantUserRole.Admin.ToString()) ||
           user.IsInRole("DashboardAdmin");

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _interactiveReady = true;
        StateHasChanged();
    }

    private void OpenCommandPalette() => _commandPaletteOpen = true;
    private void CloseCommandPalette() => _commandPaletteOpen = false;
}
