@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized Context="auth">
        @{
            var isAdmin = DashboardRouteAuthorization.IsAdmin(auth.User);
            var groups = DashboardNavigation.VisibleGroups(isAdmin).ToArray();
            var currentGroup = groups.FirstOrDefault(group => group.Items.Any(item => DashboardNavigation.IsCurrent(item, CurrentPath)));
            var currentRoute = currentGroup?.Items.FirstOrDefault(item => DashboardNavigation.IsCurrent(item, CurrentPath));
            var searchGroups = FilterGroups(groups).ToArray();
        }
        <div class="dashboard-shell workspace-shell" data-dashboard-interactive="@(_interactiveReady ? "true" : "false")">
            <a class="skip-link" href="#dashboard-main-content">跳到主要內容</a>
            <aside class="sidebar" aria-label="主要導覽">
                <div class="sidebar-inner">
                    <a class="brand" href="@(isAdmin ? "/" : "/memories")" aria-label="ContextHub 首頁">
                        <img class="brand-mark" src="/favicon.svg" alt="" />
                        <div><div class="brand-title">ContextHub</div><div class="brand-subtitle">工作與知識主控台</div></div>
                    </a>
                    <div class="workspace-nav-scroll">
                        <WorkspaceNavigation Groups="groups" IdPrefix="desktop-nav" />
                    </div>
                    <div class="sidebar-bottom">
                        <div class="sidebar-build">
                            <span class="sidebar-build-label">管理介面</span>
                            <span class="sidebar-build-value" title="@BuildMetadata.Current.Version">@BuildMetadata.Current.Version</span>
                            <span class="sidebar-build-time"><ClientLocalTime Value="BuildMetadata.Current.TimestampUtc" /></span>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="main-shell">
                <header class="topbar">
                    <button type="button" class="mobile-nav-button" data-mobile-nav-open aria-label="開啟主選單" aria-controls="workspace-mobile-nav" aria-expanded="false">
                        <NavigationIcon Mark="menu" />
                    </button>
                    <nav class="topbar-context workspace-location" aria-label="所在位置">
                        <span class="workspace-location-product">ContextHub</span>
                        <span class="workspace-location-divider" aria-hidden="true">/</span>
                        <span class="topbar-title" aria-current="page">@(currentRoute?.Label ?? currentGroup?.Label ?? "工作區")</span>
                    </nav>
                    <div class="topbar-actions">
                        <button type="button" class="command-button" data-command-open aria-haspopup="dialog" aria-controls="workspace-command" aria-label="搜尋功能">
                            <span class="command-button-icon desk-icon desk-icon-search" aria-hidden="true"></span>
                            <span class="command-button-label">搜尋功能或頁面</span><kbd class="command-button-kbd">Ctrl K</kbd>
                        </button>
                        <ThemeSwitcher />
                        <span class="topbar-user" title="@auth.User.Identity?.Name">@auth.User.Identity?.Name</span>
                        <form method="post" action="/account/logout"><AntiforgeryToken /><button type="submit" class="ghost-button">登出</button></form>
                    </div>
                </header>
                <main class="content" id="dashboard-main-content" tabindex="-1">
                    @Body
                </main>
            </div>

            <dialog id="workspace-mobile-nav" class="workspace-mobile-dialog" aria-labelledby="mobile-nav-title">
                <div class="workspace-drawer-heading"><strong id="mobile-nav-title">ContextHub</strong><button type="button" class="icon-button" data-dialog-close aria-label="關閉主選單" autofocus>×</button></div>
                <WorkspaceNavigation Groups="groups" IdPrefix="mobile-nav" />
            </dialog>
            <dialog id="workspace-command" class="command-palette workspace-command-dialog" aria-labelledby="command-title">
                <div class="command-palette-header">
                    <h2 id="command-title">搜尋功能</h2>
                    <button type="button" class="icon-button" data-dialog-close aria-label="關閉搜尋">×</button>
                </div>
                <div class="workspace-command-search">
                    <label for="workspace-route-query">輸入功能名稱、用途或路徑</label>
                    <input id="workspace-route-query" type="search" placeholder="例如：監控、待辦、/memories" autocomplete="off" autofocus @bind="_query" @bind:event="oninput" />
                </div>
                <div class="command-palette-body">
                    @if (searchGroups.Length == 0)
                    {
                        <div class="workspace-command-empty">找不到相符功能。請換個關鍵字，或清除搜尋條件。</div>
                    }
                    @foreach (var group in searchGroups)
                    {
                        <section class="command-group" aria-label="@group.Label">
                            <div class="command-group-title">@group.Label</div>
                            <div class="command-route-grid">
                                @foreach (var route in group.Items)
                                {
                                    <NavLink class="command-route" href="@route.Href" Match="@route.Match">
                                        <NavigationIcon Mark="@route.Mark" />
                                        <span class="command-route-copy"><span class="command-route-title">@route.Label</span><span class="command-route-path">@route.Description</span></span>
                                        <span class="command-route-arrow" aria-hidden="true">↗</span>
                                    </NavLink>
                                }
                            </div>
                        </section>
                    }
                </div>
                <div class="workspace-command-footer"><span>Tab 選擇功能 · Enter 開啟</span><span>Esc 關閉</span></div>
            </dialog>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool _interactiveReady;
    private string _query = string.Empty;
    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    protected override void OnInitialized() => Navigation.LocationChanged += HandleLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("contextHubShell.initialize");
            _interactiveReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<DashboardNavigationGroup> FilterGroups(IEnumerable<DashboardNavigationGroup> groups)
    {
        var query = _query.Trim();
        return groups.Select(group => new DashboardNavigationGroup(group.Label, group.Items.Where(item =>
            query.Length == 0 || $"{group.Label} {item.Label} {item.Description} {item.Href}".Contains(query, StringComparison.OrdinalIgnoreCase)).ToArray()))
            .Where(group => group.Items.Count > 0);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _query = string.Empty;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
