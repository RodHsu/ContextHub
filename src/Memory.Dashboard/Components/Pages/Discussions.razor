@page "/discussions"
@inject IContextHubApiClient ApiClient

<PageTitle>ContextHub | 跨專案討論</PageTitle>

<PageViewport Title="跨專案討論" Subtitle="只顯示目前專案可參與的討論；主責專案與參與者會決定每一串的可見範圍。" BodyClass="page-viewport-body discussions-page-body">
    <Actions>
        <div class="page-actions-primary"><button class="primary-button" @onclick="ToggleComposer" disabled="@_loading">建立跨專案討論</button></div>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }
        @if (_creating)
        {
            <section class="discussion-compose panel">
                <div class="panel-heading-row"><div><div class="panel-title">建立跨專案討論</div><div class="panel-heading-meta">先選主責專案，再填入可見的參與專案。</div></div><button class="ghost-button" @onclick="ToggleComposer">取消</button></div>
                <div class="discussion-compose-grid">
                    <label><span>主責專案</span><select @bind="_newHostProjectId">@foreach (var project in _projects) { <option value="@project.Information.ProjectId">@project.Information.DisplayName</option> }</select></label>
                    <label><span>發送專案</span><select @bind="_newSenderProjectId">@foreach (var project in _projects) { <option value="@project.Information.ProjectId">@project.Information.DisplayName</option> }</select></label>
                    <label><span>討論標題</span><input @bind="_newTitle" placeholder="例如：API contract 對齊" /></label>
                    <label class="discussion-compose-wide"><span>參與專案</span><input @bind="_newParticipants" placeholder="Vital_AirMeet, Vital_AirMeet_BackEnd" /><small>以逗號分隔；建立者與主責專案會自動加入。</small></label>
                    <label class="discussion-compose-wide"><span>第一則訊息</span><textarea @bind="_newMessage" placeholder="說明要討論的決策、問題或交接事項。"></textarea></label>
                </div>
                <div class="discussion-compose-actions"><button class="primary-button" @onclick="CreateAsync" disabled="@_loading">建立並送出</button></div>
            </section>
        }
        <section class="discussions-workspace">
            <aside class="discussion-list-panel">
                <div class="panel-heading-row discussion-list-heading"><div><div class="panel-title">相關討論</div><div class="panel-heading-meta">依專案、參與者、狀態或內容篩選</div></div><button class="ghost-button" @onclick="LoadAsync" disabled="@_loading">重新整理</button></div>
                <div class="discussion-filter-toolbar" aria-label="討論篩選">
                    <input @bind="_search" @bind:event="oninput" @bind:after="ApplyFiltersAsync" placeholder="搜尋討論內容或主題" aria-label="搜尋討論" />
                    <select @bind="_hostProjectFilter" @bind:after="ApplyFiltersAsync" aria-label="篩選主責專案"><option value="">所有主責專案</option>@foreach (var project in HostProjects) { <option value="@project">@project</option> }</select>
                    <select @bind="_participantProjectFilter" @bind:after="ApplyFiltersAsync" aria-label="篩選參與專案"><option value="">所有參與專案</option>@foreach (var project in ParticipantProjects) { <option value="@project">@project</option> }</select>
                    <select @bind="_statusFilter" @bind:after="ApplyFiltersAsync" aria-label="篩選狀態"><option value="">所有狀態</option>@foreach (var status in Statuses) { <option value="@status">@status</option> }</select>
                </div>
                <div class="discussion-list-column-labels" aria-hidden="true"><span>專案與參與者</span><span>討論內容</span><span>最後活動</span></div>
                <div class="discussion-list-scroll">
                    @if (FilteredThreads.Count == 0) { <div class="empty-inline">沒有符合篩選條件的討論。</div> }
                    @foreach (var thread in PagedThreads)
                    {
                        <button class="discussion-list-item @(_selectedThreadId == thread.Id ? "selected" : string.Empty)" @onclick="() => SelectThreadAsync(thread.Id)">
                            <span class="discussion-list-project"><code>@thread.HostProjectId</code><span class="discussion-list-participants">@string.Join(" · ", thread.ParticipantProjectIds)</span></span>
                            <span class="discussion-list-summary"><strong>@thread.Title</strong><span>@(thread.UnreadCount > 0 ? $"{thread.UnreadCount} 則未讀" : "已讀")</span></span>
                            <span class="discussion-list-time"><ClientLocalTime Value="thread.UpdatedAt" /></span>
                        </button>
                    }
                </div>
                <footer class="discussion-pagination">
                    <span>@PageRangeLabel</span>
                    <div><button class="ghost-button" @onclick="PreviousPageAsync" disabled="@(_currentPage <= 1 || _loading)">上一頁</button>@for (var page = 1; page <= PageCount; page++) { var pageNumber = page; <button class="page-number @(_currentPage == pageNumber ? "selected" : string.Empty)" @onclick="() => GoToPageAsync(pageNumber)" aria-label="第 @pageNumber 頁">@pageNumber</button> }<button class="ghost-button" @onclick="NextPageAsync" disabled="@(_currentPage >= PageCount || _loading)">下一頁</button></div>
                </footer>
            </aside>
            <main class="discussion-thread-panel">
                @if (_selected is null) { <div class="empty-state">從左側選擇一個討論串。</div> }
                else
                {
                    <div class="discussion-thread-heading"><div><div class="studio-eyebrow">主責專案 <code>@_selected.HostProjectId</code></div><h2>@_selected.Title</h2><div class="discussion-participant-chips">@foreach (var participant in _selected.ParticipantProjectIds) { <span class="discussion-chip @(string.Equals(participant, _selected.HostProjectId, StringComparison.OrdinalIgnoreCase) ? "host" : string.Empty)">@participant</span> }</div></div><div class="discussion-heading-side"><span class="status-badge success">@_selected.Status</span><span><ClientLocalTime Value="_selected.UpdatedAt" /></span></div></div>
                    <div class="discussion-thread-meta"><span>參與專案 @(_selected.ParticipantProjectIds.Count)</span><span>內容僅對參與專案可見</span></div>
                    <div class="discussion-message-stream">@foreach (var message in _selected.Messages) { <article class="discussion-message"><div><strong>@message.SenderProjectId</strong><span><ClientLocalTime Value="message.CreatedAt" /></span></div><p>@message.Content</p></article> }</div>
                    <div class="discussion-reply"><select @bind="_replyProjectId" aria-label="回覆專案">@foreach (var participant in _selected.ParticipantProjectIds) { <option value="@participant">以 @participant 回覆</option> }</select><textarea @bind="_reply" placeholder="回覆討論…"></textarea><button class="primary-button" @onclick="ReplyAsync" disabled="@(_loading || string.IsNullOrWhiteSpace(_reply))">送出</button></div>
                }
            </main>
        </section>
    </ChildContent>
</PageViewport>

@code {
    private const int PageSize = 15;
    private IReadOnlyList<ProjectInformationListItem> _projects = [];
    private IReadOnlyList<DiscussionThreadResult> _threads = [];
    private DiscussionThreadDetailResult? _selected;
    private Guid? _selectedThreadId;
    private string _reply = string.Empty, _replyProjectId = string.Empty, _newHostProjectId = string.Empty, _newSenderProjectId = string.Empty, _newTitle = string.Empty, _newParticipants = string.Empty, _newMessage = string.Empty;
    private string _search = string.Empty, _hostProjectFilter = string.Empty, _participantProjectFilter = string.Empty, _statusFilter = string.Empty;
    private string? _error;
    private bool _loading, _creating;
    private int _currentPage = 1;

    private IReadOnlyList<DiscussionThreadResult> FilteredThreads => _threads
        .Where(thread => string.IsNullOrWhiteSpace(_hostProjectFilter) || string.Equals(thread.HostProjectId, _hostProjectFilter, StringComparison.OrdinalIgnoreCase))
        .Where(thread => string.IsNullOrWhiteSpace(_participantProjectFilter) || thread.ParticipantProjectIds.Contains(_participantProjectFilter, StringComparer.OrdinalIgnoreCase))
        .Where(thread => string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(thread.Status, _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(thread => string.IsNullOrWhiteSpace(_search) || thread.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || thread.HostProjectId.Contains(_search, StringComparison.OrdinalIgnoreCase) || thread.ParticipantProjectIds.Any(project => project.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(thread => thread.UpdatedAt)
        .ToArray();
    private IReadOnlyList<DiscussionThreadResult> PagedThreads => FilteredThreads.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToArray();
    private IReadOnlyList<string> HostProjects => _threads.Select(thread => thread.HostProjectId).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(project => project).ToArray();
    private IReadOnlyList<string> ParticipantProjects => _threads.SelectMany(thread => thread.ParticipantProjectIds).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(project => project).ToArray();
    private IReadOnlyList<string> Statuses => _threads.Select(thread => thread.Status).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(status => status).ToArray();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredThreads.Count / (double)PageSize));
    private string PageRangeLabel => FilteredThreads.Count == 0 ? "顯示 0 筆" : $"顯示 {((_currentPage - 1) * PageSize) + 1}–{Math.Min(_currentPage * PageSize, FilteredThreads.Count)}，共 {FilteredThreads.Count} 筆";

    protected override async Task OnInitializedAsync()
    {
        _projects = await ApiClient.GetProjectInformationProjectsAsync(false, CancellationToken.None);
        _newHostProjectId = _projects.FirstOrDefault()?.Information.ProjectId ?? string.Empty;
        _newSenderProjectId = _newHostProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; _currentPage = 1;
        try { _threads = await ApiClient.GetDiscussionThreadsAsync(new DiscussionThreadListRequest(Limit: 100), CancellationToken.None); await EnsureSelectionAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await EnsureSelectionAsync();
    }

    private async Task PreviousPageAsync() => await GoToPageAsync(_currentPage - 1);
    private async Task NextPageAsync() => await GoToPageAsync(_currentPage + 1);
    private async Task GoToPageAsync(int page)
    {
        _currentPage = Math.Clamp(page, 1, PageCount);
        await EnsureSelectionAsync();
    }

    private async Task EnsureSelectionAsync()
    {
        _currentPage = Math.Clamp(_currentPage, 1, PageCount);
        var selectedIsVisible = PagedThreads.Any(thread => thread.Id == _selectedThreadId);
        if (!selectedIsVisible && PagedThreads.FirstOrDefault() is { } first) await SelectThreadAsync(first.Id);
        else if (PagedThreads.Count == 0) { _selected = null; _selectedThreadId = null; }
    }

    private async Task SelectThreadAsync(Guid id)
    {
        _selectedThreadId = id; _selected = await ApiClient.GetDiscussionThreadAsync(id, string.Empty, CancellationToken.None); _replyProjectId = _selected?.ParticipantProjectIds.FirstOrDefault() ?? string.Empty; _reply = string.Empty;
    }

    private void ToggleComposer() { _creating = !_creating; _newHostProjectId = string.IsNullOrWhiteSpace(_newHostProjectId) ? _projects.FirstOrDefault()?.Information.ProjectId ?? string.Empty : _newHostProjectId; _newSenderProjectId = string.IsNullOrWhiteSpace(_newSenderProjectId) ? _newHostProjectId : _newSenderProjectId; }
    private async Task CreateAsync()
    {
        _loading = true; _error = null;
        try { var participants = _newParticipants.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries); var created = await ApiClient.CreateDiscussionThreadAsync(new DiscussionThreadCreateRequest(_newHostProjectId, _newSenderProjectId, _newTitle, participants, _newMessage), CancellationToken.None); _creating = false; _selected = created; _selectedThreadId = created.Id; await LoadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private async Task ReplyAsync()
    {
        if (_selected is null) return;
        _loading = true; _error = null;
        try { await ApiClient.CreateDiscussionMessageAsync(new DiscussionMessageCreateRequest(_selected.Id, _replyProjectId, _reply), CancellationToken.None); await SelectThreadAsync(_selected.Id); await LoadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
