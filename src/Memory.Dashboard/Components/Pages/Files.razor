@page "/files"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor

<PageTitle>Context Hub | 受管檔案</PageTitle>

<PageViewport Title="受管檔案"
              Subtitle="以 ContextHub logical file 檢視 DLP、quarantine、relations、effective rights 與 lifecycle。"
              Breadcrumb="ContextHub / Files & Knowledge / Managed Files"
              BodyClass="page-viewport-body domain-page-body">
    <Actions>
        <RefreshStatus LastUpdatedAt="_lastUpdatedAt" IsRefreshing="_loading" WarningText="@_loadError" />
        <button class="primary-button" @onclick="LoadAsync" disabled="@_loading">刷新</button>
    </Actions>
    <ChildContent>
        <DomainSurfaceNav Title="檔案與知識"
                          Authority="FileAsset / immutable FileVersion / DLP authority"
                          CurrentHref="/files"
                          Links="FileLinks" />

        <DashboardScopeBar ProjectId="@_projectId"
                           ProjectIdChanged="ChangeProjectAsync"
                           ProjectIds="_projectIds"
                           AllowAllProjects="false"
                           SearchText="@_searchText"
                           SearchTextChanged="ChangeSearch"
                           SearchPlaceholder="僅篩選本頁：檔名、classification 或 lifecycle"
                           Disabled="_loading" />

        @if (_loading && _files.Count == 0)
        {
            <DashboardAsyncState State="loading" Title="載入受管檔案" Message="正在讀取檔案 authority 與安全狀態。" />
        }
        else if (!string.IsNullOrWhiteSpace(_loadError) && _files.Count == 0)
        {
            <DashboardAsyncState State="error" Title="無法載入受管檔案" Message="@_loadError">
                <Action><button class="ghost-button" @onclick="LoadAsync">重試</button></Action>
            </DashboardAsyncState>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <DashboardAsyncState State="degraded" Title="顯示上次成功資料" Message="@_loadError" />
            }

            <section class="domain-summary-grid" aria-label="受管檔案摘要">
                <article class="panel"><span>本頁可見檔案</span><strong>@DashboardFormatting.Integer(FilteredFiles.Count)</strong><small>本頁已套用 project 與 metadata authorization；不是檔案總數</small></article>
                <article class="panel"><span>Quarantine</span><strong>@DashboardFormatting.Integer(_files.Count(x => x.Classification == FileClassification.Quarantined))</strong><small>不進入 extract、embedding 或 transfer</small></article>
                <article class="panel"><span>需要重掃</span><strong>@DashboardFormatting.Integer(_files.Count(x => x.NeedsRescan))</strong><small>classification revision 必須 read-back</small></article>
                <article class="panel"><span>Open findings</span><strong>@DashboardFormatting.Integer(_files.Sum(x => x.OpenSecurityFindings))</strong><small>僅顯示正規化的安全分類</small></article>
            </section>

            <nav class="file-pagination" aria-label="檔案清單分頁">
                <button class="ghost-button" @onclick="PreviousPageAsync" disabled="@(_loading || _state.Legacy || _state.Offset == 0)">上一頁檔案</button>
                <span>本頁起點 @_state.Offset；本頁搜尋符合 @FilteredFiles.Count 筆</span>
                <button class="ghost-button" @onclick="NextPageAsync" disabled="@(_loading || !_state.HasMore)">下一頁檔案</button>
            </nav>
            @if (_state.Legacy)
            {
                <p class="file-read-note" role="status">目前服務只提供舊版清單：範圍可能不完整，分頁與總數未知。</p>
            }
            @if (_files.Count == 0)
            {
                <DashboardAsyncState State="empty" Title="本頁沒有可見檔案" Message="這只說明目前頁的可見資料，不代表整個專案或未授權檔案不存在。" />
            }
            else
            {
                <section class="domain-workspace-grid">
                    <article class="panel domain-list-panel">
                        <div class="panel-heading-row">
                            <div><div class="panel-title">File inventory</div><div class="panel-heading-meta">Logical identity、DLP 與 lifecycle。</div></div>
                        </div>
                        <div class="table-scroll-shell" tabindex="0" aria-label="受管檔案清單">
                            <table class="data-table">
                                <thead><tr><th>檔案</th><th>版本</th><th>Classification</th><th>Lifecycle</th><th>Findings</th><th>更新時間</th></tr></thead>
                                <tbody>
                                    @foreach (var file in FilteredFiles)
                                    {
                                        <tr class="@SelectedClass(file.FileId)">
                                            <td><button class="file-select-button" @onclick="@(() => SelectAsync(file))">@file.FileName</button><small>@file.FileId</small></td>
                                            <td>v@file.VersionNumber</td>
                                            <td><span class="status-badge @ClassificationClass(file.Classification)">@file.Classification</span></td>
                                            <td>@file.Lifecycle</td>
                                            <td>@file.OpenSecurityFindings</td>
                                            <td><ClientLocalTime Value="file.UpdatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>

                    <article class="panel domain-detail-panel">
                        @if (_selected is null)
                        {
                            <DashboardAsyncState State="empty" Title="選擇檔案" Message="選取一筆檔案以檢視 DLP、relations 與有效權限來源。" />
                        }
                        else
                        {
                            <div class="panel-title">@_selected.FileName</div>
                            <dl class="definition-grid">
                                <div><dt>Project</dt><dd>@_selected.ProjectId</dd></div>
                                <div><dt>State</dt><dd>@_selected.State</dd></div>
                                <div><dt>Classification revision</dt><dd>@_selected.ClassificationRevision</dd></div>
                                <div><dt>Relations</dt><dd>@_selected.RelationCount</dd></div>
                                <div><dt>Last scan</dt><dd>@if (_selected.LastScanAt.HasValue) { <ClientLocalTime Value="_selected.LastScanAt.Value" /> } else { <span>尚無 evidence</span> }</dd></div>
                                <div><dt>Security</dt><dd>@(_selected.NeedsRescan ? "Fail closed / needs rescan" : "Current")</dd></div>
                            </dl>
                            @if (_state.SelectionLoading)
                            {
                                <p role="status">正在讀取版本、歷史與權限…</p>
                            }
                            else if (_state.SelectionError is not null)
                            {
                                <p role="alert">@_state.SelectionError</p>
                            }
                            else if (_state.DetailUnavailable)
                            {
                                <p role="status">目前無法取得此檔案的最新 metadata；可能已變更或不可見。</p>
                            }
                            else
                            {
                                <section class="file-version-panel" aria-label="版本 metadata 與歷史">
                                    <div class="subpanel-title">版本 metadata（唯讀）</div>
                                    <p>最新版本：v@_selected.VersionNumber · @_selected.FileVersionId</p>
                                    @if (_state.Version is { } shown)
                                    {
                                        <dl class="definition-grid">
                                            <div><dt>檢視版本</dt><dd>v@shown.VersionNumber @(_state.PinnedVersion ? "（固定版本）" : "（最新）")</dd></div>
                                            <div><dt>Version ID</dt><dd>@shown.FileVersionId</dd></div>
                                            <div><dt>Lifecycle</dt><dd>@shown.Lifecycle</dd></div>
                                            <div><dt>Classification</dt><dd>@shown.Classification · revision @shown.ClassificationRevision</dd></div>
                                        </dl>
                                    }
                                    else
                                    {
                                        <p role="status">此固定版本目前不可讀或服務尚未提供；不以最新版本代替。</p>
                                    }
                                    <button class="ghost-button" @onclick="LatestVersionAsync" disabled="@(!_state.PinnedVersion)">檢視最新版本</button>
                                    @if (_state.Versions is { } history)
                                    {
                                        <div class="file-history-list" aria-label="本頁可見版本">
                                            @foreach (var version in history.Items)
                                            {
                                                <button class="ghost-button" @onclick="@(() => SelectVersionAsync(version.FileVersionId))" @key="version.FileVersionId">檢視 v@version.VersionNumber · @version.FileVersionId · @version.Lifecycle</button>
                                            }
                                            @if (history.Items.Count == 0) { <p>本頁沒有可見版本。</p> }
                                        </div>
                                        <nav class="file-pagination" aria-label="版本歷史分頁">
                                            <button class="ghost-button" @onclick="PreviousVersionsAsync" disabled="@(_state.VersionsOffset == 0)">上一頁版本</button>
                                            <span>本頁起點 @_state.VersionsOffset；本頁可見 @history.Items.Count 筆</span>
                                            <button class="ghost-button" @onclick="NextVersionsAsync" disabled="@(!history.HasMore)">下一頁版本</button>
                                        </nav>
                                    }
                                    else
                                    {
                                        <p role="status">版本歷史未知：目前服務未提供此讀取功能。</p>
                                    }
                                </section>
                                <section class="file-version-panel" aria-label="受下載權限保護的大小與雜湊">
                                    <div class="subpanel-title">大小與 SHA-256</div>
                                    <p>僅在目前版本的下載權限、用途與 DLP 條件通過後顯示；基本資訊權限不會取得這些值。</p>
                                    <label>查核用途（不要輸入秘密）<input maxlength="200" @bind="_contentPurpose" /></label>
                                    <button class="ghost-button" @onclick="ReadContentMetadataAsync" disabled="@(_state.Version is null || _state.ContentLoading)">查核下載授權並讀取</button>
                                    @if (_state.ContentLoading) { <p role="status">正在查核授權…</p> }
                                    @if (_state.ContentError is { } contentError) { <p role="alert">@contentError</p> }
                                    @if (_state.ContentMetadata is { } content)
                                    {
                                        <dl class="definition-grid">
                                            <div><dt>大小（bytes）</dt><dd>@(content.SizeBytes?.ToString() ?? "未知")</dd></div>
                                            <div><dt>SHA-256</dt><dd>@(content.ContentSha256 ?? "未知")</dd></div>
                                        </dl>
                                    }
                                </section>
                                <section class="file-version-panel" aria-label="已遮罩的版本稽核">
                                    <div class="subpanel-title">版本稽核（唯讀）</div>
                                    <p>限既有稽核讀取資格；操作者、用途與拒絕詳細資訊預設遮罩。</p>
                                    <button class="ghost-button" @onclick="ReadAuditAsync" disabled="@(_state.Version is null || _state.AuditLoading)">讀取已遮罩稽核</button>
                                    @if (_state.AuditLoading) { <p role="status">正在讀取稽核…</p> }
                                    @if (_state.AuditError is { } auditError) { <p role="alert">@auditError</p> }
                                    @if (_state.Audit is { } audit)
                                    {
                                        <p>本頁可顯示成功事件 @audit.Items.Count 筆；不包含被遮罩的拒絕詳細資訊，不代表完整稽核總數。</p>
                                        @foreach (var entry in audit.Items)
                                        {
                                            <p @key="entry.AuditId"><ClientLocalTime Value="entry.CreatedAt" /> · @entry.Operation · 操作者：已遮罩 · 用途：已遮罩</p>
                                        }
                                        <nav class="file-pagination" aria-label="已遮罩稽核分頁">
                                            <button class="ghost-button" @onclick="@(() => _state.ReadAuditAsync(Math.Max(0, audit.Offset - FileMetadataReadState.PageSize)))" disabled="@(audit.Offset == 0)">上一頁稽核</button>
                                            <button class="ghost-button" @onclick="@(() => _state.ReadAuditAsync(audit.Offset + FileMetadataReadState.PageSize))" disabled="@(!audit.HasMore)">下一頁稽核</button>
                                        </nav>
                                    }
                                </section>
                            }
                            <div class="subpanel-title">Effective rights</div>
                            @if (_rights is null)
                            {
                                <p role="status">@(_state.SelectionLoading ? "正在取得逐 right authority evidence。" : "有效權限資料未知。")</p>
                            }
                            else
                            {
                                <div class="rights-list">
                                    @foreach (var decision in _rights.Decisions)
                                    {
                                        <article><span class="status-badge @(decision.Allowed ? "ok" : "bad")">@(decision.Allowed ? "Allowed" : "Denied")</span><strong>@decision.Right</strong><small>@decision.Tier · @decision.Explanation</small></article>
                                    }
                                </div>
                            }
                            <div class="authority-callout">所有 transfer 與內容讀取都由 ContextHub logical capability 終止；頁面不呈現底層儲存定位資訊。</div>
                        }
                    </article>
                </section>

                @if (_selected is not null)
                {
                    <HighRiskOperationGuard OperationName="解除 quarantine"
                                            Summary="Restricted file release 必須依 server policy 取得 human assurance。"
                                            Reason="安全 finding 已完成處置且需要重新掃描"
                                            ImpactPreview="只影響所選 FileVersion；仍需完成 rescan 才能恢復 search、embedding 或 transfer。"
                                            OutcomeReadBack="尚未送出 mutation；目前只顯示 server requirement read-back。"
                                            ActionLabel="要求解除 quarantine"
                                            Decision="_releaseRequirement"
                                            ActionAvailable="false"
                                            UnavailableReason="請由具 security:manage authority 的核准流程送出 external approval 與 reason。" />
                }
            }
        }
    </ChildContent>
</PageViewport>

@code {
    private static readonly IReadOnlyList<DomainSurfaceLink> FileLinks =
    [
        new("受管檔案", "/files", "FileAsset、DLP、quarantine 與 effective rights"),
        new("記憶資料", "/memories", "知識內容與 revisions"),
        new("記憶圖譜", "/graph", "關係 projection"),
        new("記憶整理", "/retention", "Retention 與 archive governance"),
        new("營運健康", "/operations#logical-storage", "Logical storage 與 transfer health")
    ];

    private readonly CancellationTokenSource _cts = new();
    private string _contentPurpose = string.Empty;
    private FileMetadataReadState _state = default!;
    private IReadOnlyList<ManagedFileInventoryResult> _files => _state.Files;
    private IReadOnlyList<string> _projectIds = [];
    private ManagedFileInventoryResult? _selected => _state.Selected;
    private EffectiveRightsResult? _rights => _state.Rights;
    private StepUpAuthorizationResult? _releaseRequirement => _state.ReleaseRequirement;
    private string _projectId = ProjectContext.DefaultProjectId;
    private string _searchText = string.Empty;
    private bool _loading => _state.Loading;
    private string? _loadError => _state.Error;
    private DateTimeOffset? _lastUpdatedAt => _state.LastUpdatedAt;

    private IReadOnlyList<ManagedFileInventoryResult> FilteredFiles => _files.Where(file =>
        string.IsNullOrWhiteSpace(_searchText) ||
        file.FileName.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
        file.Classification.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
        file.Lifecycle.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        _state = new FileMetadataReadState(ApiClient);
        var settings = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        _projectId = settings.Behavior.DefaultProjectId;
        var projects = await ApiClient.GetProjectInformationProjectsAsync(false, _cts.Token);
        _projectIds = projects.Select(x => x.Information.ProjectId).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
        await LoadAsync();
    }

    private async Task ChangeProjectAsync(string projectId)
    {
        _contentPurpose = string.Empty;
        _projectId = projectId;
        _searchText = string.Empty;
        await _state.LoadAsync(_projectId);
    }

    private Task ChangeSearch(string value)
    {
        _searchText = value;
        return InvokeAsync(StateHasChanged);
    }

    private Task LoadAsync() => WithFreshPurpose(() => _state.LoadAsync(_projectId, _state.Offset));
    private Task PreviousPageAsync() => WithFreshPurpose(() => _state.LoadAsync(_projectId, Math.Max(0, _state.Offset - FileMetadataReadState.PageSize)));
    private Task NextPageAsync() => WithFreshPurpose(() => _state.LoadAsync(_projectId, _state.Offset + FileMetadataReadState.PageSize));
    private Task SelectAsync(ManagedFileInventoryResult file) { _contentPurpose = string.Empty; return _state.SelectAsync(file); }
    private Task SelectVersionAsync(Guid versionId) { _contentPurpose = string.Empty; return _selected is null ? Task.CompletedTask : _state.SelectAsync(_selected, versionId, _state.VersionsOffset); }
    private Task ReadContentMetadataAsync() => _state.ReadContentMetadataAsync(_contentPurpose);
    private Task ReadAuditAsync() => _state.ReadAuditAsync();
    private Task LatestVersionAsync() => WithFreshPurpose(() => _selected is null ? Task.CompletedTask : _state.SelectAsync(_selected, null, _state.VersionsOffset));
    private Task PreviousVersionsAsync() => WithFreshPurpose(() => _selected is null ? Task.CompletedTask : _state.SelectAsync(_selected, _state.RequestedVersionId, Math.Max(0, _state.VersionsOffset - FileMetadataReadState.PageSize)));
    private Task NextVersionsAsync() => WithFreshPurpose(() => _selected is null ? Task.CompletedTask : _state.SelectAsync(_selected, _state.RequestedVersionId, _state.VersionsOffset + FileMetadataReadState.PageSize));

    private Task WithFreshPurpose(Func<Task> read) { _contentPurpose = string.Empty; return read(); }

    private string SelectedClass(Guid id) => _selected?.FileId == id ? "is-selected" : string.Empty;
    private static string ClassificationClass(FileClassification value) => value switch
    {
        FileClassification.Normal => "ok",
        FileClassification.Sensitive => "warn",
        FileClassification.Restricted or FileClassification.Quarantined => "bad",
        _ => "neutral"
    };

    public ValueTask DisposeAsync()
    {
        _state?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
