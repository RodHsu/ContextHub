@page "/memories"
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor
@inject IJSRuntime JsRuntime

<PageTitle>Context Hub | 記憶資料</PageTitle>

<PageViewport Title="記憶資料"
              Subtitle="查詢記憶條目，展開版本紀錄、內容片段與向量。"
              BodyClass="page-viewport-body memories-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           IsRefreshing="_loading" />
        </div>
        <div class="page-actions-secondary">
            <InfoPopover Label="顯示查詢模式說明" Title="查詢模式">
                <p><code>目前專案</code> 只查目前 <code>ProjectId</code>。</p>
                <p><code>目前 + 參考專案</code> 會一併帶入參考專案清單。</p>
                <p><code>共用綜合層</code> 直接查詢唯讀的 shared summary layer。</p>
            </InfoPopover>
            <button class="ghost-button" @onclick="RefreshSharedSummaryAsync" disabled="@_loading">重建共用綜合層</button>
            @if (_queryMode == MemoryQueryMode.SummaryOnly)
            {
                <button class="ghost-button" @onclick="LoadCurrentProjectAsync" disabled="@_loading">回到目前專案</button>
            }
            else
            {
                <button class="ghost-button" @onclick="LoadSharedSummaryAsync" disabled="@_loading">查看共用綜合層</button>
            }
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="LoadAsync" disabled="@_loading">查詢</button>
        </div>
    </Actions>
    <ChildContent>

    <section class="panel filter-panel filter-panel-stacked memories-filter-panel">
        <div class="filter-panel-heading">
            <div>
                <div class="panel-title">查詢條件</div>
                <div class="panel-heading-meta panel-heading-meta-left">先用關鍵字與專案縮小清單，再展開進階條件處理來源、狀態與 shared summary layer。</div>
            </div>
        </div>
        <div class="filter-grid filter-quick-grid memories-filter-grid">
            <input @bind="_query" placeholder="搜尋標題 / 摘要 / 來源參照" />
            <div class="project-suggestion-field">
                <input @bind="_projectIdInput"
                       @bind:event="oninput"
                       @bind:after="HandleProjectIdInputAsync"
                       @onfocus="ShowProjectSuggestionsAsync"
                       autocomplete="off"
                       placeholder="目前專案 (Project Id，可模糊搜尋)" />
                @if (_projectSuggestions.Count > 0)
                {
                    <div class="project-suggestion-list">
                        @foreach (var suggestion in _projectSuggestions)
                        {
                            <button type="button"
                                    class="project-suggestion-item"
                                    @onclick="@(() => SelectProjectSuggestionAsync(suggestion.ProjectId))">
                                <span>@suggestion.ProjectId</span>
                                <small>@DashboardFormatting.Integer(suggestion.ItemCount) 筆</small>
                            </button>
                        }
                    </div>
                }
            </div>
            <select @bind="_queryMode">
                <option value="@MemoryQueryMode.CurrentOnly">目前專案</option>
                <option value="@MemoryQueryMode.CurrentPlusReferencedProjects">目前 + 參考專案</option>
                <option value="@MemoryQueryMode.SummaryOnly">共用綜合層</option>
            </select>
            <select @bind="_scope">
                <option value="">全部範圍</option>
                @foreach (var scope in Enum.GetValues<MemoryScope>())
                {
                    <option value="@scope">@DashboardText.Label(scope)</option>
                }
            </select>
            <select @bind="_memoryType">
                <option value="">全部類型</option>
                @foreach (var type in Enum.GetValues<MemoryType>())
                {
                    <option value="@type">@DashboardText.Label(type)</option>
                }
            </select>
        </div>
        <details class="filter-advanced" open>
            <summary>
                <span>進階篩選</span>
                <small>參考專案、狀態、來源與標籤</small>
            </summary>
            <div class="filter-grid advanced-filter-grid memories-advanced-filter-grid">
                <input @bind="_includedProjectIds" placeholder="參考專案，以逗號分隔" />
                <select @bind="_status">
                    <option value="">全部狀態</option>
                    @foreach (var status in Enum.GetValues<MemoryStatus>())
                    {
                        <option value="@status">@DashboardText.Label(status)</option>
                    }
                </select>
                <input @bind="_sourceType" placeholder="來源類型 (Source Type)" />
                <input @bind="_tag" placeholder="標籤 (Tag)" />
                <label class="toggle-field">
                    <input type="checkbox" @bind="_useSummaryLayer" />
                    <span>一併讀取綜合層</span>
                </label>
            </div>
        </details>
    </section>

    @if (_page is null)
    {
        <div class="split-layout">
        <section class="panel skeleton-panel">
            <div class="skeleton-line skeleton-line-md"></div>
            <div class="skeleton-stack">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="skeleton-line @(i % 2 == 0 ? "skeleton-line-lg" : "skeleton-line-md")"></div>
                }
            </div>
        </section>

        <section class="panel detail-panel skeleton-panel">
            <div class="skeleton-line skeleton-line-md"></div>
            <div class="skeleton-stack">
                <div class="skeleton-line skeleton-line-lg"></div>
                <div class="skeleton-line skeleton-line-md"></div>
                <div class="skeleton-line skeleton-line-sm"></div>
                <div class="skeleton-block"></div>
            </div>
        </section>
        </div>
    }
    else
    {
        <div class="split-layout memories-workspace-layout">
        <section class="panel panel-scroll memories-list-panel">
            <div class="panel-title">記憶條目 (@DashboardFormatting.Integer(_page.TotalCount))</div>
            @if (_page.TotalCount == 0 && _checkpointStaging.Count > 0)
            {
                <div class="empty-inline">
                    <div class="empty-inline-title">正式 memory 查不到，但有 checkpoint staging</div>
                    <div class="empty-inline-copy">這些資料仍在 conversation checkpoint / insight pipeline，尚未確認正式入庫。</div>
                </div>
                <div class="stack-list">
                    @foreach (var checkpoint in _checkpointStaging)
                    {
                        <article class="stack-item">
                            <div class="stack-item-title">@checkpoint.ShortExcerpt</div>
                            <div class="stack-item-copy">@checkpoint.ProjectId / @checkpoint.ConversationId</div>
                            <div class="stack-item-meta">
                                <span class="status-badge @PipelineStatusClass(checkpoint.PipelineStatus)">@PipelineStatusText(checkpoint.PipelineStatus)</span>
                                <span>@checkpoint.EventType</span>
                                @if (checkpoint.PromotedMemoryId.HasValue)
                                {
                                    <span>memory: @checkpoint.PromotedMemoryId</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(checkpoint.Error))
                                {
                                    <span>@checkpoint.Error</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            <div class="table-scroll-shell table-scroll-shell-tall memories-table-scroll-shell"
                 data-scroll-viewport="true">
                <table class="data-table data-table-clickable memories-table">
                    <colgroup>
                        <col class="memories-table-col-title" />
                        <col class="memories-table-col-project" />
                        <col class="memories-table-col-type" />
                        <col class="memories-table-col-source" />
                        <col class="memories-table-col-updated" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="memories-table-head">記憶內容</th>
                            <th class="memories-table-head">專案與範圍</th>
                            <th class="memories-table-head">類型與狀態</th>
                            <th class="memories-table-head">來源與標籤</th>
                            <th class="memories-table-head">更新時間</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _page.Items)
                        {
                            <tr class="@SelectedClass(item.Id)" @onclick="@(() => SelectAsync(item.Id))">
                                <td>
                                    <div class="table-title memories-cell-title" title="@item.Title">@item.Title</div>
                                    <div class="table-subtitle memories-cell-summary" title="@item.Summary">@item.Summary</div>
                                </td>
                                <td>
                                    <div class="table-title memories-cell-project" title="@item.ProjectId">@item.ProjectId</div>
                                    <div class="table-subtitle">@DashboardText.Label(item.Scope)</div>
                                    @if (item.IsReadOnly)
                                    {
                                        <div class="table-subtitle">綜合摘要 / 唯讀</div>
                                    }
                                </td>
                                <td>
                                    <span class="memories-cell-badge" title="@DashboardText.Label(item.MemoryType)">@DashboardText.Label(item.MemoryType)</span>
                                    <span class="status-badge @StatusClass(item.Status.ToString())">@DashboardText.Label(item.Status)</span>
                                </td>
                                <td class="memories-source-cell">
                                    <div class="memories-cell-clamp" title="@($"{item.SourceType} / {item.SourceRef}")">@item.SourceType / @item.SourceRef</div>
                                    <div class="table-subtitle memories-cell-tags" title="@string.Join(", ", item.Tags)">@BuildTagSummary(item.Tags)</div>
                                </td>
                                <td><span class="memories-cell-time"><ClientLocalTime Value="item.UpdatedAt" /></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel detail-panel panel-scroll">
            <div class="panel-title">細節</div>
            <div class="panel-scroll-body detail-scroll-shell memory-detail-shell">
                @if (_selected is null)
                {
                    <div class="empty-inline">點選左側記憶條目後顯示版本紀錄、內容片段與向量。</div>
                }
                else
                {
                    <div class="memory-detail-body">
                        <dl class="definition-grid memory-detail-definition-grid">
                            <div><dt>外部鍵值 (External Key)</dt><dd>@_selected.Document.ExternalKey</dd></div>
                            <div><dt>專案 (Project)</dt><dd>@_selected.Document.ProjectId</dd></div>
                            <div><dt>來源 (Source)</dt><dd>@_selected.Document.SourceType / @_selected.Document.SourceRef</dd></div>
                            <div><dt>重要性 (Importance)</dt><dd>@_selected.Document.Importance</dd></div>
                            <div><dt>可信度 (Confidence)</dt><dd>@_selected.Document.Confidence</dd></div>
                            <div><dt>版本 (Version)</dt><dd>@_selected.Document.Version</dd></div>
                            <div><dt>狀態 (Status)</dt><dd>@DashboardText.Label(_selected.Document.Status)</dd></div>
                            <div><dt>建立時間 (Created)</dt><dd><ClientLocalTime Value="_selected.Document.CreatedAt" /></dd></div>
                            <div><dt>更新時間 (Updated)</dt><dd><ClientLocalTime Value="_selected.Document.UpdatedAt" /></dd></div>
                        </dl>

                        @if (_selected.SourceContext is not null)
                        {
                            <section class="memory-detail-section">
                                <div class="subpanel-title">來源脈絡</div>
                                <dl class="definition-grid">
                                    <div><dt>連接器</dt><dd>@(_selected.SourceContext.ConnectorName ?? "n/a")</dd></div>
                                    <div><dt>連接器 ID</dt><dd>@(_selected.SourceContext.SourceConnectionId?.ToString() ?? "n/a")</dd></div>
                                    <div><dt>來源版本</dt><dd>@(_selected.SourceContext.SourceVersion ?? "n/a")</dd></div>
                                    <div>
                                        <dt>最近同步</dt>
                                        <dd>
                                            @if (_selected.SourceContext.LastSuccessfulSyncAt.HasValue)
                                            {
                                                <ClientLocalTime Value="_selected.SourceContext.LastSuccessfulSyncAt.Value" />
                                            }
                                            else
                                            {
                                                <span>n/a</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                                @if (_selected.SourceContext.Lineage.Count > 0)
                                {
                                    <div class="stack-item-meta">@string.Join(" -> ", _selected.SourceContext.Lineage)</div>
                                }
                            </section>
                        }

                        <section class="detail-reader memory-detail-content-reader" aria-label="記憶內容閱讀區">
                            <div class="detail-reader-header">
                                <div>
                                    <div class="detail-reader-title">內容</div>
                                    <div class="detail-reader-meta">Markdown / 來源文字</div>
                                </div>
                                <button class="ghost-button detail-reader-copy-button"
                                        type="button"
                                        @onclick="@(() => CopyTextAsync(_selected.Document.Content, "已複製 memory 內容。"))">
                                    複製內容
                                </button>
                            </div>
                            <pre class="detail-reader-body memory-detail-content-block">@_selected.Document.Content</pre>
                        </section>

                        <section class="memory-detail-section">
                            <div class="section-heading-row">
                                <div>
                                    <div class="subpanel-title">版本紀錄</div>
                                    <div class="section-heading-meta">@DashboardFormatting.Integer(_selected.Revisions.Count) 筆版本紀錄</div>
                                </div>
                            </div>
                            <div class="stack-list memory-revision-list memory-detail-list-scroll-shell"
                                 data-scroll-viewport="true">
                                @foreach (var revision in _selected.Revisions.Take(5))
                                {
                                    <article class="stack-item memory-revision-card">
                                        <div class="stack-item-title">v@revision.Version / @ChangedByText(revision.ChangedBy)</div>
                                        <div class="stack-item-copy memory-revision-summary">@revision.Title - @revision.Summary</div>
                                        <div class="stack-item-meta"><ClientLocalTime Value="revision.CreatedAt" /></div>
                                    </article>
                                }
                            </div>
                        </section>

                        <section class="memory-detail-section">
                            <div class="section-heading-row">
                                <div>
                                    <div class="subpanel-title">內容片段</div>
                                    <div class="section-heading-meta">@DashboardFormatting.Integer(_selected.Chunks.Count) 個內容片段</div>
                                </div>
                            </div>
                            <div class="stack-list memory-chunk-list memory-detail-list-scroll-shell memory-chunk-scroll-shell"
                                 data-scroll-viewport="true">
                                @foreach (var chunk in _selected.Chunks)
                                {
                                    <article class="chunk-reader memory-chunk-card">
                                        <div class="chunk-reader-header">
                                            <div>
                                                <div class="chunk-reader-title">@DashboardText.Label(chunk.ChunkKind) / #@chunk.ChunkIndex</div>
                                                <div class="chunk-reader-meta">@DashboardFormatting.Integer(chunk.Vectors.Count) 筆向量</div>
                                            </div>
                                            <button class="ghost-button detail-reader-copy-button"
                                                    type="button"
                                                    @onclick="@(() => CopyTextAsync(chunk.ChunkText, $"已複製內容片段 #{chunk.ChunkIndex}。"))">
                                                複製
                                            </button>
                                        </div>
                                        <pre class="chunk-reader-body">@chunk.ChunkText</pre>
                                    </article>
                                }
                            </div>
                        </section>

                        @if (_selected.Findings?.Count > 0)
                        {
                            <section class="memory-detail-section">
                                <div class="subpanel-title">治理發現</div>
                                <div class="stack-list">
                                    @foreach (var finding in _selected.Findings)
                                    {
                                        <article class="stack-item">
                                            <div class="stack-item-title">@DashboardText.Label(finding.Type) / @DashboardText.Label(finding.Status)</div>
                                            <div class="stack-item-copy">@finding.Title</div>
                                            <div class="stack-item-meta">@finding.Summary</div>
                                        </article>
                                    }
                                </div>
                            </section>
                        }

                        @if (_selected.Links?.Count > 0)
                        {
                            <section class="memory-detail-section">
                                <div class="subpanel-title">關聯連結</div>
                                <div class="stack-list">
                                    @foreach (var link in _selected.Links)
                                    {
                                        <article class="stack-item">
                                            <div class="stack-item-title">@link.LinkType</div>
                                            <div class="stack-item-meta">@link.FromId -> @link.ToId</div>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </div>
        </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <DashboardToast Message="@_message" Sequence="@_messageSequence" OnDismiss="ClearMessage" />
    }

    </ChildContent>
</PageViewport>

@code {
    private string? _query;
    private string? _projectIdInput;
    private string? _selectedProjectId;
    private string? _currentProjectId;
    private string? _includedProjectIds;
    private MemoryQueryMode _queryMode = MemoryQueryMode.CurrentOnly;
    private bool _useSummaryLayer;
    private string? _scope;
    private string? _memoryType;
    private string? _status;
    private string? _sourceType;
    private string? _tag;
    private PagedResult<MemoryListItemResult>? _page;
    private MemoryDetailsResult? _selected;
    private IReadOnlyList<ConversationCheckpointSearchResult> _checkpointStaging = [];
    private bool _loading;
    private DateTimeOffset? _lastUpdatedAt;
    private string? _message;
    private long _messageSequence;
    private IReadOnlyList<ProjectSuggestionResult> _projectSuggestions = [];
    private ProjectShortcutState? _projectShortcutState;

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await RuntimeSettingsAccessor.GetCurrentAsync(CancellationToken.None);
        _currentProjectId = DashboardProjectSelection.ResolveCurrentProjectId(snapshot.Behavior.DefaultProjectId);
        _queryMode = snapshot.Behavior.DefaultQueryMode;
        _useSummaryLayer = snapshot.Behavior.DefaultUseSummaryLayer;
        await LoadProjectSuggestionsAsync(null);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _page = await ApiClient.GetMemoriesAsync(
                new MemoryListRequest(
                    _query,
                    Parse<MemoryScope>(_scope),
                    Parse<MemoryType>(_memoryType),
                    Parse<MemoryStatus>(_status),
                    string.IsNullOrWhiteSpace(_sourceType) ? null : _sourceType,
                    string.IsNullOrWhiteSpace(_tag) ? null : _tag,
                    ResolveSelectedProjectId(),
                    ResolveProjectQuery(),
                    ParseProjectIds(_includedProjectIds),
                    _queryMode,
                    _useSummaryLayer,
                    1,
                    25),
                CancellationToken.None);

            if (_selected is not null)
            {
                _selected = await ApiClient.GetMemoryDetailsAsync(_selected.Document.Id, CancellationToken.None);
            }

            _checkpointStaging = _page.TotalCount == 0 && !string.IsNullOrWhiteSpace(_query)
                ? await LoadCheckpointStagingAsync()
                : [];
            _lastUpdatedAt = DateTimeOffset.UtcNow;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectAsync(Guid id)
        => _selected = await ApiClient.GetMemoryDetailsAsync(id, CancellationToken.None);

    private async Task<IReadOnlyList<ConversationCheckpointSearchResult>> LoadCheckpointStagingAsync()
    {
        try
        {
            return await ApiClient.SearchConversationCheckpointsAsync(
                new ConversationCheckpointSearchRequest(
                    _query,
                    ResolveSelectedProjectId(),
                    null,
                    5),
                CancellationToken.None);
        }
        catch (InvalidOperationException)
        {
            return [];
        }
    }

    private async Task LoadSharedSummaryAsync()
    {
        CaptureProjectShortcutState();
        _selectedProjectId = null;
        _projectIdInput = null;
        _projectSuggestions = [];
        _queryMode = MemoryQueryMode.SummaryOnly;
        _useSummaryLayer = false;
        _includedProjectIds = null;
        await LoadAsync();
    }

    private async Task LoadCurrentProjectAsync()
    {
        RestoreProjectShortcutState();
        _projectSuggestions = [];
        _queryMode = MemoryQueryMode.CurrentOnly;
        _useSummaryLayer = false;
        _includedProjectIds = null;
        await LoadAsync();
    }

    private async Task RefreshSharedSummaryAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var projectId = ResolveSelectedProjectId();
            var result = await ApiClient.EnqueueSummaryRefreshAsync(
                new EnqueueSummaryRefreshRequest(
                    projectId,
                    projectId is null ? null : ParseProjectIds(_includedProjectIds)),
                CancellationToken.None);

            ShowMessage(projectId is null
                ? $"已排入全部共用綜合層重建工作：{result.JobId}"
                : $"已排入共用綜合層重建工作：{result.JobId}");
            _lastUpdatedAt = DateTimeOffset.UtcNow;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ShowMessage(string message)
    {
        _message = message;
        _messageSequence++;
    }

    private void ClearMessage()
        => _message = null;

    private async Task CopyTextAsync(string? text, string message)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("contextHubDashboard.copyText", text);
        ShowMessage(message);
    }

    private async Task HandleProjectIdInputAsync()
    {
        if (!string.Equals(NormalizeEmpty(_projectIdInput), _selectedProjectId, StringComparison.OrdinalIgnoreCase))
        {
            _selectedProjectId = null;
        }

        await LoadProjectSuggestionsAsync(_projectIdInput);
    }

    private async Task ShowProjectSuggestionsAsync(FocusEventArgs _)
        => await LoadProjectSuggestionsAsync(_projectIdInput);

    private async Task SelectProjectSuggestionAsync(string projectId)
    {
        _selectedProjectId = projectId;
        _projectIdInput = projectId;
        _projectSuggestions = [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProjectSuggestionsAsync(string? query)
    {
        _projectSuggestions = await ApiClient.GetMemoryProjectsAsync(query, 8, CancellationToken.None);
    }

    private void CaptureProjectShortcutState()
    {
        var input = NormalizeEmpty(_projectIdInput);
        var selectedProjectId = ResolveSelectedProjectId();
        _projectShortcutState = input is null && selectedProjectId is null
            ? null
            : new ProjectShortcutState(input, selectedProjectId, NormalizeEmpty(_includedProjectIds));
    }

    private void RestoreProjectShortcutState()
    {
        _selectedProjectId = _projectShortcutState?.SelectedProjectId;
        _projectIdInput = _projectShortcutState?.ProjectIdInput;
        _includedProjectIds = _projectShortcutState?.IncludedProjectIds;
    }

    private static TEnum? Parse<TEnum>(string? value)
        where TEnum : struct, Enum
        => Enum.TryParse<TEnum>(value, true, out var parsed) ? parsed : null;

    private string SelectedClass(Guid id)
        => _selected?.Document.Id == id ? "selected-row" : string.Empty;

    private static string StatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "active" or "ready" or "running" => "ok",
            "archived" or "pending" => "warn",
            _ => "neutral"
        };

    private static string PipelineStatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "promoted" => "ok",
            "promotion-failed" or "ingest-failed" => "bad",
            "checkpoint-only" or "insight-pending" or "promotion-pending" or "ingest-pending" => "warn",
            _ => "neutral"
        };

    private static string PipelineStatusText(string status)
        => status.ToLowerInvariant() switch
        {
            "checkpoint-only" => "已在 checkpoint，尚未正式入庫",
            "ingest-pending" => "等待產生 insight",
            "ingest-failed" => "insight 產生失敗",
            "insight-pending" => "insight 待 promotion",
            "promotion-pending" => "promotion 排程中",
            "promotion-failed" => "promotion 失敗",
            "promoted" => "已正式入庫",
            _ => status
        };

    private static string ChangedByText(string changedBy)
        => changedBy.ToLowerInvariant() switch
        {
            "upsert" => "寫入更新",
            "update" => "內容更新",
            "archive" => "封存",
            "restore" => "還原",
            _ => changedBy
        };

    private static string BuildTagSummary(IReadOnlyList<string> tags)
        => tags.Count == 0
            ? "無標籤"
            : string.Join("、", tags.Take(3)) + (tags.Count > 3 ? $" +{tags.Count - 3}" : string.Empty);

    private static string? NormalizeEmpty(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value;

    private string? ResolveSelectedProjectId()
    {
        var input = NormalizeEmpty(_projectIdInput);
        if (input is null)
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(_selectedProjectId) &&
            string.Equals(_selectedProjectId, input, StringComparison.OrdinalIgnoreCase))
        {
            return _selectedProjectId;
        }

        var exactMatch = _projectSuggestions.FirstOrDefault(x => string.Equals(x.ProjectId, input, StringComparison.OrdinalIgnoreCase));
        return exactMatch?.ProjectId;
    }

    private string? ResolveProjectQuery()
    {
        var input = NormalizeEmpty(_projectIdInput);
        var selected = ResolveSelectedProjectId();
        return selected is null ? input : null;
    }

    private static IReadOnlyList<string>? ParseProjectIds(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? null
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

    private sealed record ProjectShortcutState(string? ProjectIdInput, string? SelectedProjectId, string? IncludedProjectIds);
}
