@page "/secrets"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor

<PageTitle>Context Hub | Secrets 與 MFA</PageTitle>

<PageViewport Title="Secrets 與 MFA"
              Subtitle="管理 credential metadata、effective rights、lease boundary 與 server-defined assurance；material 永不出現在 inventory。"
              Breadcrumb="ContextHub / Governance & Security / Secrets"
              BodyClass="page-viewport-body domain-page-body">
    <Actions>
        <RefreshStatus LastUpdatedAt="_lastUpdatedAt" IsRefreshing="_loading" WarningText="_loadError" />
        <button class="primary-button" @onclick="LoadAsync" disabled="@_loading">刷新</button>
    </Actions>
    <ChildContent>
        <DomainSurfaceNav Title="Secrets / Credentials"
                          Authority="Secret metadata / version / grant / lease / MFA authority"
                          CurrentHref="/secrets"
                          Links="SecretLinks" />

        <DashboardScopeBar ProjectId="_projectId"
                           ProjectIdChanged="ChangeProjectAsync"
                           ProjectIds="_projectIds"
                           AllowAllProjects="false"
                           SearchText="_searchText"
                           SearchTextChanged="ChangeSearch"
                           SearchPlaceholder="搜尋 logical credential name、kind 或 state"
                           Disabled="_loading" />

        @if (_loading && _secrets.Count == 0)
        {
            <DashboardAsyncState State="loading" Title="載入 credential inventory" Message="正在讀取授權範圍內的 metadata。" />
        }
        else if (!string.IsNullOrWhiteSpace(_loadError) && _secrets.Count == 0)
        {
            <DashboardAsyncState State="error" Title="無法載入 Secrets" Message="@_loadError">
                <Action><button class="ghost-button" @onclick="LoadAsync">重試</button></Action>
            </DashboardAsyncState>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <DashboardAsyncState State="degraded" Title="顯示上次成功資料" Message="@_loadError" />
            }

            <section class="domain-summary-grid" aria-label="Secrets 摘要">
                <article class="panel"><span>可見 credentials</span><strong>@DashboardFormatting.Integer(FilteredSecrets.Count)</strong><small>只顯示 metadata；material 不可觀測</small></article>
                <article class="panel"><span>Active</span><strong>@DashboardFormatting.Integer(_secrets.Count(x => x.State == SecretState.Active))</strong><small>Use 與 Reveal 仍是不同 right</small></article>
                <article class="panel"><span>Compromised</span><strong>@DashboardFormatting.Integer(_secrets.Count(x => x.State == SecretState.Compromised))</strong><small>需立即 drill-down 至安全稽核</small></article>
                <article class="panel"><span>Revoked</span><strong>@DashboardFormatting.Integer(_secrets.Count(x => x.State == SecretState.Revoked))</strong><small>新 lease 必須 fail closed</small></article>
            </section>

            @if (_secrets.Count == 0)
            {
                <DashboardAsyncState State="empty" Title="目前範圍沒有可見 credential" Message="未授權的 credential identity 與存在性不會顯示。" />
            }
            else
            {
                <section class="domain-workspace-grid">
                    <article class="panel domain-list-panel">
                        <div class="panel-title">Credential inventory</div>
                        <div class="panel-heading-meta">Logical metadata、rotation revision 與 lifecycle。</div>
                        <div class="table-scroll-shell" tabindex="0" aria-label="Credential inventory">
                            <table class="data-table">
                                <thead><tr><th>Name</th><th>Kind</th><th>State</th><th>Version</th><th>Revision</th><th>Updated</th></tr></thead>
                                <tbody>
                                    @foreach (var secret in FilteredSecrets)
                                    {
                                        <tr class="@SelectedClass(secret.Id)" @onclick="@(() => SelectAsync(secret))" tabindex="0">
                                            <td><strong>@secret.Name</strong><small>@secret.Id</small></td>
                                            <td>@secret.Kind</td>
                                            <td><span class="status-badge @SecretStateClass(secret.State)">@secret.State</span></td>
                                            <td>@(secret.CurrentVersion?.ToString() ?? "-")</td>
                                            <td>@secret.Revision</td>
                                            <td><ClientLocalTime Value="secret.UpdatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>

                    <article class="panel domain-detail-panel">
                        @if (_selected is null)
                        {
                            <DashboardAsyncState State="empty" Title="選擇 credential" Message="選取一筆 metadata 以檢視 effective rights 與 assurance。" />
                        }
                        else
                        {
                            <div class="panel-title">@_selected.Name</div>
                            <dl class="definition-grid">
                                <div><dt>Project</dt><dd>@_selected.ProjectId</dd></div>
                                <div><dt>Logical kind</dt><dd>@_selected.Kind</dd></div>
                                <div><dt>State</dt><dd>@_selected.State</dd></div>
                                <div><dt>Current version</dt><dd>@(_selected.CurrentVersion?.ToString() ?? "尚無 active version")</dd></div>
                            </dl>
                            <div class="subpanel-title">Effective rights / source explanation</div>
                            @if (_rights is null)
                            {
                                <DashboardAsyncState State="loading" Title="讀取有效權限" Message="逐 right 取得 policy 與 grant evidence。" />
                            }
                            else
                            {
                                <div class="rights-list">
                                    @foreach (var decision in _rights.Decisions)
                                    {
                                        <article><span class="status-badge @(decision.Allowed ? "ok" : "bad")">@(decision.Allowed ? "Allowed" : "Denied")</span><strong>@decision.Right</strong><small>@decision.Tier · @decision.Explanation</small></article>
                                    }
                                </div>
                            }
                            <div class="authority-callout">AgentExecution 只能取得 SecretRef 與 server-bound lease；credential material、加密資訊與底層定位不進入 UI、browser payload 或 telemetry。</div>
                        }
                    </article>
                </section>

                @if (_selected is not null)
                {
                    <section class="high-risk-grid">
                        <HighRiskOperationGuard OperationName="Reveal credential"
                                                Summary="Reveal 與 Use 分離；server policy 決定 Password、TOTP、WebAuthn/FIDO 或 external approval。"
                                                Reason="人工檢視受保護 credential material"
                                                ImpactPreview="只針對所選 logical credential，建立一次性、受 audit 的 read-back。"
                                                OutcomeReadBack="尚未建立 assertion，也未讀取任何 material。"
                                                ActionLabel="開始 Reveal"
                                                Decision="_revealRequirement"
                                                ActionAvailable="false"
                                                UnavailableReason="請先完成頁面外的 server-issued step-up ceremony；前端不會降級 assurance。" />
                        <HighRiskOperationGuard OperationName="Revoke credential"
                                                Summary="撤銷會阻止新 lease，並要求已發 lease 在 read-back 後失效。"
                                                Reason="credential compromised 或 lifecycle 終止"
                                                ImpactPreview="所選 credential revision 會前進；使用中的 execution 需重新解析 authority。"
                                                OutcomeReadBack="尚未送出 mutation。"
                                                ActionLabel="撤銷 credential"
                                                Decision="_revokeRequirement"
                                                ActionAvailable="false"
                                                UnavailableReason="需要 reason、expected revision 與 server-approved assurance 後才可送出。" />
                    </section>
                }
            }
        }
    </ChildContent>
</PageViewport>

@code {
    private static readonly IReadOnlyList<DomainSurfaceLink> SecretLinks =
    [
        new("Secrets 與 MFA", "/secrets", "Credential metadata、rights 與 assurance"),
        new("安全管理", "/security", "角色、token、MFA 與 security audit"),
        new("Agent 執行", "/agent-executions", "SecretRef、lease 與 execution evidence"),
        new("營運健康", "/operations#logical-storage", "Logical store、transfer 與 reconciliation health")
    ];

    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<SecretSummary> _secrets = [];
    private IReadOnlyList<string> _projectIds = [];
    private SecretSummary? _selected;
    private EffectiveRightsResult? _rights;
    private StepUpAuthorizationResult? _revealRequirement;
    private StepUpAuthorizationResult? _revokeRequirement;
    private string _projectId = ProjectContext.DefaultProjectId;
    private string _searchText = string.Empty;
    private bool _loading;
    private string? _loadError;
    private DateTimeOffset? _lastUpdatedAt;

    private IReadOnlyList<SecretSummary> FilteredSecrets => _secrets.Where(secret =>
        string.IsNullOrWhiteSpace(_searchText) ||
        secret.Name.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
        secret.Kind.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
        secret.State.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        var settings = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        _projectId = settings.Behavior.DefaultProjectId;
        var projects = await ApiClient.GetProjectInformationProjectsAsync(false, _cts.Token);
        _projectIds = projects.Select(x => x.Information.ProjectId).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
        await LoadAsync();
    }

    private async Task ChangeProjectAsync(string projectId)
    {
        _projectId = projectId;
        await LoadAsync();
    }

    private Task ChangeSearch(string value)
    {
        _searchText = value;
        return InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _secrets = await ApiClient.GetSecretsAsync(_projectId, _cts.Token);
            _selected = _selected is null ? _secrets.FirstOrDefault() : _secrets.FirstOrDefault(x => x.Id == _selected.Id) ?? _secrets.FirstOrDefault();
            await LoadSelectionAsync();
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _loadError = null;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex) { _loadError = DashboardUiErrorFormatter.BuildLoadError("Secrets 與 MFA", ex, _secrets.Count > 0); }
        finally { _loading = false; }
    }

    private async Task SelectAsync(SecretSummary secret)
    {
        _selected = secret;
        await LoadSelectionAsync();
    }

    private async Task LoadSelectionAsync()
    {
        if (_selected is null)
        {
            _rights = null;
            _revealRequirement = null;
            _revokeRequirement = null;
            return;
        }
        var resourceId = _selected.Id.ToString("D");
        _rights = await ApiClient.GetEffectiveRightsAsync(_projectId, ["metadata", "use", "manage", "rotate", "revoke", "reveal", "export"], "Secret", resourceId, _cts.Token);
        _revealRequirement = await ApiClient.GetStepUpRequirementAsync(StepUpOperationClass.SecretReveal, "secret:reveal", "Secret", resourceId, _cts.Token);
        _revokeRequirement = await ApiClient.GetStepUpRequirementAsync(StepUpOperationClass.CredentialRevoke, "secret:revoke", "Secret", resourceId, _cts.Token);
    }

    private string SelectedClass(Guid id) => _selected?.Id == id ? "is-selected" : string.Empty;
    private static string SecretStateClass(SecretState value) => value switch
    {
        SecretState.Active => "ok",
        SecretState.Compromised => "bad",
        SecretState.Revoked => "neutral",
        _ => "warn"
    };

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
