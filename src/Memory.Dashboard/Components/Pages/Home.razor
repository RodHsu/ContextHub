@page "/"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor

<PageTitle>ContextHub | 工作總覽</PageTitle>

<PageViewport Title="工作總覽"
              Subtitle="掌握平台狀態、營運風險與待處理事項，快速進入工作流程。"
              Breadcrumb="ContextHub / 總覽"
              BodyClass="page-viewport-body overview-page-body">
    <Actions>
        <div class="page-actions-primary operations-desk-home-actions">
            @if (_overview is null)
            {
                <button class="ghost-button" @onclick="LoadAsync" disabled="@_loading">刷新</button>
            }
            <a class="primary-button button-link" href="/project-work-items">檢視待辦 <span class="desk-icon desk-icon-arrow" aria-hidden="true"></span></a>
        </div>
    </Actions>
    <ChildContent>
        @if (_overview is null && _loading)
        {
            <DashboardAsyncState State="loading" Title="載入總覽" Message="正在整理最新健康、風險與背景工作。" />
        }
        else if (_overview is null)
        {
            <DashboardAsyncState State="error" Title="總覽目前不可用" Message="@(_loadError ?? "目前無法取得總覽資料。")">
                <Action><button class="ghost-button" @onclick="LoadAsync">重試</button></Action>
            </DashboardAsyncState>
        }
        else
        {
            var attentionServices = AttentionServices();
            var healthKnown = _overview.Services.Count > 0;
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <DashboardAsyncState State="degraded" Title="顯示上次成功資料" Message="@_loadError" />
            }

            <section class="operations-desk-summary overview-signal-strip" aria-label="平台健康與摘要">
                <div class="operations-desk-health overview-health-panel">
                    <a href="/operations" class="operations-desk-health-link">
                        <span class="operations-desk-health-dot @(!healthKnown ? "unknown" : attentionServices.Count == 0 ? "healthy" : "attention")" aria-hidden="true"></span>
                        <strong>@(!healthKnown ? "健康狀態未知" : attentionServices.Count == 0 ? "平台正常" : "平台需注意")</strong>
                    </a>
                    <span class="operations-desk-health-description">@(!healthKnown ? "尚無服務健康資料" : attentionServices.Count == 0 ? $"{_overview.Services.Count} 項服務運作正常" : $"優先檢視 {attentionServices.Count} 項異常服務")</span>
                </div>
                <div class="operations-desk-metrics" aria-label="摘要指標">
                    @foreach (var metric in _overview.Metrics.Take(3))
                    {
                        <div class="operations-desk-metric" title="@metric.Definition">
                            <span>@metric.Label</span>
                            <strong>@DashboardFormatting.Integer(metric.Value)</strong>
                            <small>@MetricUnitText(metric.Unit)</small>
                        </div>
                    }
                    @if (_overview.Metrics.Count == 0)
                    {
                        <span class="operations-desk-muted">目前沒有摘要指標。</span>
                    }
                </div>
                <div class="operations-desk-freshness">
                    <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                                   SnapshotAtUtc="_overview.SnapshotAtUtc"
                                   IsRefreshing="_loading"
                                   PollingIntervalSeconds="@PollingIntervalSeconds"
                                   WarningText="@_overview.SnapshotStatus?.Warning" />
                    <button type="button" class="ghost-button operations-desk-refresh" @onclick="LoadAsync" disabled="@_loading">
                        <NavigationIcon Mark="R" /><span>刷新</span>
                    </button>
                </div>
            </section>

            <section class="operations-desk-workspace" aria-label="營運風險與工作入口">
                <article class="panel overview-risk-panel operations-desk-risk-panel">
                    <header class="operations-desk-section-heading">
                        <div>
                            <h2>風險與異常</h2>
                            <p>優先顯示最近三筆錯誤與異常，展開訊息追查原因。</p>
                        </div>
                        <span class="operations-desk-count" aria-label="最近異常數量">@DashboardFormatting.Integer(_overview.RecentErrors.Count)</span>
                    </header>

                    @if (attentionServices.Count > 0)
                    {
                        <div class="operations-desk-service-alerts" aria-label="需要注意的服務">
                            @foreach (var service in attentionServices)
                            {
                                <div class="operations-desk-service-alert">
                                    <span class="status-badge @StatusClass(service.Status)">@DashboardText.Status(service.Status)</span>
                                    <div><strong>@DashboardText.Service(service.Name)</strong><span>@service.Description</span></div>
                                </div>
                            }
                        </div>
                    }

                    @if (_overview.RecentErrors.Count == 0)
                    {
                        <p class="operations-desk-empty">目前沒有待檢視異常。</p>
                    }
                    else
                    {
                        <div class="operations-desk-risk-table-frame">
                            <table class="operations-desk-risk-table">
                                <thead><tr><th scope="col">項目</th><th scope="col">等級</th><th scope="col">發生時間</th></tr></thead>
                                <tbody>
                                    @foreach (var error in _overview.RecentErrors.Take(3))
                                    {
                                        <tr class="operations-desk-risk-item" @key="error.Id">
                                            <td>
                                                <strong class="operations-desk-risk-service">@error.ServiceName</strong>
                                                <details class="operations-desk-risk-details">
                                                    <summary><span class="operations-desk-risk-excerpt">@error.Message</span><span class="operations-desk-message-toggle">完整訊息</span></summary>
                                                    <p class="operations-desk-risk-message selectable-text">@error.Message</p>
                                                </details>
                                            </td>
                                            <td><span class="operations-desk-mobile-label" aria-hidden="true">等級</span><span class="status-badge @StatusClass(error.Level)">@error.Level</span></td>
                                            <td class="operations-desk-risk-time"><span class="operations-desk-mobile-label" aria-hidden="true">發生時間</span><ClientLocalTime Value="error.CreatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <footer class="operations-desk-related-links" aria-label="相關診斷工具">
                        <span>相關工具</span><a href="/operations">營運中心 <span class="desk-icon desk-icon-external" aria-hidden="true"></span></a><a href="/logs">日誌與診斷 <span class="desk-icon desk-icon-external" aria-hidden="true"></span></a>
                    </footer>
                </article>

                <aside class="panel operations-desk-secondary" aria-label="工作入口、審核與背景工作">
                    <section class="operations-desk-entry-section">
                        <header class="operations-desk-section-heading"><div><h2>工作入口</h2><p>依常見任務快速進入工作流程。</p></div></header>
                        <nav class="operations-desk-entry-list" aria-label="常用工作入口">
                            <a class="operations-desk-entry" href="/project-information"><span class="desk-icon desk-icon-folder" aria-hidden="true"></span><span class="operations-desk-entry-copy"><strong>專案工作區</strong><small>查看專案背景、結構與協作範圍</small></span><span class="desk-icon desk-icon-chevron operations-desk-entry-arrow" aria-hidden="true"></span></a>
                            <a class="operations-desk-entry" href="/memories"><span class="desk-icon desk-icon-search" aria-hidden="true"></span><span class="operations-desk-entry-copy"><strong>搜尋知識</strong><small>搜尋專案記憶、內容與版本紀錄</small></span><span class="desk-icon desk-icon-chevron operations-desk-entry-arrow" aria-hidden="true"></span></a>
                            <a class="operations-desk-entry" href="/monitoring"><span class="desk-icon desk-icon-activity" aria-hidden="true"></span><span class="operations-desk-entry-copy"><strong>持續觀察平台</strong><small>檢視服務健康與資源變化</small></span><span class="desk-icon desk-icon-chevron operations-desk-entry-arrow" aria-hidden="true"></span></a>
                        </nav>
                    </section>
                    <section class="overview-decision-panel operations-desk-review-section">
                        <h3>檢查與審核</h3>
                        <nav class="operations-desk-review-links" aria-label="檢查與審核入口">
                            <a href="/inbox">治理建議<span class="desk-icon desk-icon-chevron" aria-hidden="true"></span></a>
                            <a href="/chatgpt-proposals">ChatGPT 寫入審核<span class="desk-icon desk-icon-chevron" aria-hidden="true"></span></a>
                            <a href="/governance">治理檢查<span class="desk-icon desk-icon-chevron" aria-hidden="true"></span></a>
                        </nav>
                    </section>
                    <section class="overview-work-panel operations-desk-jobs-section">
                        <div class="operations-desk-jobs-heading"><h3>背景工作</h3><span class="operations-desk-count">@DashboardFormatting.Integer(_overview.ActiveJobs.Count)</span></div>
                        <div class="overview-work-list operations-desk-job-list">
                            @if (_overview.ActiveJobs.Count == 0)
                            {
                                <p class="operations-desk-empty">目前沒有等待中或執行中的背景工作。</p>
                            }
                            else
                            {
                                @foreach (var job in _overview.ActiveJobs.Take(3))
                                {
                                    <article class="operations-desk-job" @key="job.Id">
                                        <span class="status-badge @StatusClass(job.Status.ToString())">@DashboardText.Label(job.Status)</span>
                                        <strong>@DashboardText.Label(job.JobType)</strong>
                                        <ClientRelativeTime Value="job.CreatedAt" />
                                    </article>
                                }
                            }
                        </div>
                        <a class="operations-desk-all-jobs" href="/jobs">檢視背景工作 <span class="desk-icon desk-icon-arrow" aria-hidden="true"></span></a>
                    </section>
                </aside>
            </section>

            <footer class="overview-release-strip operations-desk-release">
                <span>資料服務版本 <strong>@_overview.BuildVersion</strong></span>
                <span>建置時間 <ClientLocalTime Value="_overview.BuildTimestampUtc" /></span>
            </footer>
        }
    </ChildContent>
</PageViewport>

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollingTask;
    private DashboardOverviewResult? _overview;
    private bool _loading;
    private DateTimeOffset? _lastUpdatedAt;
    private string? _loadError;
    private InstanceSettingsSnapshot? _settingsSnapshot;
    private int PollingIntervalSeconds => _settingsSnapshot?.Behavior.SnapshotPolling.StatusCoreSeconds ?? 15;

    protected override async Task OnInitializedAsync()
    {
        _settingsSnapshot = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && PollingIntervalSeconds > 0)
        {
            _pollingTask = PollAsync();
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _overview = await ApiClient.GetOverviewAsync(_cts.Token);
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _loadError = null;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _loadError = DashboardUiErrorFormatter.BuildLoadError("總覽", ex, _overview is not null);
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<DashboardServiceHealthResult> AttentionServices()
        => _overview?.Services
            .Where(service => !service.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase) &&
                              !service.Status.Equals("Ready", StringComparison.OrdinalIgnoreCase))
            .Take(3)
            .ToArray() ?? [];

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(PollingIntervalSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string MetricUnitText(string unit) => unit.ToLowerInvariant() switch
    {
        "items" => "筆",
        "jobs" => "項",
        "logs" => "筆",
        _ => unit
    };

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" or "ready" or "running" or "completed" => "ok",
        "degraded" or "warning" or "pending" or "blocked" => "warn",
        "failed" or "critical" or "error" or "unhealthy" => "bad",
        _ => "neutral"
    };

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_pollingTask is not null)
        {
            _ = CompleteDisposeAsync(_pollingTask, _cts);
            return ValueTask.CompletedTask;
        }

        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private static async Task CompleteDisposeAsync(Task pollingTask, CancellationTokenSource cts)
    {
        try { await pollingTask; }
        catch (OperationCanceledException) { }
        finally { cts.Dispose(); }
    }
}
