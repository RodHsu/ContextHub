@page "/"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor
@inject IJSRuntime JsRuntime
@using Memory.Dashboard.Services

<PageTitle>Context Hub | 總覽</PageTitle>

<PageViewport Title="總覽"
              Subtitle="集中掌握服務健康、資源趨勢與背景工作狀態。"
              BodyClass="page-viewport-body home-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           SnapshotAtUtc="PageSnapshotAtUtc()"
                           IsRefreshing="_loading"
                           PollingIntervalSeconds="@PollingIntervalSeconds"
                           WarningText="@SnapshotWarningText()" />
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="RefreshAsync" disabled="@_loading">刷新</button>
        </div>
    </Actions>
    <ChildContent>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="inline-error">@_loadError</div>
    }

    @if (_overview is null || _docker is null)
    {
        <div class="metric-grid">
            @for (var i = 0; i < 4; i++)
            {
                <section class="panel metric-card skeleton-panel">
                    <div class="skeleton-line skeleton-line-sm"></div>
                    <div class="skeleton-line skeleton-line-lg"></div>
                    <div class="skeleton-line skeleton-line-xs"></div>
                </section>
            }
        </div>

        <div class="dashboard-grid page-scroll-host">
            @for (var i = 0; i < 4; i++)
            {
                <section class="panel skeleton-panel @(i == 2 ? "span-2" : string.Empty)">
                    <div class="skeleton-line skeleton-line-md"></div>
                    <div class="skeleton-stack">
                        <div class="skeleton-line skeleton-line-lg"></div>
                        <div class="skeleton-line skeleton-line-md"></div>
                        <div class="skeleton-line skeleton-line-sm"></div>
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <DashboardToast Message="@_message" Sequence="@_messageSequence" OnDismiss="ClearMessage" />
        }

        <div class="metric-grid">
            @foreach (var metric in _overview.Metrics)
            {
                <section class="panel metric-card metric-card-inline">
                    <div class="metric-inline-line">
                        <span class="metric-label-inline">@metric.Label：</span>
                        <span class="metric-value-inline">@DashboardFormatting.Integer(metric.Value)</span>
                        <span class="metric-meta-inline">@MetricUnitText(metric.Unit)</span>
                    </div>
                </section>
            }
        </div>

        <div class="home-signal-grid">
            <section class="panel home-signal-chart-panel">
                <div class="panel-heading-row">
                    <div>
                        <div class="panel-title">系統效能</div>
                        <div class="panel-heading-meta">CPU 使用率 / 最近 @DashboardFormatting.Integer(ResourceSampleCount) 筆資源樣本</div>
                    </div>
                    <div class="home-signal-value">
                        <strong>@DashboardFormatting.Percent(AverageCpuPercent())</strong>
                        <span>近期平均</span>
                    </div>
                </div>
                <svg class="home-signal-chart" viewBox="0 0 720 96" preserveAspectRatio="none" role="img" aria-label="System CPU performance trend">
                    @foreach (var guide in ChartGuideLines())
                    {
                        <line class="resource-line-guide" x1="0" y1="@guide" x2="720" y2="@guide"></line>
                    }
                    <text class="home-signal-lane-label" x="12" y="20">CPU</text>
                    <polyline class="resource-line cpu" points="@BuildLinePoints(_resourceSamples.Select(x => x.CpuPercent), PercentChartMax, 720d, 96d)"></polyline>
                </svg>
                <div class="resource-chart-legend">
                    <span class="resource-legend-item"><i class="legend-swatch cpu"></i>CPU</span>
                </div>
                <div class="home-signal-footer">
                    <span>目前 @DashboardFormatting.Percent(CurrentCpuPercent())</span>
                    <span>每 @DashboardFormatting.Integer(PollingIntervalSeconds) 秒更新</span>
                </div>
            </section>

            <section class="panel home-alert-panel">
                <div class="panel-heading-row">
                    <div>
                        <div class="panel-title">異常佇列</div>
                        <div class="panel-heading-meta">Error / Critical</div>
                    </div>
                    <span class="status-badge @(_overview.RecentErrors.Count == 0 ? "status-success" : "status-error")">@DashboardFormatting.Integer(_overview.RecentErrors.Count)</span>
                </div>
                <div class="home-alert-list">
                    @if (_overview.RecentErrors.Count == 0)
                    {
                        <div class="empty-inline">目前沒有待檢視異常。</div>
                    }
                    else
                    {
                        @foreach (var error in RecentErrorsPreview())
                        {
                            <article class="home-alert-item">
                                <div>
                                    <strong>@error.ServiceName</strong>
                                    <span>@error.Message</span>
                                </div>
                                <ClientRelativeTime Value="error.CreatedAt" />
                            </article>
                        }
                    }
                </div>
                <a class="ghost-button home-alert-link" href="/logs">檢視全部日誌</a>
            </section>
        </div>

        @if ((_overview.ContextSavings ?? CreateEmptyContextSavings(_overview.SnapshotAtUtc)) is { } contextSavings)
        {
            <section class="panel context-savings-strip @(contextSavings.HasRecentData ? string.Empty : "context-savings-strip-empty")">
            <div class="context-savings-strip-title">
                <div>
                    <div class="panel-title">Token 節省量</div>
                    <div class="context-savings-note">@ContextSavingsStateText(contextSavings) / @contextSavings.WindowLabel</div>
                </div>
                <span class="status-badge @ContextSavingsConfidenceClass(contextSavings.Confidence)">可信度 @ContextSavingsConfidenceText(contextSavings.Confidence)</span>
            </div>
            <div class="context-savings-strip-metrics" aria-label="Token savings details">
                @foreach (var window in ContextSavingsWindows(contextSavings))
                {
                    <div class="context-savings-window-card @(window.HasData ? string.Empty : "context-savings-window-empty")"
                         title="@ContextSavingsTokenModeTooltip(window)">
                        <span>@window.Label 節省量 / 快取命中率</span>
                        <strong>@DashboardFormatting.Percent(window.SavingPercent)</strong>
                        <small>
                            <span>@FormatTokenCount(window.EstimatedSavedTokens)</span>
                            <span>快取 @DashboardFormatting.Percent(window.CacheHitPercent)</span>
                            <span>@DashboardFormatting.Integer(window.SampleCount) 筆樣本</span>
                        </small>
                    </div>
                }
                <div>
                    <span>來源覆蓋率</span>
                    <strong>@DashboardFormatting.Percent(contextSavings.SourceCoveragePercent)</strong>
                    <small>@DashboardFormatting.Integer(contextSavings.ReturnedTokenEstimate) returned tokens</small>
                </div>
                <div class="context-savings-strip-last">
                    <span>最後樣本</span>
                    <strong>
                        @if (contextSavings.LastSampleAtUtc.HasValue)
                        {
                            <ClientLocalTime Value="contextSavings.LastSampleAtUtc.Value" />
                        }
                        else
                        {
                            <span>等待樣本</span>
                        }
                    </strong>
                </div>
                <div class="context-savings-strip-trend">
                    <span>趨勢</span>
                    <svg class="resource-line-chart context-savings-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Token saving percent trend">
                        @foreach (var guide in new[] { 14, 28, 42 })
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line savings" points="@BuildLinePoints(contextSavings.Trend.Select(x => x.SavingPercent), 100d)"></polyline>
                    </svg>
                </div>
            </div>
            </section>
        }

        <div class="dashboard-grid page-scroll-host">
            <section class="panel">
                <div class="panel-title">服務健康</div>
                <div class="badge-strip">
                    @foreach (var service in _overview.Services)
                    {
                        <span class="status-badge @StatusClass(service.Status)">@ServiceDisplayName(service.Name): @StatusText(service.Status)</span>
                    }
                </div>

                <dl class="definition-grid">
                    <div>
                        <dt>命名空間 (Namespace)</dt>
                        <dd>@_overview.Namespace</dd>
                    </div>
                    <div>
                        <dt>建置版本 (Build Version)</dt>
                        <dd>@_overview.BuildVersion</dd>
                    </div>
                    <div>
                        <dt>建置時間 (Build Time)</dt>
                        <dd><ClientLocalTime Value="_overview.BuildTimestampUtc" /></dd>
                    </div>
                    <div>
                        <dt>向量設定檔 (Embedding Profile)</dt>
                        <dd>@_overview.EmbeddingProfile</dd>
                    </div>
                    <div>
                        <dt>模型鍵值 (Model Key)</dt>
                        <dd>@_overview.ModelKey</dd>
                    </div>
                    <div>
                        <dt>維度 (Dimensions)</dt>
                        <dd>@DashboardFormatting.Integer(_overview.Dimensions)</dd>
                    </div>
                    <div>
                        <dt>最大 Token 數 (Max Tokens)</dt>
                        <dd>@DashboardFormatting.Integer(_overview.MaxTokens)</dd>
                    </div>
                    <div>
                        <dt>快取版本 (Cache Version)</dt>
                        <dd>@DashboardFormatting.Integer(_overview.CacheVersion)</dd>
                    </div>
                </dl>
            </section>

            <section class="panel">
                <div class="panel-title">Docker 主機 (Docker Host)</div>
                <div class="host-grid">
                    <div class="host-stat">
                        <span>狀態</span>
                        <strong class="@StatusClass(_docker.Status)">@StatusText(_docker.Status)</strong>
                    </div>
                    <div class="host-stat">
                        <span>CPU 核心 (CPU Cores)</span>
                        <strong>@DashboardFormatting.Integer(_docker.Host.CpuCount) 核</strong>
                    </div>
                    <div class="host-stat">
                        <span>總記憶體</span>
                        <strong>@DashboardFormatting.Bytes(_docker.Host.TotalMemoryBytes)</strong>
                    </div>
                    <div class="host-stat">
                        <span>估計可用</span>
                        <strong>@DashboardFormatting.Bytes(_docker.Host.EstimatedAvailableMemoryBytes)</strong>
                    </div>
                    <div class="host-stat">
                        <span>Images</span>
                        <strong>@DashboardFormatting.Integer(_docker.Host.ImageCount)</strong>
                    </div>
                    <div class="host-stat">
                        <span>Volumes</span>
                        <strong>@DashboardFormatting.Integer(_docker.Host.VolumeCount)</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_docker.Error))
                {
                    <div class="inline-error">@_docker.Error</div>
                }
            </section>

            <section class="panel home-evaluation-panel">
                <div class="panel-title">評估摘要</div>
                @if (_overview.EvaluationSummary is null)
                {
                    <div class="empty-inline">尚未執行評估。</div>
                }
                else
                {
                    <dl class="definition-grid">
                        <div><dt>評估組</dt><dd>@_overview.EvaluationSummary.SuiteName</dd></div>
                        <div><dt>狀態</dt><dd>@EvaluationStatusText(_overview.EvaluationSummary.Status)</dd></div>
                        <div><dt>Hit@K</dt><dd>@_overview.EvaluationSummary.HitRate</dd></div>
                        <div><dt>Recall@K</dt><dd>@_overview.EvaluationSummary.RecallAtK</dd></div>
                        <div><dt>MRR</dt><dd>@_overview.EvaluationSummary.MeanReciprocalRank</dd></div>
                        <div><dt>延遲</dt><dd>@DashboardFormatting.Decimal(_overview.EvaluationSummary.AverageLatencyMs) ms</dd></div>
                    </dl>
                }
            </section>

            <section class="panel span-2">
                <div class="panel-heading-row">
                    <div class="panel-title">資源狀態圖表</div>
                    <div class="panel-heading-meta resource-chart-panel-meta">@ResourceChartPanelNote()</div>
                </div>
                <div class="resource-chart-grid">
                <article class="resource-chart-card">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">CPU 使用率 (CPU Usage)</div>
                            <div class="resource-chart-value">@DashboardFormatting.Percent(CurrentCpuPercent())</div>
                            <div class="resource-chart-summary">近期平均 @DashboardFormatting.Percent(AverageCpuPercent()) / 範圍 @PercentRange(_resourceSamples.Select(x => x.CpuPercent))</div>
                        </div>
                    </div>
                    <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="CPU usage trend">
                        @foreach (var guide in ChartGuideLines())
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line cpu" points="@BuildLinePoints(_resourceSamples.Select(x => x.CpuPercent), PercentChartMax)"></polyline>
                    </svg>
                    <div class="resource-chart-meta">依 `docker stats` 聚合目前服務群組原始 CPU 使用率 / 0-100% 固定軸 / 主機 @DashboardFormatting.Integer(_docker.Host.CpuCount) 核</div>
                </article>

                <article class="resource-chart-card">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">記憶體使用率 (Memory Usage)</div>
                            <div class="resource-chart-value">@DashboardFormatting.Bytes(CurrentMemoryUsageBytes())</div>
                            <div class="resource-chart-summary">近期平均 @DashboardFormatting.Bytes(AverageMemoryUsageBytes()) / 範圍 @PercentRange(_resourceSamples.Select(x => x.MemoryPercent))</div>
                        </div>
                    </div>
                    <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Memory usage trend">
                        @foreach (var guide in ChartGuideLines())
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line memory" points="@BuildLinePoints(_resourceSamples.Select(x => x.MemoryPercent), PercentChartMax)"></polyline>
                    </svg>
                    <div class="resource-chart-meta">@DashboardFormatting.Bytes(CurrentMemoryUsageBytes()) / @DashboardFormatting.Bytes(_docker.Host.TotalMemoryBytes) (占主機 @DashboardFormatting.Percent(CurrentMemoryPercent())) / 0-100% 固定軸</div>
                </article>

                <article class="resource-chart-card">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">網路吞吐量 (Network Throughput)</div>
                            <div class="resource-chart-stats">
                                <div class="resource-inline-stat">
                                    <span>接收 (RX)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatRate(CurrentNetworkRxBytesPerSecond())</strong>
                                        <small>平均 @FormatRate(AverageNetworkRxBytesPerSecond())</small>
                                    </div>
                                </div>
                                <div class="resource-inline-stat">
                                    <span>傳送 (TX)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatRate(CurrentNetworkTxBytesPerSecond())</strong>
                                        <small>平均 @FormatRate(AverageNetworkTxBytesPerSecond())</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Network throughput trend">
                        @foreach (var guide in ChartGuideLines())
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line rx" points="@BuildLinePoints(_resourceSamples.Select(x => x.NetworkRxBytesPerSecond), MaxNetworkRate())"></polyline>
                        <polyline class="resource-line tx" points="@BuildLinePoints(_resourceSamples.Select(x => x.NetworkTxBytesPerSecond), MaxNetworkRate())"></polyline>
                    </svg>
                    <div class="resource-chart-legend">
                        <span class="resource-legend-item"><i class="legend-swatch rx"></i>接收 (RX)</span>
                        <span class="resource-legend-item"><i class="legend-swatch tx"></i>傳送 (TX)</span>
                    </div>
                </article>

                <article class="resource-chart-card">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">近期呼叫趨勢 (Recent Request Traffic)</div>
                            <div class="resource-chart-stats">
                                <div class="resource-inline-stat">
                                    <span>進站 (Inbound)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatCountRate(CurrentInboundRequestsPerSecond())</strong>
                                        <small>平均 @FormatCountRate(AverageInboundRequestsPerSecond())</small>
                                    </div>
                                </div>
                                <div class="resource-inline-stat">
                                    <span>傳出 (Outbound)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatCountRate(CurrentOutboundRequestsPerSecond())</strong>
                                        <small>平均 @FormatCountRate(AverageOutboundRequestsPerSecond())</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Recent request traffic trend">
                        @foreach (var guide in ChartGuideLines())
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line inbound" points="@BuildLinePoints(_overview.RequestTraffic.Select(x => (double)x.InboundRequests), MaxRequestTrafficRate())"></polyline>
                        <polyline class="resource-line outbound" points="@BuildLinePoints(_overview.RequestTraffic.Select(x => (double)x.OutboundRequests), MaxRequestTrafficRate())"></polyline>
                    </svg>
                    <div class="resource-chart-legend">
                        <span class="resource-legend-item"><i class="legend-swatch inbound"></i>進站 (Inbound)</span>
                        <span class="resource-legend-item"><i class="legend-swatch outbound"></i>傳出 (Outbound)</span>
                    </div>
                </article>

                <article class="resource-chart-card">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">磁碟吞吐量 (Disk Throughput)</div>
                            <div class="resource-chart-stats">
                                <div class="resource-inline-stat">
                                    <span>讀取 (Read)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatRate(CurrentDiskReadBytesPerSecond())</strong>
                                        <small>平均 @FormatRate(AverageDiskReadBytesPerSecond())</small>
                                    </div>
                                </div>
                                <div class="resource-inline-stat">
                                    <span>寫入 (Write)</span>
                                    <div class="resource-inline-stat-value">
                                        <strong>@FormatRate(CurrentDiskWriteBytesPerSecond())</strong>
                                        <small>平均 @FormatRate(AverageDiskWriteBytesPerSecond())</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Disk throughput trend">
                        @foreach (var guide in ChartGuideLines())
                        {
                            <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                        }
                        <polyline class="resource-line read" points="@BuildLinePoints(_resourceSamples.Select(x => x.DiskReadBytesPerSecond), MaxDiskRate())"></polyline>
                        <polyline class="resource-line write" points="@BuildLinePoints(_resourceSamples.Select(x => x.DiskWriteBytesPerSecond), MaxDiskRate())"></polyline>
                    </svg>
                    <div class="resource-chart-legend">
                        <span class="resource-legend-item"><i class="legend-swatch read"></i>讀取 (Read)</span>
                        <span class="resource-legend-item"><i class="legend-swatch write"></i>寫入 (Write)</span>
                    </div>
                </article>

                @{
                    var redisContainer = RedisContainer();
                }
                <article class="resource-chart-card resource-chart-card-redis">
                    <div class="resource-chart-header">
                        <div>
                            <div class="resource-chart-title">Redis 狀態監控 (Redis Status)</div>
                            <div class="resource-chart-value resource-chart-value-status">
                                <span class="status-badge @RedisStatusClass(redisContainer)">@RedisStatusText(redisContainer)</span>
                            </div>
                            <div class="resource-chart-summary" title="@RedisContainerName(redisContainer)">@RedisContainerName(redisContainer)</div>
                        </div>
                    </div>
                    <div class="resource-redis-chart" role="img" aria-label="Redis resource status chart">
                        @foreach (var bar in RedisChartBars(redisContainer))
                        {
                            <div class="resource-redis-chart-row">
                                <span class="resource-redis-chart-label">@bar.Label</span>
                                <span class="resource-redis-bar-bg">
                                    <span class="resource-redis-bar @bar.CssClass" style="--redis-bar-width: @RedisBarWidth(bar.Percent);"></span>
                                </span>
                                <span class="resource-redis-chart-value">@bar.Value</span>
                            </div>
                        }
                    </div>
                    <div class="resource-chart-meta">@RedisStatusMeta(redisContainer)</div>
                </article>
                </div>
            </section>

            <section class="panel span-2">
                <div class="panel-title">Compose 服務資源</div>
                <div class="table-scroll-shell table-scroll-shell-tall">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>服務 (Service)</th>
                                <th>容器 (Container)</th>
                                <th>狀態 (State)</th>
                                <th>CPU</th>
                                <th>記憶體 (Memory)</th>
                                <th>網路 (Network)</th>
                                <th>磁碟 I/O (Disk I/O)</th>
                                <th>重啟次數 (Restart)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var container in _docker.Containers)
                            {
                                <tr>
                                    <td>@ServiceDisplayName(container.Service)</td>
                                    <td>@container.Name</td>
                                    <td>
                                        <span class="status-badge @StatusClass(container.State)">@StatusText(container.State)</span>
                                        <span class="status-badge @StatusClass(container.Health)">@StatusText(container.Health)</span>
                                    </td>
                                    <td>@DashboardFormatting.Percent(container.CpuPercent)</td>
                                    <td>@DashboardFormatting.Bytes(container.MemoryUsageBytes) / @DashboardFormatting.Bytes(container.MemoryLimitBytes)</td>
                                    <td>@DashboardFormatting.Bytes(container.NetworkRxBytes) / @DashboardFormatting.Bytes(container.NetworkTxBytes)</td>
                                    <td>@DashboardFormatting.Bytes(container.DiskReadBytes) / @DashboardFormatting.Bytes(container.DiskWriteBytes)</td>
                                    <td>@DashboardFormatting.Integer(container.RestartCount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel">
                <div class="panel-title">近 24 小時錯誤日誌</div>
                <div class="stack-scroll-shell">
                    <div class="stack-list">
                        @if (_overview.RecentErrors.Count == 0)
                        {
                            <div class="empty-inline">近 24 小時沒有 Error / Critical log。</div>
                        }
                        else
                        {
                            @foreach (var error in RecentErrorsPreview())
                            {
                                <article class="stack-item stack-item-split">
                                    <div class="stack-item-content">
                                        <div class="stack-item-title">@error.ServiceName / @error.Level</div>
                                        <div class="stack-item-copy">@error.Message</div>
                                    </div>
                                    <div class="stack-item-actions stack-item-actions-inline stack-item-actions-column">
                                        <button class="ghost-button" @onclick="@(() => CopyLogAsync(error))">複製 JSON</button>
                                        <div class="stack-item-meta stack-item-meta-compact"><ClientRelativeTime Value="error.CreatedAt" /></div>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>
            </section>

            <section class="panel">
                <div class="panel-title">進行中工作</div>
                <div class="stack-scroll-shell">
                    <div class="stack-list">
                        @if (_overview.ActiveJobs.Count == 0)
                        {
                            <div class="empty-inline">目前沒有等待中 / 執行中的工作。</div>
                        }
                        else
                        {
                            @foreach (var job in ActiveJobsPreview())
                            {
                                <article class="stack-item stack-item-split">
                                    <div class="stack-item-content">
                                        <div class="stack-item-title">@DashboardText.Label(job.JobType) / @DashboardText.Label(job.Status)</div>
                                        <div class="stack-item-copy">@job.PayloadJson</div>
                                    </div>
                                    <div class="stack-item-actions stack-item-actions-inline stack-item-actions-column">
                                        <button class="ghost-button" @onclick="@(() => CopyJobAsync(job))">複製 JSON</button>
                                        <div class="stack-item-meta stack-item-meta-compact"><ClientRelativeTime Value="job.CreatedAt" /></div>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>
            </section>
        </div>
    }
    </ChildContent>
</PageViewport>

