@page "/"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor

<PageTitle>Context Hub | 總覽</PageTitle>

<PageViewport Title="總覽"
              Subtitle="只顯示需要注意、需要決策或最值得立即行動的訊號。"
              Breadcrumb="ContextHub / Overview"
              BodyClass="page-viewport-body overview-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           SnapshotAtUtc="_overview?.SnapshotAtUtc"
                           IsRefreshing="_loading"
                           PollingIntervalSeconds="@PollingIntervalSeconds"
                           WarningText="@_overview?.SnapshotStatus?.Warning" />
        </div>
        <div class="page-actions-primary">
            <a class="ghost-button button-link" href="/operations">開啟營運中心</a>
            <button class="primary-button" @onclick="LoadAsync" disabled="@_loading">刷新</button>
        </div>
    </Actions>
    <ChildContent>
        @if (_overview is null && _loading)
        {
            <DashboardAsyncState State="loading" Title="載入總覽" Message="正在整理最新健康、風險與行動訊號。" />
        }
        else if (_overview is null)
        {
            <DashboardAsyncState State="error" Title="總覽目前不可用" Message="@(_loadError ?? "Overview data unavailable.")">
                <Action><button class="ghost-button" @onclick="LoadAsync">重試</button></Action>
            </DashboardAsyncState>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <DashboardAsyncState State="degraded" Title="顯示上次成功資料" Message="@_loadError" />
            }

            <section class="overview-signal-strip" aria-label="高行動價值摘要">
                @foreach (var metric in _overview.Metrics.Take(3))
                {
                    <article class="overview-signal" title="@metric.Definition">
                        <span>@metric.Label</span>
                        <strong>@DashboardFormatting.Integer(metric.Value)</strong>
                        <small>@MetricUnitText(metric.Unit)</small>
                    </article>
                }
                @if (_overview.Metrics.Count == 0)
                {
                    <article class="overview-signal overview-signal-empty">
                        <span>摘要訊號</span>
                        <strong>0</strong>
                        <small>等待資料</small>
                    </article>
                }
            </section>

            <section class="overview-action-grid">
                <article class="panel overview-health-panel">
                    <div class="panel-heading-row">
                        <div>
                            <div class="panel-title">平台健康</div>
                            <div class="panel-heading-meta">只列出最多三個需要注意的服務；完整 telemetry 位於 Operations。</div>
                        </div>
                        <span class="status-badge @(AttentionServices().Count == 0 ? "ok" : "warn")">
                            @(AttentionServices().Count == 0 ? "Healthy" : $"{AttentionServices().Count} attention")
                        </span>
                    </div>

                    <div class="overview-queue">
                        @if (AttentionServices().Count == 0)
                        {
                            <div class="empty-inline">目前沒有服務健康警示。</div>
                        }
                        else
                        {
                            @foreach (var service in AttentionServices())
                            {
                                <article class="overview-queue-item">
                                    <span class="status-badge @StatusClass(service.Status)">@DashboardText.Status(service.Status)</span>
                                    <div><strong>@DashboardText.Service(service.Name)</strong><span>@service.Description</span></div>
                                </article>
                            }
                        }
                    </div>
                    <a class="ghost-button button-link" href="/operations">檢視 Operations</a>
                </article>

                <article class="panel overview-risk-panel">
                    <div class="panel-heading-row">
                        <div>
                            <div class="panel-title">風險與異常</div>
                            <div class="panel-heading-meta">最新三筆 Error / Critical；不在總覽重複完整 log reader。</div>
                        </div>
                        <span class="status-badge @(_overview.RecentErrors.Count == 0 ? "ok" : "bad")">@DashboardFormatting.Integer(_overview.RecentErrors.Count)</span>
                    </div>
                    <div class="overview-queue">
                        @if (_overview.RecentErrors.Count == 0)
                        {
                            <div class="empty-inline">目前沒有待檢視異常。</div>
                        }
                        else
                        {
                            @foreach (var error in _overview.RecentErrors.Take(3))
                            {
                                <article class="overview-queue-item">
                                    <span class="status-badge bad">@error.Level</span>
                                    <div><strong>@error.ServiceName</strong><span>@error.Message</span></div>
                                    <ClientRelativeTime Value="error.CreatedAt" />
                                </article>
                            }
                        }
                    </div>
                    <a class="ghost-button button-link" href="/logs">檢視日誌與 diagnostics</a>
                </article>

                <article class="panel overview-decision-panel">
                    <div class="panel-heading-row">
                        <div>
                            <div class="panel-title">需要人員決策</div>
                            <div class="panel-heading-meta">將 governance、proposal 與 blocked workflow 導向唯一 canonical surface。</div>
                        </div>
                    </div>
                    <div class="overview-decision-links">
                        <a href="/inbox"><strong>待決事項</strong><span>處理需要人員裁決的 queue</span></a>
                        <a href="/chatgpt-proposals"><strong>ChatGPT 寫入審核</strong><span>檢視提案、authority 與 read-back</span></a>
                        <a href="/governance"><strong>治理檢查</strong><span>檢視 coverage、exceptions 與 receipts</span></a>
                    </div>
                </article>
            </section>

            <section class="panel overview-work-panel">
                <div class="panel-heading-row">
                    <div>
                        <div class="panel-title">進行中工作</div>
                        <div class="panel-heading-meta">最多三筆；完整 queue、payload 與維護操作留在專屬頁面。</div>
                    </div>
                    <span class="status-badge neutral">@DashboardFormatting.Integer(_overview.ActiveJobs.Count)</span>
                </div>
                <div class="overview-work-list">
                    @if (_overview.ActiveJobs.Count == 0)
                    {
                        <div class="empty-inline">目前沒有等待中或執行中的背景工作。</div>
                    }
                    else
                    {
                        @foreach (var job in _overview.ActiveJobs.Take(3))
                        {
                            <article>
                                <span class="status-badge @StatusClass(job.Status.ToString())">@DashboardText.Label(job.Status)</span>
                                <div><strong>@DashboardText.Label(job.JobType)</strong><span>受控背景工作；詳細參數僅在授權後顯示。</span></div>
                                <ClientRelativeTime Value="job.CreatedAt" />
                            </article>
                        }
                    }
                </div>
                <a class="ghost-button button-link" href="/jobs">檢視背景工作</a>
            </section>

            <footer class="overview-release-strip">
                <span>Release identity</span>
                <strong>@_overview.BuildVersion</strong>
                <ClientLocalTime Value="_overview.BuildTimestampUtc" />
                <span>Snapshot <ClientLocalTime Value="_overview.SnapshotAtUtc" /></span>
            </footer>
        }
    </ChildContent>
</PageViewport>

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollingTask;
    private DashboardOverviewResult? _overview;
    private bool _loading;
    private DateTimeOffset? _lastUpdatedAt;
    private string? _loadError;
    private InstanceSettingsSnapshot? _settingsSnapshot;
    private int PollingIntervalSeconds => _settingsSnapshot?.Behavior.SnapshotPolling.StatusCoreSeconds ?? 15;

    protected override async Task OnInitializedAsync()
    {
        _settingsSnapshot = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && PollingIntervalSeconds > 0)
        {
            _pollingTask = PollAsync();
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _overview = await ApiClient.GetOverviewAsync(_cts.Token);
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _loadError = null;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _loadError = DashboardUiErrorFormatter.BuildLoadError("總覽", ex, _overview is not null);
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<DashboardServiceHealthResult> AttentionServices()
        => _overview?.Services
            .Where(service => !service.Status.Equals("Healthy", StringComparison.OrdinalIgnoreCase) &&
                              !service.Status.Equals("Ready", StringComparison.OrdinalIgnoreCase))
            .Take(3)
            .ToArray() ?? [];

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(PollingIntervalSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static string MetricUnitText(string unit) => unit.ToLowerInvariant() switch
    {
        "items" => "筆",
        "jobs" => "項",
        "logs" => "筆",
        _ => unit
    };

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" or "ready" or "running" or "completed" => "ok",
        "degraded" or "warning" or "pending" or "blocked" => "warn",
        "failed" or "critical" or "error" or "unhealthy" => "bad",
        _ => "neutral"
    };

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_pollingTask is not null)
        {
            _ = CompleteDisposeAsync(_pollingTask, _cts);
            return ValueTask.CompletedTask;
        }

        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private static async Task CompleteDisposeAsync(Task pollingTask, CancellationTokenSource cts)
    {
        try { await pollingTask; }
        catch (OperationCanceledException) { }
        finally { cts.Dispose(); }
    }
}
