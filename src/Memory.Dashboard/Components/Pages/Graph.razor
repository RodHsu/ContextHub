    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartPollingLoop();
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("contextHubGraph.register", _viewportRef, _panContentRef);
            _viewportRegistered = true;

            if (_graph?.Nodes.Count > 0)
            {
                if (_fitGraphPending)
                {
                    await JSRuntime.InvokeVoidAsync("contextHubGraph.fit", _viewportRef);
                    _fitGraphPending = false;
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("contextHubGraph.refresh", _viewportRef);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("contextHubGraph.reset", _viewportRef);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadAsync()
        => await LoadGraphAsync(preserveInteraction: false, waitForLock: true);

    private async Task LoadGraphAsync(bool preserveInteraction, bool waitForLock)
    {
        if (waitForLock)
        {
            await _refreshGate.WaitAsync(_cts.Token);
        }
        else if (!await _refreshGate.WaitAsync(0, _cts.Token))
        {
            return;
        }

        try
        {
            var previousSelectedId = _selectedNodeId;
            var previousFocusNodeId = _focusNodeId;
            var previousExpandedNodeIds = _expandedNodeIds.ToArray();

            _loading = true;
            await InvokeAsync(StateHasChanged);

            _graph = await ApiClient.GetMemoryGraphAsync(
                new MemoryGraphRequest(
                    null,
                    NormalizeEmpty(_tag),
                    NormalizeEmpty(_projectIdInput),
                    NormalizeEmpty(_projectQuery),
                    ParseProjectIds(_includedProjectIds),
                    _queryMode,
                    _useSummaryLayer,
                    _graphMode,
                    _maxNodes,
                    _includeSimilarity,
                    Parse<MemoryScope>(_scope),
                    Parse<MemoryType>(_memoryType),
                    Parse<MemoryStatus>(_status),
                    NormalizeEmpty(_sourceType)),
                _cts.Token);

            var graphNodeIds = _graph.Nodes.Select(node => node.Id).ToHashSet();
            Guid? nextId;
            if (preserveInteraction)
            {
                nextId = previousSelectedId.HasValue && graphNodeIds.Contains(previousSelectedId.Value)
                    ? previousSelectedId
                    : ResolveInitialSelectionId();
                _focusNodeId = previousFocusNodeId.HasValue && graphNodeIds.Contains(previousFocusNodeId.Value)
                    ? previousFocusNodeId
                    : null;
                _expandedNodeIds.Clear();
                foreach (var nodeId in previousExpandedNodeIds.Where(graphNodeIds.Contains))
                {
                    _expandedNodeIds.Add(nodeId);
                }
            }
            else
            {
                _expandedNodeIds.Clear();
                nextId = ResolveInitialSelectionId();
                _focusNodeId = null;
                _fitGraphPending = true;
            }

            _selectedNodeId = nextId;
            _selectedDetails = nextId is Guid selectedId && selectedId != Guid.Empty
                ? await ApiClient.GetMemoryDetailsAsync(selectedId, _cts.Token)
                : null;
            _lastUpdatedAt = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            ShowMessage($"無法更新記憶圖譜：{ex.Message}");
        }
        finally
        {
            _loading = false;
            _refreshGate.Release();
        }
    }

