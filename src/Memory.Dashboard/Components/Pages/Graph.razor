    private static string BuildNodeCategoryLabel(MemoryGraphNodeResult node)
        => $"{node.ProjectId} · {DashboardText.Label(node.MemoryType)}";

    private IReadOnlyList<GraphCategoryOption> BuildGraphCategoryOptions()
    {
        if (_graph is null)
        {
            return [];
        }

        var projectOptions = _graph.Nodes
            .GroupBy(node => node.ProjectId, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => new GraphCategoryOption(BuildProjectCategoryValue(group.Key), $"Project · {group.Key}", group.Count()));

        var typeOptions = _graph.Nodes
            .GroupBy(node => node.MemoryType)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => DashboardText.Label(group.Key), StringComparer.OrdinalIgnoreCase)
            .Select(group => new GraphCategoryOption(BuildTypeCategoryValue(group.Key), $"Type · {DashboardText.Label(group.Key)}", group.Count()));

        var scopeOptions = _graph.Nodes
            .GroupBy(node => node.Scope)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => DashboardText.Label(group.Key), StringComparer.OrdinalIgnoreCase)
            .Select(group => new GraphCategoryOption(BuildScopeCategoryValue(group.Key), $"Scope · {DashboardText.Label(group.Key)}", group.Count()));

        return projectOptions
            .Concat(typeOptions)
            .Concat(scopeOptions)
            .ToArray();
    }

    private IReadOnlyList<GraphCategorySummary> BuildVisibleCategorySummaries()
        => VisibleNodes
            .GroupBy(BuildCategoryKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => new GraphCategorySummary(
                group.Key,
                group.First().ProjectId,
                BuildProjectCategoryValue(group.First().ProjectId),
                group.Count()))
            .OrderByDescending(summary => summary.Count)
            .ThenBy(summary => summary.Label, StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();

    private static string BuildCategoryKey(MemoryGraphNodeResult node)
        => node.ProjectId;

    private static string BuildCategoryValue(MemoryGraphNodeResult node)
        => BuildProjectCategoryValue(node.ProjectId);

    private static string BuildProjectCategoryValue(string projectId)
        => $"project:{projectId}";

    private static string BuildTypeCategoryValue(MemoryType memoryType)
        => $"type:{memoryType}";

    private static string BuildScopeCategoryValue(MemoryScope scope)
        => $"scope:{scope}";

    private void StartPollingLoop()
    {
        if (_pollingTask is not null || GraphPollingIntervalSeconds <= 0)
        {
            return;
        }

        _pollingTask = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(GraphPollingIntervalSeconds));
            try
            {
                while (await timer.WaitForNextTickAsync(_cts.Token))
                {
                    await InvokeAsync(() => LoadGraphAsync(preserveInteraction: true, waitForLock: false));
                }
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested)
            {
            }
        });
    }

    private async Task LoadProjectOptionsAsync(CancellationToken cancellationToken)
    {
        var options = await ApiClient.GetMemoryProjectsAsync(null, 20, cancellationToken);
        if (!string.IsNullOrWhiteSpace(_currentProjectId) &&
            options.All(option => !string.Equals(option.ProjectId, _currentProjectId, StringComparison.OrdinalIgnoreCase)))
        {
            options = [new ProjectSuggestionResult(_currentProjectId!, 0), .. options];
        }

        _projectOptions = options;
    }

    private void ApplyProjectSelection(bool enforceIntegratedViewDefaults = false)
    {
        if (string.Equals(_selectedProjectFilter, AllProjectsSelectionValue, StringComparison.Ordinal))
        {
            _projectIdInput = null;
            _projectQuery = null;
            _includedProjectIds = null;

            if (enforceIntegratedViewDefaults)
            {
                _queryMode = MemoryQueryMode.CurrentOnly;
                _useSummaryLayer = false;
                _graphMode = MemoryGraphMode.ProjectFull;

                _includeSimilarity = false;
            }

            return;
        }

        _projectIdInput = NormalizeEmpty(_selectedProjectFilter);
        _projectQuery = null;
    }

    private string BuildProjectOptionLabel(ProjectSuggestionResult option)
    {
        if (!string.IsNullOrWhiteSpace(_currentProjectId) &&
            string.Equals(option.ProjectId, _currentProjectId, StringComparison.OrdinalIgnoreCase))
        {
        return option.ItemCount > 0
            ? $"{option.ProjectId} · 目前專案 · {DashboardFormatting.Integer(option.ItemCount)} 筆"
            : $"{option.ProjectId} · 目前專案";
        }

        return option.ItemCount > 0
            ? $"{option.ProjectId} · {DashboardFormatting.Integer(option.ItemCount)} 筆"
            : option.ProjectId;
    }

    private static string AbbreviateSource(string sourceLabel)
        => string.IsNullOrWhiteSpace(sourceLabel)
            ? "SRC"
            : string.Concat(sourceLabel
                .Split([' ', '-', '_', '/'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

    private static string EdgeClass(string edgeType)
        => string.Equals(edgeType, "similar", StringComparison.OrdinalIgnoreCase) ? "graph-edge-similar" : "graph-edge-explicit";

    private static TEnum? Parse<TEnum>(string? value)
        where TEnum : struct, Enum
        => Enum.TryParse<TEnum>(value, true, out var parsed) ? parsed : null;

    private static string? NormalizeEmpty(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static IReadOnlyList<string>? ParseProjectIds(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? null
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

    private Guid? ResolveInitialSelectionId()
    {
        if (SelectedNodeQueryId.HasValue &&
            _graph?.Nodes.Any(node => node.Id == SelectedNodeQueryId.Value) == true)
        {
            return SelectedNodeQueryId.Value;
        }

        var seedId = SeedNodeIds.FirstOrDefault();
        return seedId != Guid.Empty ? seedId : _graph?.Nodes.FirstOrDefault()?.Id;
    }

    private string BuildNodeSelectionHref(Guid nodeId)
        => NavigationManager.GetUriWithQueryParameter("selected", nodeId);

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();

        if (_viewportRegistered)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("contextHubGraph.unregister", _viewportRef);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _cts.Dispose();
        _refreshGate.Dispose();
    }

