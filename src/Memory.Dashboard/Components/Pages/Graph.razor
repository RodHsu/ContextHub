@page "/graph"
@using System.Globalization
@using Memory.Application
@using Microsoft.JSInterop
@inject IContextHubApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor
@inject IOptions<DashboardOptions> DashboardOptionsAccessor
@implements IAsyncDisposable

<PageTitle>Context Hub | 記憶圖譜</PageTitle>

<PageViewport Title="記憶圖譜"
              Subtitle="以關聯鄰域、hub 節點與 similarity layer 檢閱記憶之間真正可追溯的脈絡。"
              BodyClass="page-viewport-body graph-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           IsRefreshing="_loading"
                           PollingIntervalSeconds="GraphPollingIntervalSeconds" />
        </div>
        <div class="page-actions-secondary">
            <InfoPopover Label="顯示圖譜模式說明" Title="圖譜模式">
                <p><code>Seeded</code> 以查詢結果或目前條件下的重要條目為種子，向外延伸 explicit links 與 similarity 鄰居。</p>
                <p><code>ProjectFull</code> 會在目前篩選範圍內選出高關聯節點，形成受控的專案全圖。</p>
                <p>Similarity 只作顯示用途，不會寫回 <code>memory_links</code>。</p>
            </InfoPopover>
            <button class="ghost-button" @onclick="ExpandFocusedNeighborsAsync" disabled="@(_loading || _focusNodeId is null)">展開鄰居</button>
            <button class="ghost-button" @onclick="ReturnToSeedsAsync" disabled="@(_loading || _graph is null)">回到種子</button>
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="LoadAsync" disabled="@_loading">更新圖譜</button>
        </div>
    </Actions>
    <ChildContent>
        <div class="graph-workspace">
            <section class="panel graph-filter-panel">
                <div class="filter-panel-heading">
                    <div>
                        <div class="panel-title">圖譜範圍</div>
                        <div class="panel-heading-meta panel-heading-meta-left">保留最常用的 project、模式與節點上限，次要條件收進進階篩選。</div>
                    </div>
                </div>
                <div class="graph-filter-stack graph-filter-quick-stack">
                    <label>
                        <span>專案檢視</span>
                        <select aria-label="專案檢視"
                                @bind="_selectedProjectFilter"
                                @bind:after="HandleProjectSelectionChangedAsync">
                            <option value="@AllProjectsSelectionValue">全部專案整合視圖</option>
                            @foreach (var option in _projectOptions)
                            {
                                <option value="@option.ProjectId">@BuildProjectOptionLabel(option)</option>
                            }
                        </select>
                        <small class="graph-field-note">可直接切到全部專案整合狀態，或只看單一 project 的圖譜。</small>
                    </label>
                    <label>
                        <span>圖譜模式</span>
                        <select @bind="_graphMode">
                            <option value="@MemoryGraphMode.Seeded">Seeded</option>
                            <option value="@MemoryGraphMode.ProjectFull">ProjectFull</option>
                        </select>
                    </label>
                    <label>
                        <span>節點上限</span>
                        <input type="number" min="12" max="120" @bind="_maxNodes" />
                    </label>
                    <label class="toggle-field">
                        <input type="checkbox" @bind="_includeSimilarity" />
                        <span>顯示 similarity 邊</span>
                    </label>
                    <label class="toggle-field">
                        <input type="checkbox" @bind="_useSummaryLayer" />
                        <span>一併讀取綜合層</span>
                    </label>
                </div>
                <details class="filter-advanced graph-advanced-filter">
                    <summary>
                        <span>進階資料條件</span>
                        <small>參考專案、Tag、來源、Scope、Type、Status</small>
                    </summary>
                    <div class="graph-filter-stack graph-filter-advanced-stack">
                        <label>
                            <span>參考專案</span>
                            <input @bind="_includedProjectIds" placeholder="以逗號分隔" />
                            <small class="graph-field-note">僅在單一專案模式下，用來擴充跨專案鄰居。</small>
                        </label>
                        <label>
                            <span>標籤 (Tag)</span>
                            <input @bind="_tag" placeholder="例如 graph, api" />
                        </label>
                        <label>
                            <span>來源類型</span>
                            <input @bind="_sourceType" placeholder="例如 codex, document" />
                        </label>
                        <label>
                            <span>查詢模式</span>
                            <select @bind="_queryMode">
                                <option value="@MemoryQueryMode.CurrentOnly">目前專案</option>
                                <option value="@MemoryQueryMode.CurrentPlusReferencedProjects">目前 + 參考專案</option>
                                <option value="@MemoryQueryMode.SummaryOnly">共用綜合層</option>
                            </select>
                        </label>
                        <label>
                            <span>範圍</span>
                            <select @bind="_scope">
                                <option value="">全部範圍</option>
                                @foreach (var scope in Enum.GetValues<MemoryScope>())
                                {
                                    <option value="@scope">@DashboardText.Label(scope)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>類型</span>
                            <select @bind="_memoryType">
                                <option value="">全部類型</option>
                                @foreach (var type in Enum.GetValues<MemoryType>())
                                {
                                    <option value="@type">@DashboardText.Label(type)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>狀態</span>
                            <select @bind="_status">
                                <option value="">全部狀態</option>
                                @foreach (var status in Enum.GetValues<MemoryStatus>())
                                {
                                    <option value="@status">@DashboardText.Label(status)</option>
                                }
                            </select>
                        </label>
                    </div>
                </details>
            </section>

            <section class="panel graph-canvas-panel @ExpandedCanvasCss">
                <div class="graph-panel-header">
                    <div class="graph-panel-header-copy">
                        <div class="panel-title">記憶關聯</div>
                        <div class="table-subtitle">用來看「哪些記憶互相支撐同一個脈絡」，不是一般資料清單；關聯不足時會先顯示索引與篩選狀態。</div>
                        <div class="graph-status-strip">
                            <span class="graph-status-chip">@CurrentProjectScopeLabel</span>
                            <span class="graph-status-chip">@GraphModeLabel</span>
                            <span class="graph-status-chip">@GraphInsights.ComponentLabel</span>
                            <span class="graph-status-chip">@AutoRefreshLabel</span>
                        </div>
                    </div>
                    <div class="graph-toolbar">
                        <span class="graph-toolbar-chip">@DashboardFormatting.Integer(VisibleNodes.Count) 節點</span>
                        <span class="graph-toolbar-chip">@DashboardFormatting.Integer(VisibleEdges.Count) 邊</span>
                        <span class="graph-toolbar-chip">@DashboardFormatting.Integer(SelectedNeighborRelations.Count) 相鄰</span>
                        <span class="graph-toolbar-chip graph-toolbar-chip-live" data-graph-zoom-chip>Zoom 1.00x</span>
                        <button type="button" class="ghost-button" @onclick="ZoomOutAsync" disabled="@(_loading || _graph?.Nodes.Count == 0)">-</button>
                        <button type="button" class="ghost-button" @onclick="ZoomInAsync" disabled="@(_loading || _graph?.Nodes.Count == 0)">+</button>
                        <button type="button" class="ghost-button" @onclick="FitGraphAsync" disabled="@(_loading || _graph?.Nodes.Count == 0)">Fit</button>
                        <button type="button" class="ghost-button" @onclick="ResetGraphAsync" disabled="@(_loading || _graph?.Nodes.Count == 0)">Reset</button>
                        <button type="button" class="ghost-button" @onclick="ToggleCanvasExpandedAsync" disabled="@(_graph?.Nodes.Count == 0)">
                            @(_isCanvasExpanded ? "收合圖表" : "全螢幕")
                        </button>
                    </div>
                </div>

                @if (_graph?.Stats.Truncated == true)
                {
                    <div class="inline-alert inline-alert-warning graph-alert">
                        @_graph.Stats.TruncationReason
                    </div>
                }

                <div class="graph-view-toolbar" aria-label="圖譜顯示控制">
                    <label class="graph-view-field graph-view-search-field">
                        <span>搜尋</span>
                        <input @bind="_viewQuery"
                               @bind:event="oninput"
                               type="search"
                               autocomplete="off"
                               placeholder="標題、摘要、專案、標籤、來源" />
                    </label>
                    <label class="graph-view-field">
                        <span>分類</span>
                        <select @bind="_viewCategory">
                            <option value="@AllGraphCategoryValue">全部</option>
                            @foreach (var option in GraphCategoryOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label class="graph-view-field graph-view-mode-field">
                        <span>顯示</span>
                        <select @bind="_viewDisplayMode">
                            <option value="@GraphDisplayConnected">關聯節點</option>
                            <option value="@GraphDisplayAll">全部節點</option>
                            <option value="@GraphDisplayNeighborhood">相鄰探索</option>
                        </select>
                    </label>
                    <label class="graph-view-toggle">
                        <input type="checkbox" @bind="_viewShowSimilarityEdges" />
                        <span>相似關聯</span>
                    </label>
                    <label class="graph-view-toggle">
                        <input type="checkbox" @bind="_viewShowIsolatedNodes" />
                        <span>孤立節點</span>
                    </label>
                    <label class="graph-view-toggle">
                        <input type="checkbox" @bind="_viewShowLabels" />
                        <span>節點標籤</span>
                    </label>
                    <div class="graph-view-toolbar-metrics" aria-live="polite" aria-label="目前圖面統計">
                        <span class="graph-view-stat-chip"><span>節點</span><strong>@DashboardFormatting.Integer(VisibleNodes.Count)</strong></span>
                        <span class="graph-view-stat-chip"><span>關聯</span><strong>@DashboardFormatting.Integer(VisibleEdges.Count)</strong></span>
                        <span class="graph-view-stat-chip"><span>分類</span><strong>@DashboardFormatting.Integer(VisibleCategoryCount)</strong></span>
                    </div>
                </div>

                <div class="graph-legend">
                    <span class="graph-legend-item"><span class="graph-legend-line graph-legend-line-explicit"></span>主要關聯</span>
                    <span class="graph-legend-item"><span class="graph-legend-line graph-legend-line-similar"></span>相似關聯</span>
                    <span class="graph-legend-item"><span class="graph-legend-seed"></span>Seed</span>
                    <span class="graph-legend-item"><span class="graph-legend-node graph-legend-node-hub"></span>Hub</span>
                    <span class="graph-legend-item"><span class="graph-legend-node graph-legend-node-bridge"></span>Bridge</span>
                    <span class="graph-legend-item graph-legend-hint">滾輪縮放</span>
                    <span class="graph-legend-item graph-legend-hint">拖曳圖面平移</span>
                    <span class="graph-legend-item graph-legend-hint">雙擊重整視角</span>
                </div>

                <div class="graph-insight-strip" aria-label="關聯洞察">
                    <span><strong>@DashboardFormatting.Integer(GraphInsights.HubCount)</strong> hub nodes</span>
                    <span><strong>@DashboardFormatting.Integer(GraphInsights.IsolatedCount)</strong> isolated</span>
                    <span><strong>@DashboardFormatting.Integer(GraphInsights.ExplicitEdgeCount)</strong> explicit</span>
                    <span><strong>@DashboardFormatting.Integer(GraphInsights.SimilarityEdgeCount)</strong> similar</span>
                    @if (!string.IsNullOrWhiteSpace(GraphInsights.TopHubTitle))
                    {
                        <span class="graph-insight-primary">Top hub · @GraphInsights.TopHubTitle</span>
                    }
                </div>

                <div class="graph-scroll-shell" @ref="_viewportRef">
                    <div class="graph-pan-content" @ref="_panContentRef" style="@PanContentDimensionsStyle">
                        @if (_graph is null)
                        {
                            <div class="graph-empty-state graph-empty-state-rich">
                                <div class="graph-empty-kicker">圖譜載入中</div>
                                <strong>正在讀取記憶關聯 snapshot</strong>
                                <p>這裡會呈現 explicit links、similarity layer 與目前篩選下的 hub 節點。</p>
                            </div>
                        }
                        else if (_graph.Nodes.Count == 0)
                        {
                            <div class="graph-empty-state graph-empty-state-rich">
                                <div class="graph-empty-kicker">目前沒有可繪製節點</div>
                                <strong>這通常是資料或篩選狀態，不是圖形引擎問題</strong>
                                <p>@GraphEmptyStateMessage</p>
                                <div class="graph-empty-actions">
                                    <span>@CurrentProjectScopeLabel</span>
                                    <span>@GraphModeLabel</span>
                                    <span>@(string.IsNullOrWhiteSpace(_viewQuery) ? "未套用搜尋" : $"搜尋：{_viewQuery}")</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="graph-canvas" style="@($"width:{Canvas.Width}px;height:{Canvas.Height}px;")">
                                <svg class="graph-view-svg" viewBox="@Canvas.ViewBox" role="img" aria-label="記憶關聯圖">
                                    @foreach (var edge in Canvas.Edges)
                                    {
                                        <line class="graph-edge @EdgeVisualClass(edge)"
                                              style="@BuildEdgeStyle(edge)"
                                              x1="@edge.FromCenterX"
                                              y1="@edge.FromCenterY"
                                              x2="@edge.ToCenterX"
                                              y2="@edge.ToCenterY" />
                                    }
                                    @foreach (var node in Canvas.Nodes)
                                    {
                                        var nodeId = node.Node.Id;
                                        <a @key="nodeId"
                                           href="@BuildNodeSelectionHref(nodeId)"
                                           class="@BuildNodeVisualClass(node)"
                                           style="@BuildNodeStyle(node)"
                                           transform="@BuildNodeTransform(node)"
                                           @onclick="() => SelectNodeAsync(nodeId)"
                                           role="button"
                                           aria-label="@BuildNodeAccessibleLabel(node.Node)"
                                           data-graph-node-id="@nodeId"
                                           data-graph-node-weight="@FormatInvariant(NodeWeight(node.Node))">
                                            <title>@BuildNodeAccessibleLabel(node.Node)</title>
                                            <rect class="graph-view-node-hit"
                                                  x="@FormatInvariant(BuildNodeHitX(node.Node))"
                                                  y="@FormatInvariant(BuildNodeHitY(node.Node))"
                                                  width="@FormatInvariant(BuildNodeHitWidth(node.Node))"
                                                  height="@FormatInvariant(BuildNodeHitHeight(node.Node))"
                                                  rx="6" />
                                            <circle r="@FormatInvariant(BuildNodeRadius(node.Node))" />
                                            <svg:text class="graph-view-node-initial"
                                                      x="0"
                                                      y="0"
                                                      aria-hidden="true">
                                                @AbbreviateSource(node.Node.SourceLabel)
                                            </svg:text>
                                            <svg:text class="@BuildNodeTitleClass()"
                                                      x="@FormatInvariant(BuildNodeRadius(node.Node) + 5d)"
                                                      y="4">
                                                @node.Node.Title
                                            </svg:text>
                                        </a>
                                    }
                                </svg>
                            </div>
                        }
                    </div>
                    <div class="graph-viewport-controls" role="toolbar" aria-label="圖面視角操作">
                        <div class="graph-pan-pad">
                            <button type="button" class="graph-viewport-button graph-pan-up" title="向上移動" aria-label="向上移動" @onclick="PanUpAsync">↑</button>
                            <button type="button" class="graph-viewport-button graph-pan-left" title="向左移動" aria-label="向左移動" @onclick="PanLeftAsync">←</button>
                            <button type="button" class="graph-viewport-button graph-pan-right" title="向右移動" aria-label="向右移動" @onclick="PanRightAsync">→</button>
                            <button type="button" class="graph-viewport-button graph-pan-down" title="向下移動" aria-label="向下移動" @onclick="PanDownAsync">↓</button>
                        </div>
                        <div class="graph-zoom-pad">
                            <button type="button" class="graph-viewport-button" title="放大" aria-label="放大" @onclick="ZoomInAsync">+</button>
                            <button type="button" class="graph-viewport-button" title="縮小" aria-label="縮小" @onclick="ZoomOutAsync">−</button>
                            <button type="button" class="graph-viewport-button" title="適應視圖" aria-label="適應視圖" @onclick="FitGraphAsync">⌂</button>
                            <button type="button" class="graph-viewport-button" title="全螢幕顯示" aria-label="全螢幕顯示" @onclick="ToggleCanvasExpandedAsync">⛶</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel graph-detail-panel">
                <div class="panel-title">關聯探索</div>
                <div class="panel-scroll-body detail-scroll-shell graph-detail-scroll">
                    <section class="memory-detail-section graph-overview-section">
                        <div class="graph-view-kicker">目前視圖</div>
                        <div class="graph-view-details-title">@GraphOverviewTitle</div>
                        <div class="graph-view-details-copy">單擊節點查看內容與相鄰記憶；使用搜尋、分類與顯示模式縮小圖面。若沒有節點，先放寬篩選或確認 graph index snapshot 是否完成。</div>
                        <div class="graph-view-metrics">
                            <div class="graph-view-metric"><span>節點</span><strong>@DashboardFormatting.Integer(VisibleNodes.Count)</strong></div>
                            <div class="graph-view-metric"><span>關聯</span><strong>@DashboardFormatting.Integer(VisibleEdges.Count)</strong></div>
                            <div class="graph-view-metric"><span>分類</span><strong>@DashboardFormatting.Integer(VisibleCategoryCount)</strong></div>
                        </div>
                        <div class="graph-view-section graph-view-legend-section">
                            <div class="graph-view-section-title">線條圖例</div>
                            <div class="graph-view-legend-row"><span class="graph-view-legend-line is-explicit"></span><span>主要關聯</span></div>
                            <div class="graph-view-legend-row"><span class="graph-view-legend-line is-similar"></span><span>相似關聯</span></div>
                            <div class="graph-view-legend-row"><span class="graph-view-legend-line is-selected"></span><span>目前節點鄰域</span></div>
                        </div>
                        <div class="graph-view-section graph-view-category-section">
                            <div class="graph-view-section-title">主要分類</div>
                            @foreach (var category in VisibleCategorySummaries)
                            {
                                <button type="button"
                                        class="graph-view-category-row"
                                        @onclick="() => SelectViewCategory(category.Value)">
                                    <span>@category.Label</span>
                                    <strong>@DashboardFormatting.Integer(category.Count)</strong>
                                </button>
                            }
                        </div>
                    </section>
                    @if (SelectedGraphNode is null)
                    {
                        <div class="empty-inline">點選節點後顯示內容、revisions、links 與來源上下文。</div>
                    }
                    else
                    {
                        <div class="graph-detail-stack">
                            <div class="graph-detail-actions">
                                <button type="button" class="ghost-button" @onclick="ToggleFocusNodeAsync">
                                    @(_focusNodeId == SelectedGraphNode.Id ? "取消聚焦" : "聚焦此節點")
                                </button>
                                <button type="button" class="ghost-button" @onclick="ExpandFocusedNeighborsAsync" disabled="@(_focusNodeId != SelectedGraphNode.Id)">展開二階鄰居</button>
                            </div>

                            <dl class="definition-grid">
                                <div><dt>標題</dt><dd>@SelectedGraphNode.Title</dd></div>
                                <div><dt>專案</dt><dd>@SelectedGraphNode.ProjectId</dd></div>
                                <div><dt>類型</dt><dd>@DashboardText.Label(SelectedGraphNode.MemoryType)</dd></div>
                                <div><dt>範圍</dt><dd>@DashboardText.Label(SelectedGraphNode.Scope)</dd></div>
                                <div><dt>狀態</dt><dd>@DashboardText.Label(SelectedGraphNode.Status)</dd></div>
                                <div><dt>來源</dt><dd>@SelectedGraphNode.SourceType / @SelectedGraphNode.SourceRef</dd></div>
                                <div><dt>重要性</dt><dd>@SelectedGraphNode.Importance</dd></div>
                                <div><dt>可信度</dt><dd>@SelectedGraphNode.Confidence</dd></div>
                                <div><dt>更新時間</dt><dd><ClientLocalTime Value="SelectedGraphNode.UpdatedAt" /></dd></div>
                            </dl>

                            <div class="code-block graph-detail-summary">@SelectedGraphNode.Summary</div>

                            <section class="memory-detail-section graph-neighbor-section">
                                <div class="subpanel-title">Relationship Neighborhood</div>
                                @if (SelectedNeighborRelations.Count == 0)
                                {
                                    <div class="empty-inline">這個節點在目前篩選圖內沒有直接鄰居。</div>
                                }
                                else
                                {
                                    <div class="graph-neighbor-list">
                                        @foreach (var relation in SelectedNeighborRelations.Take(10))
                                        {
                                            <a class="graph-neighbor-item @RelationClass(relation)"
                                               href="@BuildNodeSelectionHref(relation.Node.Id)">
                                                <span class="graph-neighbor-kicker">
                                                    <span>@relation.DirectionLabel</span>
                                                    <span>@relation.Edge.Label</span>
                                                </span>
                                                <span class="graph-neighbor-title">@relation.Node.Title</span>
                                                <span class="graph-neighbor-meta">
                                                    @relation.Node.ProjectId · @DashboardText.Label(relation.Node.MemoryType) · @relation.StrengthLabel
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>

                            @if (_selectedDetails?.SourceContext is not null)
                            {
                                <section class="memory-detail-section">
                                    <div class="subpanel-title">Source Context</div>
                                    <dl class="definition-grid">
                                        <div><dt>Connector</dt><dd>@(_selectedDetails.SourceContext.ConnectorName ?? "n/a")</dd></div>
                                        <div><dt>Connector Id</dt><dd>@(_selectedDetails.SourceContext.SourceConnectionId?.ToString() ?? "n/a")</dd></div>
                                        <div><dt>Source Version</dt><dd>@(_selectedDetails.SourceContext.SourceVersion ?? "n/a")</dd></div>
                                        <div><dt>Origin</dt><dd>@(_selectedDetails.SourceContext.OriginPathOrUrl ?? "n/a")</dd></div>
                                    </dl>
                                    @if (_selectedDetails.SourceContext.Lineage.Count > 0)
                                    {
                                        <div class="stack-item-meta">@string.Join(" -> ", _selectedDetails.SourceContext.Lineage)</div>
                                    }
                                </section>
                            }

                            @if (_selectedDetails is not null)
                            {
                                <div class="code-block graph-detail-content">@_selectedDetails.Document.Content</div>

                                <section class="memory-detail-section">
                                    <div class="subpanel-title">Revisions</div>
                                    <div class="stack-list">
                                        @foreach (var revision in _selectedDetails.Revisions.Take(4))
                                        {
                                            <article class="stack-item">
                                                <div class="stack-item-title">v@revision.Version / @revision.ChangedBy</div>
                                                <div class="stack-item-copy">@revision.Title</div>
                                                <div class="stack-item-meta"><ClientLocalTime Value="revision.CreatedAt" /></div>
                                            </article>
                                        }
                                    </div>
                                </section>

                                @if (_selectedDetails.Links?.Count > 0)
                                {
                                    <section class="memory-detail-section">
                                        <div class="subpanel-title">Links</div>
                                        <div class="stack-list">
                                            @foreach (var link in _selectedDetails.Links.Take(6))
                                            {
                                                <article class="stack-item">
                                                    <div class="stack-item-title">@link.LinkType</div>
                                                    <div class="stack-item-meta">@link.FromId -> @link.ToId</div>
                                                </article>
                                            }
                                        </div>
                                    </section>
                                }
                            }
                        </div>
                    }
                </div>
            </section>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <DashboardToast Message="@_message" Sequence="@_messageSequence" OnDismiss="ClearMessage" />
        }
    </ChildContent>
</PageViewport>

@code {
