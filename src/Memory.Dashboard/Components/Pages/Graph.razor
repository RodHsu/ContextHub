    private static string BuildRelationDirectionLabel(MemoryGraphEdgeResult edge, Guid selectedId)
    {
        if (string.Equals(edge.EdgeType, "similar", StringComparison.OrdinalIgnoreCase))
        {
            return "Similarity";
        }

        return edge.FromId == selectedId ? "Outgoing" : "Incoming";
    }

    private static string BuildRelationStrengthLabel(MemoryGraphEdgeResult edge)
    {
        if (!string.Equals(edge.EdgeType, "similar", StringComparison.OrdinalIgnoreCase))
        {
            return "explicit link";
        }

        return edge.Score is decimal score
            ? $"score {score.ToString("0.###", CultureInfo.InvariantCulture)}"
            : "semantic neighbor";
    }

