    private HashSet<Guid> ResolveVisibleNodeIds()
    {
        var baseIds = BuildViewFilteredNodeIds();
        var visibleEdges = BuildVisibleEdges(baseIds).ToArray();

        if (string.Equals(_viewDisplayMode, GraphDisplayConnected, StringComparison.Ordinal) ||
            (!_viewShowIsolatedNodes && !HasActiveViewSearch))
        {
            var connectedIds = visibleEdges
                .SelectMany(edge => new[] { edge.FromId, edge.ToId })
                .ToHashSet();
            if (connectedIds.Count > 0)
            {
                baseIds.IntersectWith(connectedIds);
            }
        }

        if (string.Equals(_viewDisplayMode, GraphDisplayNeighborhood, StringComparison.Ordinal) &&
            SelectedGraphNode is { } selected &&
            baseIds.Contains(selected.Id))
        {
            var neighborhood = new HashSet<Guid> { selected.Id };
            AddNeighborIds(selected.Id, neighborhood, visibleEdges);
            baseIds.IntersectWith(neighborhood);
        }

        if (_focusNodeId is null)
        {
            return baseIds;
        }

        var focusedVisible = new HashSet<Guid>();
        foreach (var seedId in SeedNodeIds.Where(baseIds.Contains))
        {
            focusedVisible.Add(seedId);
        }

        if (baseIds.Contains(_focusNodeId.Value))
        {
            focusedVisible.Add(_focusNodeId.Value);
            AddNeighborIds(_focusNodeId.Value, focusedVisible, visibleEdges);
        }

        foreach (var expandedRoot in _expandedNodeIds.Where(baseIds.Contains))
        {
            var firstRing = GetNeighborIds(expandedRoot, visibleEdges).Where(baseIds.Contains).ToArray();
            foreach (var neighborId in firstRing)
            {
                focusedVisible.Add(neighborId);
                AddNeighborIds(neighborId, focusedVisible, visibleEdges);
            }
        }

        focusedVisible.IntersectWith(baseIds);
        return focusedVisible;
    }

    private bool HasActiveViewSearch => !string.IsNullOrWhiteSpace(_viewQuery);

    private HashSet<Guid> BuildViewFilteredNodeIds()
        => (_graph?.Nodes ?? [])
            .Where(MatchesViewQuery)
            .Where(MatchesViewCategory)
            .Select(node => node.Id)
            .ToHashSet();

    private IEnumerable<MemoryGraphEdgeResult> BuildVisibleEdges(IReadOnlySet<Guid> visibleNodeIds)
        => (_graph?.Edges ?? [])
            .Where(edge => visibleNodeIds.Contains(edge.FromId) && visibleNodeIds.Contains(edge.ToId))
            .Where(IsViewEdgeVisible);

    private IEnumerable<Guid> GetNeighborIds(Guid nodeId, IEnumerable<MemoryGraphEdgeResult>? edges = null)
        => (edges ?? _graph?.Edges ?? [])
            .Where(edge => edge.FromId == nodeId || edge.ToId == nodeId)
            .Select(edge => edge.FromId == nodeId ? edge.ToId : edge.FromId)
            .Distinct();

    private void AddNeighborIds(Guid nodeId, HashSet<Guid> visible, IEnumerable<MemoryGraphEdgeResult>? edges = null)
    {
        foreach (var neighborId in GetNeighborIds(nodeId, edges))
