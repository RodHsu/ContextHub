    }

    private bool IsViewEdgeVisible(MemoryGraphEdgeResult edge)
        => _viewShowSimilarityEdges ||
           !string.Equals(edge.EdgeType, "similar", StringComparison.OrdinalIgnoreCase);

    private bool MatchesViewQuery(MemoryGraphNodeResult node)
    {
        var query = NormalizeEmpty(_viewQuery);
        if (query is null)
        {
            return true;
        }

        return ContainsInvariant(node.Title, query) ||
               ContainsInvariant(node.Summary, query) ||
               ContainsInvariant(node.ProjectId, query) ||
               ContainsInvariant(node.SourceType, query) ||
               ContainsInvariant(node.SourceRef, query) ||
               node.Tags.Any(tag => ContainsInvariant(tag, query));
    }

    private bool MatchesViewCategory(MemoryGraphNodeResult node)
    {
        if (string.Equals(_viewCategory, AllGraphCategoryValue, StringComparison.Ordinal))
        {
            return true;
        }

        return string.Equals(_viewCategory, BuildCategoryValue(node), StringComparison.OrdinalIgnoreCase) ||
               string.Equals(_viewCategory, BuildTypeCategoryValue(node.MemoryType), StringComparison.OrdinalIgnoreCase) ||
               string.Equals(_viewCategory, BuildScopeCategoryValue(node.Scope), StringComparison.OrdinalIgnoreCase);
    }

    private static bool ContainsInvariant(string? value, string query)
        => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;

    private GraphInsightSummary BuildGraphInsights(
        IReadOnlyList<MemoryGraphNodeResult> nodes,
        IReadOnlyList<MemoryGraphEdgeResult> edges)
    {
        if (nodes.Count == 0)
        {
            return new GraphInsightSummary(0, 0, 0, null, 0, 0);
        }

        var nodeIds = nodes.Select(node => node.Id).ToHashSet();
        var adjacency = nodeIds.ToDictionary(id => id, _ => new HashSet<Guid>());
        foreach (var edge in edges)
        {
            if (!adjacency.ContainsKey(edge.FromId) || !adjacency.ContainsKey(edge.ToId))
            {
                continue;
            }

            adjacency[edge.FromId].Add(edge.ToId);
            adjacency[edge.ToId].Add(edge.FromId);
        }

        var visited = new HashSet<Guid>();
        var componentCount = 0;
        foreach (var nodeId in nodeIds)
        {
            if (!visited.Add(nodeId))
            {
                continue;
            }

            componentCount++;
            var queue = new Queue<Guid>();
            queue.Enqueue(nodeId);
            while (queue.TryDequeue(out var current))
            {
                foreach (var neighborId in adjacency[current])
                {
                    if (visited.Add(neighborId))
                    {
                        queue.Enqueue(neighborId);
                    }
                }
            }
        }

        var topHub = nodes
            .OrderByDescending(node => adjacency[node.Id].Count)
            .ThenByDescending(node => node.Importance)
            .FirstOrDefault();
        var hubCount = nodes.Count(node => adjacency[node.Id].Count >= 3);

        return new GraphInsightSummary(
            componentCount,
            nodes.Count(node => adjacency[node.Id].Count == 0),
            hubCount,
            topHub is not null && adjacency[topHub.Id].Count > 0 ? topHub.Title : null,
            edges.Count(edge => string.Equals(edge.EdgeType, "explicit", StringComparison.OrdinalIgnoreCase)),
            edges.Count(edge => string.Equals(edge.EdgeType, "similar", StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyList<GraphNeighborRelation> BuildSelectedNeighborRelations()
    {
        if (SelectedGraphNode is null || _graph is null)
        {
            return [];
        }

        var selectedId = SelectedGraphNode.Id;
        var nodeLookup = _graph.Nodes.ToDictionary(node => node.Id);

        return VisibleEdges
            .Where(edge => edge.FromId == selectedId || edge.ToId == selectedId)
            .Select(edge =>
            {
                var neighborId = edge.FromId == selectedId ? edge.ToId : edge.FromId;
                return nodeLookup.TryGetValue(neighborId, out var node)
                    ? new GraphNeighborRelation(node, edge, BuildRelationDirectionLabel(edge, selectedId), BuildRelationStrengthLabel(edge))
                    : null;
            })
            .Where(relation => relation is not null)
            .Select(relation => relation!)
            .OrderByDescending(relation => string.Equals(relation.Edge.EdgeType, "explicit", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(relation => relation.Edge.Score ?? 0)
            .ThenByDescending(relation => NodeDegree(relation.Node))
            .ThenBy(relation => relation.Node.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private GraphCanvasLayout BuildCanvasLayout(IReadOnlyList<MemoryGraphNodeResult> nodes, IReadOnlyList<MemoryGraphEdgeResult> edges)
    {
        if (nodes.Count == 0)
        {
            return new GraphCanvasLayout([], [], 1280, 720, "0 0 1280 720");
        }

        return _graphMode == MemoryGraphMode.ProjectFull
            ? BuildProjectFullLayout(nodes, edges)
            : BuildSeededLayout(nodes, edges);
    }

    private GraphCanvasLayout BuildSeededLayout(IReadOnlyList<MemoryGraphNodeResult> nodes, IReadOnlyList<MemoryGraphEdgeResult> edges)
    {
        const double nodeWidth = 34;
        const double nodeHeight = 34;
        const double centerX = 0;
        const double centerY = 0;
        var seedIds = SeedNodeIds.ToHashSet();
        var seeds = nodes
            .Where(node => seedIds.Contains(node.Id))
            .OrderByDescending(node => node.ExplicitLinkCount + node.SimilarityNeighborCount)
            .ThenByDescending(node => node.Importance)
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var explicitNodes = nodes
            .Where(node => !seedIds.Contains(node.Id) && node.ExplicitLinkCount > 0)
            .OrderByDescending(node => node.ExplicitLinkCount + node.SimilarityNeighborCount)
            .ThenByDescending(node => node.Importance)
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var similarNodes = nodes
            .Where(node => !seedIds.Contains(node.Id) && node.ExplicitLinkCount == 0)
            .OrderByDescending(node => node.SimilarityNeighborCount)
            .ThenByDescending(node => node.Importance)
            .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var positions = new Dictionary<Guid, RenderedGraphNode>();
        double seedOuterRadius;

        if (seeds.Length == 1)
        {
            positions[seeds[0].Id] = CreateRenderedNode(seeds[0], centerX, centerY, nodeWidth, nodeHeight);
            seedOuterRadius = Math.Max(nodeWidth, nodeHeight) / 2;
        }
        else
        {
            var seedPlacement = PlaceNodesOnShells(
                seeds,
                centerX,
                centerY,
                nodeWidth,
                nodeHeight,
                132,
                136,
                -Math.PI / 2,
                null,
                false);
            MergePositions(positions, seedPlacement.Positions);
            seedOuterRadius = seedPlacement.OuterRadius;
        }

        var explicitPlacement = PlaceNodesOnShells(
            explicitNodes,
            centerX,
            centerY,
            nodeWidth,
            nodeHeight,
            Math.Max(seedOuterRadius + 170, 218),
            152,
            -Math.PI / 2,
            BuildPreferredAngles(explicitNodes, edges, positions, centerX, centerY),
            false);
        MergePositions(positions, explicitPlacement.Positions);

        var anchorPositions = positions.ToDictionary(pair => pair.Key, pair => pair.Value);
        var similarPlacement = PlaceNodesOnShells(
            similarNodes,
            centerX,
            centerY,
            nodeWidth,
            nodeHeight,
            Math.Max(explicitPlacement.OuterRadius + 176, seedOuterRadius + 362),
            158,
            -Math.PI / 2,
            BuildPreferredAngles(similarNodes, edges, anchorPositions, centerX, centerY),
            false);
        MergePositions(positions, similarPlacement.Positions);

        return BuildCanvasFromPositions(positions, edges);
    }

    private GraphCanvasLayout BuildProjectFullLayout(IReadOnlyList<MemoryGraphNodeResult> nodes, IReadOnlyList<MemoryGraphEdgeResult> edges)
    {
        const double nodeWidth = 34;
        const double nodeHeight = 34;

        var groups = nodes
            .GroupBy(node => IsAllProjectsSelected ? node.ProjectId : node.Tags.FirstOrDefault() ?? node.ProjectId)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var positions = new Dictionary<Guid, RenderedGraphNode>();
        var clusterCount = Math.Max(groups.Length, 1);
        var radiusX = Math.Max(210d, 92d * Math.Sqrt(nodes.Count) + (clusterCount * 18d));
        var radiusY = Math.Max(170d, 74d * Math.Sqrt(nodes.Count) + (clusterCount * 14d));

        for (var groupIndex = 0; groupIndex < groups.Length; groupIndex++)
        {
            var group = groups[groupIndex];
            var ordered = group
                .OrderByDescending(node => node.ExplicitLinkCount + node.SimilarityNeighborCount)
                .ThenByDescending(node => node.Importance)
                .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            var angle = clusterCount == 1
                ? -Math.PI / 2
                : ((Math.PI * 2 * groupIndex) / clusterCount) - (Math.PI / 2);
            var clusterCenterX = Math.Cos(angle) * radiusX;
            var clusterCenterY = Math.Sin(angle) * radiusY;
            var localStartAngle = angle + Math.PI;
            var localRadius = ordered.Length switch
            {
                <= 1 => 0d,
                <= 4 => 64d,
                <= 8 => 86d,
                _ => 108d
            };

            var placement = PlaceNodesOnShells(
                ordered,
                clusterCenterX,
                clusterCenterY,
                nodeWidth,
                nodeHeight,
                localRadius,
                64,
                localStartAngle,
                BuildPreferredAngles(ordered, edges, positions, clusterCenterX, clusterCenterY),
                true);
            MergePositions(positions, placement.Positions);
        }

        return BuildCanvasFromPositions(positions, edges);
    }

    private GraphCanvasLayout BuildCanvasFromPositions(
        IReadOnlyDictionary<Guid, RenderedGraphNode> positions,
        IReadOnlyList<MemoryGraphEdgeResult> edges)
    {
        if (positions.Count == 0)
        {
            return new GraphCanvasLayout([], [], 1280, 720, "0 0 1280 720");
        }

        const double padding = 96;
        var rawNodes = positions.Values.ToArray();
        var minX = rawNodes.Min(node => node.X) - padding;
        var minY = rawNodes.Min(node => node.Y) - padding;
        var shiftX = minX < 0 ? -minX : 0;
        var shiftY = minY < 0 ? -minY : 0;
        var nodes = rawNodes
            .Select(node => node with
            {
                X = node.X + shiftX,
                Y = node.Y + shiftY
            })
            .ToArray();
        var nodeLookup = nodes.ToDictionary(node => node.Node.Id, node => node);
        var (minCanvasWidth, minCanvasHeight) = rawNodes.Length switch
        {
            <= 1 => (560d, 420d),
            <= 3 => (760d, 520d),
            _ => (880d, 600d)
        };
        var maxX = Math.Max(
            minCanvasWidth,
            nodes.Max(node => node.CenterX + BuildNodeRadius(node.Node) + EstimateNodeLabelWidth(node.Node)) + padding);
        var maxY = Math.Max(
            minCanvasHeight,
            nodes.Max(node => node.CenterY + BuildNodeRadius(node.Node)) + padding);
        var renderedEdges = edges
            .Where(edge => nodeLookup.ContainsKey(edge.FromId) && nodeLookup.ContainsKey(edge.ToId))
            .Select(edge => new RenderedGraphEdge(
                edge,
                nodeLookup[edge.FromId].CenterX,
                nodeLookup[edge.FromId].CenterY,
                nodeLookup[edge.ToId].CenterX,
                nodeLookup[edge.ToId].CenterY))
            .ToArray();

        return new GraphCanvasLayout(nodes, renderedEdges, maxX, maxY, $"0 0 {maxX} {maxY}");
    }

    private RenderedGraphNode CreateRenderedNode(MemoryGraphNodeResult node, double centerX, double centerY, double width, double height)
        => new(
            node,
            centerX - (width / 2),
            centerY - (height / 2),
            width,
            height,
            SeedNodeIds.Contains(node.Id),
            SelectedGraphNode?.Id == node.Id);

    private string BuildNodeVisualClass(RenderedGraphNode node)
    {
        var classes = new List<string> { "graph-view-node" };
        if (node.IsSelected)
        {
            classes.Add("selected");
        }

        if (node.IsSeed)
        {
            classes.Add("graph-node-seed");
        }

        if (IsHubNode(node.Node))
        {
            classes.Add("graph-node-hub");
        }
        else if (IsBridgeNode(node.Node))
        {
            classes.Add("graph-node-bridge");
        }

        if (SelectedGraphNode is { } selected && node.Node.Id != selected.Id)
        {
            if (IsDirectNeighbor(selected.Id, node.Node.Id))
            {
                classes.Add("graph-node-related");
            }
            else
            {
                classes.Add("graph-node-muted");
            }
        }

        return string.Join(" ", classes);
    }

    private string BuildNodeStyle(RenderedGraphNode node)
        => string.Create(
            CultureInfo.InvariantCulture,
            $"--node-weight:{NodeWeight(node.Node):0.###};--node-radius:{BuildNodeRadius(node.Node):0.#}px;--node-color:{BuildNodeColor(node.Node)};");

    private static string BuildNodeTransform(RenderedGraphNode node)
        => string.Create(CultureInfo.InvariantCulture, $"translate({node.CenterX:0.###} {node.CenterY:0.###})");

    private string BuildNodeTitleClass()
        => _viewShowLabels ? "graph-node-title" : "graph-node-title graph-node-title-hidden";

    private static string BuildNodeAccessibleLabel(MemoryGraphNodeResult node)
        => string.Create(
            CultureInfo.InvariantCulture,
            $"{node.Title}，{BuildNodeCategoryLabel(node)}，主要關聯 {node.ExplicitLinkCount}，相似關聯 {node.SimilarityNeighborCount}");

    private static double BuildNodeHitX(MemoryGraphNodeResult node)
        => -(BuildNodeRadius(node) + 5d);

    private static double BuildNodeHitY(MemoryGraphNodeResult node)
        => -(BuildNodeHitHeight(node) / 2d);

    private static double BuildNodeHitWidth(MemoryGraphNodeResult node)
        => (BuildNodeRadius(node) * 2d) + 10d;

    private static double BuildNodeHitHeight(MemoryGraphNodeResult node)
        => Math.Max((BuildNodeRadius(node) * 2d) + 12d, 30d);

    private static double EstimateNodeLabelWidth(MemoryGraphNodeResult node)
        => Math.Clamp(StringInfo.ParseCombiningCharacters(node.Title).Length * 6.2d, 52d, 230d);

    private static double BuildNodeRadius(MemoryGraphNodeResult node)
        => Math.Clamp(8.5 + (NodeDegree(node) * 0.45) + ((double)node.Importance * 1.2), 9, 13.5);

    private static string BuildNodeColor(MemoryGraphNodeResult node)
    {
        string[] palette =
        [
            "#2da44e",
            "#2563eb",
            "#7c3aed",
            "#db2777",
            "#0891b2",
            "#ca8a04",
            "#dc2626",
            "#475569"
        ];
        var key = string.IsNullOrWhiteSpace(node.ProjectId) ? node.MemoryType.ToString() : node.ProjectId;
        var hash = 0;
        foreach (var ch in key)
        {
            hash = unchecked((hash * 31) + ch);
        }

        return palette[(hash & int.MaxValue) % palette.Length];
    }

    private static string BuildNodeMeterStyle(int count, int total)
        => string.Create(CultureInfo.InvariantCulture, $"flex:{Math.Max(count, 0)} 0 {Math.Clamp(total == 0 ? 0 : count * 100d / total, 0, 100):0.##}%;");

    private static int NodeDegree(MemoryGraphNodeResult node)
        => node.ExplicitLinkCount + node.SimilarityNeighborCount;

    private static double NodeWeight(MemoryGraphNodeResult node)
        => Math.Clamp((double)node.Importance + (NodeDegree(node) * 0.16), 0.4, 1.8);

    private static bool IsHubNode(MemoryGraphNodeResult node)
        => NodeDegree(node) >= 4;

    private static bool IsBridgeNode(MemoryGraphNodeResult node)
        => node.ExplicitLinkCount > 0 && node.SimilarityNeighborCount > 0;

    private bool IsDirectNeighbor(Guid sourceId, Guid targetId)
        => (_graph?.Edges ?? []).Any(edge =>
            (edge.FromId == sourceId && edge.ToId == targetId) ||
            (edge.FromId == targetId && edge.ToId == sourceId));

    private string EdgeVisualClass(RenderedGraphEdge edge)
    {
        var classes = new List<string>
        {
            EdgeClass(edge.Edge.EdgeType)
        };

        if (SelectedGraphNode is { } selected)
        {
            if (edge.Edge.FromId == selected.Id || edge.Edge.ToId == selected.Id)
            {
                classes.Add("graph-edge-selected");
            }
            else
            {
                classes.Add("graph-edge-muted");
            }
        }

        return string.Join(" ", classes);
    }

    private static string BuildEdgeStyle(RenderedGraphEdge edge)
    {
        var baseWidth = string.Equals(edge.Edge.EdgeType, "explicit", StringComparison.OrdinalIgnoreCase)
            ? 1.25d
            : 1d;
        var scoreBoost = edge.Edge.Score.HasValue
            ? Math.Clamp((double)edge.Edge.Score.Value, 0, 1) * 0.85
            : 0;
        var width = Math.Clamp(baseWidth + scoreBoost, 1, 2.8);

        return string.Create(CultureInfo.InvariantCulture, $"--edge-width:{width:0.##};");
    }

    private static (double X, double Y) ResolveEllipsePoint(int index, int total, double centerX, double centerY, double radiusX, double radiusY)
    {
        if (total <= 1)
        {
            return (centerX, centerY);
        }

        var angle = (Math.PI * 2 * index / total) - (Math.PI / 2);
        return (
            centerX + (Math.Cos(angle) * radiusX),
            centerY + (Math.Sin(angle) * radiusY));
    }

    private ShellPlacementResult PlaceNodesOnShells(
        IReadOnlyList<MemoryGraphNodeResult> nodes,
        double centerX,
        double centerY,
        double nodeWidth,
        double nodeHeight,
        double startRadius,
        double ringGap,
        double angleOffset,
        IReadOnlyDictionary<Guid, double>? preferredAngles,
        bool placeFirstAtCenter)
    {
        var placed = new Dictionary<Guid, RenderedGraphNode>();
        var orderedNodes = nodes.ToArray();
        var index = 0;
        var outerRadius = 0d;

        if (placeFirstAtCenter && orderedNodes.Length > 0)
        {
            placed[orderedNodes[0].Id] = CreateRenderedNode(orderedNodes[0], centerX, centerY, nodeWidth, nodeHeight);
            outerRadius = Math.Max(nodeWidth, nodeHeight) / 2;
            index = 1;
        }

        var ringIndex = 0;
        while (index < orderedNodes.Length)
        {
            var radius = startRadius + (ringIndex * ringGap);
            var circumference = Math.Max(Math.PI * 2 * radius, nodeWidth + 64);
            var capacity = Math.Max(1, (int)Math.Floor(circumference / (nodeWidth + 70)));
            capacity = Math.Min(capacity, orderedNodes.Length - index);

            var ringNodes = orderedNodes
                .Skip(index)
                .Take(capacity)
                .OrderBy(node => preferredAngles?.GetValueOrDefault(node.Id, double.MaxValue) ?? double.MaxValue)
                .ThenByDescending(node => node.ExplicitLinkCount + node.SimilarityNeighborCount)
                .ThenByDescending(node => node.Importance)
                .ThenBy(node => node.Title, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            var baseAngle = preferredAngles is not null && ringNodes.Length > 0 && preferredAngles.TryGetValue(ringNodes[0].Id, out var preferredAngle)
                ? preferredAngle
                : angleOffset;

            for (var ringPosition = 0; ringPosition < ringNodes.Length; ringPosition++)
            {
                var angle = baseAngle + (Math.PI * 2 * ringPosition / ringNodes.Length);
                var x = centerX + (Math.Cos(angle) * radius);
                var y = centerY + (Math.Sin(angle) * radius);
                placed[ringNodes[ringPosition].Id] = CreateRenderedNode(ringNodes[ringPosition], x, y, nodeWidth, nodeHeight);
            }

            outerRadius = Math.Max(outerRadius, radius + (Math.Max(nodeWidth, nodeHeight) / 2));
            index += ringNodes.Length;
            ringIndex++;
        }

        return new ShellPlacementResult(placed, outerRadius);
    }

    private static void MergePositions(
        IDictionary<Guid, RenderedGraphNode> target,
        IReadOnlyDictionary<Guid, RenderedGraphNode> source)
    {
        foreach (var pair in source)
        {
            target[pair.Key] = pair.Value;
        }
    }

    private static IReadOnlyDictionary<Guid, double> BuildPreferredAngles(
        IReadOnlyList<MemoryGraphNodeResult> nodes,
        IReadOnlyList<MemoryGraphEdgeResult> edges,
        IReadOnlyDictionary<Guid, RenderedGraphNode> anchorPositions,
        double centerX,
        double centerY)
    {
        var angles = new Dictionary<Guid, double>();

        foreach (var node in nodes)
        {
            var connectedAnchors = edges
                .Where(edge => edge.FromId == node.Id || edge.ToId == node.Id)
                .Select(edge => edge.FromId == node.Id ? edge.ToId : edge.FromId)
                .Where(anchorPositions.ContainsKey)
                .Select(anchorId => anchorPositions[anchorId])
                .ToArray();

            if (connectedAnchors.Length == 0)
            {
                continue;
            }

            var meanX = connectedAnchors.Sum(anchor => Math.Cos(Math.Atan2(anchor.CenterY - centerY, anchor.CenterX - centerX)));
            var meanY = connectedAnchors.Sum(anchor => Math.Sin(Math.Atan2(anchor.CenterY - centerY, anchor.CenterX - centerX)));
            angles[node.Id] = Math.Atan2(meanY, meanX);
        }

        return angles;
    }

