@page "/project-work-items"
@implements IDisposable
@inject IContextHubApiClient ApiClient

<PageTitle>ContextHub | 專案待辦</PageTitle>

@{ var renderedAuthGeneration = _authGeneration; }

<PageViewport Title="專案待辦" Subtitle="每個專案各自管理工作與檢核清單；治理建議保留在治理工作區。" BodyClass="page-viewport-body project-work-items-page">
    <Actions><div class="page-actions-primary"><button class="primary-button" data-testid="work-items-compose" @onclick="@(() => InIdentity(renderedAuthGeneration, ToggleComposer))">建立代辦</button></div></Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-error">@_error</div> }
        @if (_creating)
        {
            <section class="panel project-work-item-compose">
                <div class="panel-heading-row"><div><div class="panel-title">建立專案代辦</div><div class="panel-heading-meta">標籤用逗號分隔，檢核清單每行一項。</div></div><button class="ghost-button" @onclick="@(() => InIdentity(renderedAuthGeneration, ToggleComposer))">取消</button></div>
                <div class="project-work-item-form"><label><span>所屬專案</span><select value="@_createProjectId" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => _createProjectId = InputText(args)))" aria-label="選擇建立代辦的專案">@foreach (var project in _projects) { <option value="@project.Information.ProjectId">@project.Information.DisplayName</option> }</select></label><label><span>定義成熟度</span><select value="@_createDefinitionState" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => ChangeCreateDefinition(args)))" aria-label="選擇定義成熟度">@foreach (var state in DefinitionStates) { <option value="@state">@DefinitionStateLabel(state)</option> }</select></label><label><span>標題</span><input data-testid="work-items-create-title" value="@_title" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => _title = InputText(args)))" aria-label="代辦標題" /></label><label><span>標籤</span><input value="@_tags" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => _tags = InputText(args)))" placeholder="發布, API" /></label><label class="wide"><span>內容</span><textarea value="@_description" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => _description = InputText(args)))"></textarea></label><label class="wide"><span>檢核清單</span><textarea value="@_checklist" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => _checklist = InputText(args)))" placeholder="完成 API 測試&#10;完成瀏覽器驗證"></textarea></label></div>
                <button class="primary-button" data-testid="work-items-create-submit" @onclick="@(() => InIdentityAsync(renderedAuthGeneration, CreateAsync))" disabled="@_loading">建立</button>
            </section>
        }
        <section class="project-work-items-workspace">
            <aside class="project-work-items-list-panel">
                <div class="panel-heading-row"><div><div class="panel-title">相關代辦</div><div class="panel-heading-meta">依專案、狀態或內容篩選，選擇後在右側處理。</div></div><button class="ghost-button" data-testid="work-items-refresh" @onclick="@(() => InIdentityAsync(renderedAuthGeneration, LoadAsync))" disabled="@_loading">重新整理</button></div>
                <div class="project-work-items-filter-toolbar" aria-label="代辦篩選"><input value="@_query" @oninput="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => ChangeQueryFilter(args)))" placeholder="搜尋標題、內容或 tag" aria-label="搜尋專案代辦" /><select data-testid="work-items-project" value="@_projectId" @onchange="@((ChangeEventArgs args) => InIdentityAsync(renderedAuthGeneration, () => ChangeProjectFilterAsync(args)))" aria-label="選擇代辦專案"><option value="">所有專案</option>@foreach (var project in _projects) { <option value="@project.Information.ProjectId">@project.Information.DisplayName</option> }</select><select value="@_statusFilter" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => ChangeStatusFilter(args)))" aria-label="篩選代辦狀態"><option value="">所有狀態</option>@foreach (var status in WorkItemStatuses) { <option value="@status">@StatusLabel(status)</option> }</select><select value="@_definitionStateFilter" @onchange="@((ChangeEventArgs args) => InIdentity(renderedAuthGeneration, () => ChangeDefinitionFilter(args)))" aria-label="篩選定義成熟度"><option value="">所有成熟度</option>@foreach (var state in DefinitionStates) { <option value="@state">@DefinitionStateLabel(state)</option> }</select><label><input type="checkbox" checked="@_includeArchived" @onchange="@((ChangeEventArgs args) => InIdentityAsync(renderedAuthGeneration, () => ChangeArchivedFilterAsync(args)))" /> 顯示已封存</label></div>
                <div class="project-work-items-list-column-labels" aria-hidden="true"><span>專案</span><span>工作內容</span><span>進度</span></div>
                <div class="project-work-items-list-scroll">
                    @if (FilteredItems.Count == 0) { <div class="empty-inline">此專案尚未建立符合條件的代辦。</div> }
                    @foreach (var item in FilteredItems)
                    {
                        var completedCount = item.ChecklistItems.Count(check => check.IsCompleted);
                        <button data-testid="@($"work-item-select-{item.Id:N}")" class="project-work-item-list-item @(_selectedId == item.Id ? "selected" : string.Empty)" @onclick="@(() => InIdentity(renderedAuthGeneration, () => Select(item.Id)))">
                            <span class="project-work-item-list-project"><code>@item.ProjectId</code><span class="project-work-item-list-tags">@string.Join(" · ", item.Tags.Take(2))</span></span>
                            <span class="project-work-item-list-summary"><strong>@item.Title</strong><span class="status-badge @StatusClass(item.Status)">@(item.IsArchived ? "已封存" : StatusLabel(item.Status))</span><span class="status-badge neutral">@DefinitionStateLabel(item.DefinitionState)</span></span>
                            <span class="project-work-item-list-progress"><strong>@completedCount/@item.ChecklistItems.Count</strong><span><ClientLocalTime Value="item.UpdatedAt" /></span></span>
                        </button>
                    }
                </div>
            </aside>
            <main class="project-work-item-detail-panel">
                @if (Selected is { } retained && !FilteredItems.Any(item => item.Id == retained.Id && ProjectContext.Matches(item.ProjectId, retained.ProjectId)))
                {
                    <p role="status" data-testid="work-item-retained-selection">目前選取未出現在本頁清單；這不代表已失去存取權。草稿與原請求仍保留，可重新讀取比較或選擇其他待辦。</p>
                }
                <WorkItemEditorPanel ProjectId="@(Selected?.ProjectId ?? string.Empty)"
                                     WorkItemId="@(Selected?.Id ?? Guid.Empty)"
                                     IdentityKey="@_subjectKey"
                                     Committed="OnCommitted" />
            </main>
        </section>
    </ChildContent>
</PageViewport>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private IReadOnlyList<ProjectInformationListItem> _projects = [];
    private IReadOnlyList<ProjectWorkItemResult> _items = [];
    private string _projectId = string.Empty, _createProjectId = string.Empty, _title = string.Empty, _description = string.Empty,
        _tags = string.Empty, _checklist = string.Empty, _query = string.Empty, _statusFilter = string.Empty,
        _definitionStateFilter = string.Empty, _subjectKey = string.Empty;
    private ProjectWorkItemDefinitionState _createDefinitionState = ProjectWorkItemDefinitionState.Draft;
    private Guid? _selectedId;
    private ProjectWorkItemResult? _selectedItem;
    private bool _creating, _loading, _includeArchived, _disposed;
    private string? _error;
    private long _generation, _authGeneration;
    private Task<AuthenticationState>? _observedAuthenticationState;
    private bool _observedAuthentication;
    private string? _loadedProjectFilter;
    private CancellationTokenSource? _read;
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<ProjectWorkItemResult> FilteredItems => _items
        .Where(item => string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(item.Status.ToString(), _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(_definitionStateFilter) || string.Equals(item.DefinitionState.ToString(), _definitionStateFilter, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(_query) || item.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) || item.Description.Contains(_query, StringComparison.OrdinalIgnoreCase) || item.Tags.Any(tag => tag.Contains(_query, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(item => item.UpdatedAt).ToArray();
    private IReadOnlyList<ProjectWorkItemStatus> WorkItemStatuses => _items.Select(item => item.Status).Distinct().OrderBy(status => status).ToArray();
    private static IReadOnlyList<ProjectWorkItemDefinitionState> DefinitionStates => Enum.GetValues<ProjectWorkItemDefinitionState>();
    private ProjectWorkItemResult? Selected => _selectedItem;
    private void SelectItem(ProjectWorkItemResult? item) { _selectedItem = item; _selectedId = item?.Id; }

    protected override async Task OnParametersSetAsync()
    {
        if (_observedAuthentication && ReferenceEquals(_observedAuthenticationState, AuthenticationState)) return;
        _observedAuthentication = true; _observedAuthenticationState = AuthenticationState;
        if (_subjectKey.Length > 0 && AuthenticationState?.IsCompletedSuccessfully == true &&
            WorkItemEditorIdentity.SubjectKey(AuthenticationState.Result.User) == _subjectKey) return;
        var generation = ++_authGeneration;
        _subjectKey = string.Empty; ++_generation; _read?.Cancel();
        _items = []; _projects = []; SelectItem(null); _error = null; _creating = false; _loadedProjectFilter = null;
        _title = _description = _tags = _checklist = _query = _projectId = _createProjectId = string.Empty;
        _statusFilter = _definitionStateFilter = string.Empty; _createDefinitionState = ProjectWorkItemDefinitionState.Draft; _includeArchived = false;
        AuthenticationState? state;
        try { state = AuthenticationState is null ? null : await AuthenticationState; }
        catch (Exception) { if (!_disposed && generation == _authGeneration) { _loading = false; _error = "無法確認目前身份，請重新登入。"; } return; }
        if (_disposed || generation != _authGeneration) return;
        var subject = WorkItemEditorIdentity.SubjectKey(state?.User);
        _subjectKey = subject;
        if (subject.Length == 0) { _loading = false; return; }
        _loading = true;
        try
        {
            var projects = await ApiClient.GetProjectInformationProjectsAsync(false, _lifetime.Token);
            if (_disposed || generation != _authGeneration || subject != _subjectKey) return;
            _projects = projects; _createProjectId = _projects.FirstOrDefault()?.Information.ProjectId ?? string.Empty;
            await LoadAsync();
        }
        catch (Exception) { if (!_disposed && generation == _authGeneration) { _error = "無法載入目前身份的專案清單。"; _loading = false; } }
    }

    private async Task LoadAsync()
    {
        if (_disposed || _subjectKey.Length == 0) return;
        _read?.Cancel(); _read?.Dispose(); var request = _read = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var generation = ++_generation; var subject = _subjectKey; var selected = Selected;
        var scopeChanged = !string.Equals(_loadedProjectFilter, _projectId, StringComparison.Ordinal);
        _loading = true; _error = null;
        // Clear when changing project scope, but a same-scope refresh must not discard
        // a selected draft or substitute its original read revision from a new list.
        if (scopeChanged) { _items = []; SelectItem(null); }
        _loadedProjectFilter = _projectId;
        try
        {
            var projectIds = (string.IsNullOrWhiteSpace(_projectId) ? _projects.Select(project => project.Information.ProjectId) : [_projectId]).ToArray();
            var resultSets = await Task.WhenAll(projectIds.Select(projectId => ApiClient.GetProjectWorkItemsAsync(
                new ProjectWorkItemListRequest(projectId, IncludeArchived: _includeArchived), request.Token)));
            if (!Current(generation, subject, request)) return;
            if (resultSets.Where((items, index) => items.Any(item => !ProjectContext.Matches(item.ProjectId, projectIds[index]))).Any())
                throw new InvalidDataException("Work item list response scope is inconsistent.");
            _items = resultSets.SelectMany(items => items).ToArray();
            if (!scopeChanged && selected is not null)
                SelectItem(_items.FirstOrDefault(item => item.Id == selected.Id && ProjectContext.Matches(item.ProjectId, selected.ProjectId)) ?? selected);
            else SelectItem(FilteredItems.FirstOrDefault());
        }
        catch (Exception) { if (Current(generation, subject, request)) _error = "無法載入目前範圍的待辦，請重新讀取。"; }
        finally { if (Current(generation, subject, request)) _loading = false; }
    }
    private bool Current(long generation, string subject, CancellationTokenSource request)
        => !_disposed && generation == _generation && subject == _subjectKey && ReferenceEquals(_read, request);
    private void Select(Guid id) => SelectItem(FilteredItems.FirstOrDefault(item => item.Id == id));
    private void ApplyFilters()
    {
        if (_selectedId is not Guid id || !FilteredItems.Any(item => item.Id == id)) SelectItem(FilteredItems.FirstOrDefault());
    }
    private void OnCommitted(ProjectWorkItemResult result)
    {
        if (_disposed || Selected is not { } selected || selected.Id != result.Id || !ProjectContext.Matches(selected.ProjectId, result.ProjectId)) return;
        SelectItem(KeepNewer(selected, result));
        _items = _items.Select(item => item.Id == result.Id && ProjectContext.Matches(item.ProjectId, result.ProjectId) ? KeepNewer(item, result) : item).ToArray();
    }
    private static ProjectWorkItemResult KeepNewer(ProjectWorkItemResult current, ProjectWorkItemResult receipt)
        => current.Revision is > 0 && receipt.Revision is > 0 && current.Revision.Value > receipt.Revision.Value ? current : receipt;
    private static string InputText(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;
    private void ChangeCreateDefinition(ChangeEventArgs args)
    {
        if (Enum.TryParse<ProjectWorkItemDefinitionState>(InputText(args), out var state) && Enum.IsDefined(state)) _createDefinitionState = state;
    }
    private Task ChangeProjectFilterAsync(ChangeEventArgs args) { _projectId = InputText(args); return LoadAsync(); }
    private Task ChangeArchivedFilterAsync(ChangeEventArgs args) { _includeArchived = args.Value is bool value && value; return LoadAsync(); }
    private void ChangeQueryFilter(ChangeEventArgs args) { _query = InputText(args); ApplyFilters(); }
    private void ChangeStatusFilter(ChangeEventArgs args) { _statusFilter = InputText(args); ApplyFilters(); }
    private void ChangeDefinitionFilter(ChangeEventArgs args) { _definitionStateFilter = InputText(args); ApplyFilters(); }
    private void InIdentity(long renderedGeneration, Action action)
    {
        if (!_disposed && _subjectKey.Length > 0 && renderedGeneration == _authGeneration) action();
    }
    private Task InIdentityAsync(long renderedGeneration, Func<Task> action)
        => !_disposed && _subjectKey.Length > 0 && renderedGeneration == _authGeneration ? action() : Task.CompletedTask;
    private void ToggleComposer() => _creating = !_creating;
    private async Task CreateAsync()
    {
        if (_disposed || _subjectKey.Length == 0 || _loading) return;
        if (string.IsNullOrWhiteSpace(_createProjectId)) { _error = "請先選擇建立代辦的專案。"; return; }
        var subject = _subjectKey; var generation = _authGeneration; var project = _createProjectId;
        _loading = true; _error = null;
        try
        {
            await ApiClient.CreateProjectWorkItemAsync(new(project, _title, _description, Split(_tags), Split(_checklist), DefinitionState: _createDefinitionState), _lifetime.Token);
            if (_disposed || generation != _authGeneration || subject != _subjectKey) return;
            _title = _description = _tags = _checklist = string.Empty; _createDefinitionState = ProjectWorkItemDefinitionState.Draft; _creating = false;
            await LoadAsync();
        }
        catch (Exception) { if (!_disposed && generation == _authGeneration) _error = "建立結果未確認；請先核對清單，避免重複建立。"; }
        finally { if (!_disposed && generation == _authGeneration && subject == _subjectKey) _loading = false; }
    }
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true; ++_generation; ++_authGeneration; _read?.Cancel(); _read?.Dispose(); _lifetime.Cancel(); _lifetime.Dispose();
        _items = []; _projects = []; SelectItem(null); _subjectKey = string.Empty; _title = _description = _tags = _checklist = string.Empty;
    }
    private static string[] Split(string value) => value.Split([',', '\n', '\r'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    private static string StatusLabel(ProjectWorkItemStatus status) => status switch { ProjectWorkItemStatus.Pending => "待處理", ProjectWorkItemStatus.InProgress => "進行中", ProjectWorkItemStatus.Blocked => "已阻塞", ProjectWorkItemStatus.Completed => "已完成", ProjectWorkItemStatus.Cancelled => "已取消", _ => status.ToString() };
    private static string StatusClass(ProjectWorkItemStatus status) => status switch { ProjectWorkItemStatus.Completed => "ok", ProjectWorkItemStatus.Blocked => "bad", ProjectWorkItemStatus.Cancelled => "neutral", _ => "warn" };
    private static string DefinitionStateLabel(ProjectWorkItemDefinitionState state) => state switch { ProjectWorkItemDefinitionState.Discussing => "討論中", ProjectWorkItemDefinitionState.Draft => "草稿", ProjectWorkItemDefinitionState.ReadyForDevelopment => "可進入開發", ProjectWorkItemDefinitionState.Frozen => "已凍結", ProjectWorkItemDefinitionState.Superseded => "已取代", _ => state.ToString() };
}
