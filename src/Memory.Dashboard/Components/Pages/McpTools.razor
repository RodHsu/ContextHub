        new("log_search / log_read / promote_log_slice_to_memory", "查詢 runtime logs，或將已驗證的 log slice 升級為 durable memory。", "混合", "warn", "promotion 屬寫入，應避免保存大型原始 log。"),
        new("user_preference_list / user_preference_upsert / user_preference_archive", "管理長期使用者偏好。", "混合", "warn", "只保存明確、可重用且已確認的偏好。"),
        new("project_artifact_*", "發佈、上傳、搜尋、讀取或清理 project-scoped artifact exchange records。", "混合", "warn", "大型內容應走 managed object pointer，不直接塞進 memory。"),
        new("enqueue_reindex / enqueue_summary_refresh", "排入向量重建或共用綜合層刷新工作。", "維運", "warn", "模型、維度、profile 或 summary 資料需要重建時使用。"),
        new("maintenance_status / maintenance_lease_*", "檢查維護狀態並讓 agent 宣告工作 lease。", "維運", "neutral", "排程維護前後用於降低衝突。"),
        new("chatgpt_proposals_list / chatgpt_proposal_approve / chatgpt_proposal_reject", "檢視、核准或拒絕 ChatGPT gateway 建立的寫入 proposal。", "審核寫入", "warn", "核准時會重新檢查 scope 與權限。")
    ];

    private static readonly IReadOnlyList<ToolDoc> ChatGatewayTools =
    [
        new("projects_list", "列出目前 OAuth actor 可讀取的 ProjectId。", "讀取", "neutral", "不回傳 default，降低誤用預設專案的機率。"),
        new("daily_memory_review", "回傳每日遠端記憶治理檢查摘要。", "讀取", "neutral", "server-side scoping，不改記憶、偏好或 action。"),
