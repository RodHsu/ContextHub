        new("共用知識", "在授權範圍內彙整可跨專案重用的知識，避免把相同背景與決策重複保存。", "記憶資料、工作上下文", "memory_search, memory_get, enqueue_summary_refresh", "已提供", "ok", "仍受 ProjectId、includedProjectIds 與 actor 授權限制；不是所有專案都自動共享。"),
        new("使用者偏好", "保存已明確確認、可長期沿用的使用者協作習慣與回覆偏好。", "使用者偏好", "user_preference_list, user_preference_upsert, user_preference_archive", "已提供", "ok", "Chat gateway 的偏好寫入會先建立 proposal，核准後才套用。"),
        new("跨專案討論", "以主專案為議題中心，讓參與專案在獨立討論串內溝通，不混入知識或記憶。", "跨專案討論工作台", "discussion_threads_list, discussion_thread_get, discussion_thread_create, discussion_thread_close, discussion_message_create", "已提供", "ok", "清單預設顯示 actor 可參與的所有討論；hostProjectId 表示主要討論對象，participants 決定可見範圍，只有主責專案可關閉。"),
        new("專案待辦事項", "顯示目前專案由治理分析與評測產生的待辦，並可接受、執行或忽略。", "專案待辦", "suggested_actions_list, suggested_action_accept, suggested_action_dismiss", "已提供", "ok", "目前是系統產生的待辦，不支援手動建立、指派或跨專案同步；完整人工待辦將另行擴充。")
    ];

    private static readonly IReadOnlyList<EndpointDoc> Endpoints =
    [
        new("/mcp", "可信 coding agent / 內部自動化", "完整工具面", "warn", "提供讀取、寫入、搬移、封存、刪除、維運 lease、reindex、summary refresh、artifact exchange、log promotion 與 proposal 審核工具。"),
        new("/mcp-chat", "ChatGPT / custom assistant", "受控 gateway", "neutral", "透過 OAuth/OIDC 驗證 actor，依 Project 授權限制讀取範圍；durable memory 寫入以 pending proposal 為主，但討論串與專案階層可在授權範圍內直接協作。"),
        new("/api/*", "Dashboard / 維運腳本", "REST", "ok", "提供 Dashboard 狀態、記憶查詢、治理、整理、維運、security、jobs、storage 與 performance probe 等 HTTP API。")
    ];

    private static readonly IReadOnlyList<ToolDoc> DirectTools =
    [
        new("describe_context_hub", "說明 ContextHub 的用途、啟動流程與 ProjectId 使用方式。", "讀取", "neutral", "適合 agent 第一次連線時使用。"),
        new("build_working_context", "依 task query 組合專案 working context、相關記憶與最近訊號。", "讀取", "neutral", "新任務、切換 repo、恢復壓縮後都應先呼叫。"),
        new("memory_search / memory_get", "搜尋或讀取既有 facts、decisions、artifacts、episodes。", "讀取", "neutral", "支援 explicit ProjectId、includedProjectIds、summary layer 與 archived filter。"),
        new("memory_upsert / memory_update", "建立、替換或修正 durable memory。", "直接寫入", "warn", "只寫穩定可重用的結論、規則、部署結果或決策。"),
        new("memory_archive / memory_restore", "封存或還原單筆記憶。", "直接寫入", "warn", "適合保留審計軌跡但不再預設檢索的資料。"),
