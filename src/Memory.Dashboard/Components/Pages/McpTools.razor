    private sealed record EndpointDoc(string Path, string Audience, string Badge, string BadgeClass, string Description);

    private sealed record CapabilityDoc(string Name, string Description, string Ui, string Api, string Badge, string BadgeClass, string Note);

    private sealed record ToolDoc(string Name, string Description, string Risk, string RiskClass, string Note);

    private sealed record ApiDoc(string Group, string Paths, string Description);
}
