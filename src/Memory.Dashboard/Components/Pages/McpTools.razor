        new("project_cleanup_preview", "預覽 ProjectId 底下可安全整理的 migrated tombstone、removed marker、archived 或低價值殘留。", "讀取", "neutral", "bulk cleanup 前置步驟。"),
        new("project_cleanup_apply", "對 preview 後選定的安全候選執行封存或刪除；不安全 active memory 會略過。", "直接寫入", "warn", "適合完成 ProjectId 清理收尾。"),
        new("conversation_ingest", "寫入對話 checkpoint 到 staging layer，供後續自動 promotion 或人工整理。", "直接寫入", "warn", "收尾、交接或壓縮前使用。"),
        new("conversation_sessions_list / conversation_insights_list", "檢視對話 staging session、insight 與 promotion 狀態。", "讀取", "neutral", "用於每日整理與稽核。"),
        new("project_hierarchy_get_children / project_hierarchy_set_children", "讀取或設定父專案管理的子專案清單。", "混合", "warn", "僅是組織 metadata，不會授權存取、複製記憶或自動加入討論。"),
        new("discussion_threads_list / discussion_thread_get", "列出或讀取 actor 授權範圍內可參與的跨專案討論；讀取不會直接改變已讀狀態。", "讀取", "neutral", "未指定 ProjectId 時可取得所有可參與討論；討論以 hostProjectId 為主要議題，只有 participant ProjectId 能存取。"),
