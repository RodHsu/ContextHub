@page "/monitoring"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor

<PageTitle>Context Hub | 狀態監控</PageTitle>

<PageViewport Title="狀態監控"
              Subtitle="集中檢視服務、資料庫與資源壓力變化。"
              BodyClass="page-viewport-body monitoring-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           SnapshotAtUtc="PageSnapshotAtUtc()"
                           IsRefreshing="_loading"
                           PollingIntervalSeconds="@PollingIntervalSeconds"
                           WarningText="@SnapshotWarningText()" />
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="RefreshAsync" disabled="@_loading">刷新</button>
        </div>
    </Actions>
    <ChildContent>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="inline-error">@_loadError</div>
    }

    @if (_monitoring is null)
    {
        <div class="dashboard-grid page-scroll-host">
            @for (var i = 0; i < 4; i++)
            {
                <section class="panel skeleton-panel @(i == 2 ? "span-2" : string.Empty)">
                    <div class="skeleton-line skeleton-line-md"></div>
                    <div class="skeleton-stack">
                        <div class="skeleton-line skeleton-line-lg"></div>
                        <div class="skeleton-line skeleton-line-md"></div>
                        <div class="skeleton-line skeleton-line-sm"></div>
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="monitoring-page-stack page-scroll-host monitoring-workspace-section">
            <div class="monitoring-top-grid">
                <section class="panel">
                    <div class="panel-title">核心狀態</div>
                    <div class="badge-strip monitoring-service-strip">
                        @foreach (var service in _monitoring.Services)
                        {
                            <span class="status-badge @StatusClass(service.Status)">@ServiceDisplayName(service.Name): @StatusText(service.Status)</span>
                        }
                    </div>

                    <dl class="definition-grid">
                        <div>
                            <dt>命名空間 (Namespace)</dt>
                            <dd>@_monitoring.Namespace</dd>
                        </div>
                        <div>
                            <dt>建置版本 (Build Version)</dt>
                            <dd>@_monitoring.BuildVersion</dd>
                        </div>
                        <div>
                            <dt>建置時間 (Build Time)</dt>
                            <dd><ClientLocalTime Value="_monitoring.BuildTimestampUtc" /></dd>
                        </div>
                        <div>
                            <dt>服務數量</dt>
                            <dd>@DashboardFormatting.Integer(_monitoring.Services.Count)</dd>
                        </div>
                    </dl>
                </section>

                <section class="panel">
                    <div class="panel-title">Docker 主機 (Docker Host)</div>
                    <div class="runtime-host-grid">
                        <article class="host-stat runtime-host-card">
                            <span>Host</span>
                            <strong>@(_monitoring.DockerHost?.Host.HostName ?? "unavailable")</strong>
                            <div class="stack-item-meta">@(_monitoring.DockerHost?.Host.ServerVersion ?? "unavailable")</div>
                        </article>
                        <article class="host-stat runtime-host-card">
                            <span>CPU</span>
                            <strong>@DashboardFormatting.Integer(_monitoring.DockerHost?.Host.CpuCount ?? 0) cores</strong>
                            <div class="stack-item-meta">@StatusText(_monitoring.DockerHost?.Status ?? "unavailable")</div>
                        </article>
                        <article class="host-stat runtime-host-card">
                            <span>Total Memory</span>
                            <strong>@DashboardFormatting.Bytes(_monitoring.DockerHost?.Host.TotalMemoryBytes ?? 0)</strong>
                            <div class="stack-item-meta">可用 @DashboardFormatting.Bytes(_monitoring.DockerHost?.Host.EstimatedAvailableMemoryBytes ?? 0)</div>
                        </article>
                        <article class="host-stat runtime-host-card">
                            <span>Compose Footprint</span>
                            <strong>@DashboardFormatting.Integer(_monitoring.DockerHost?.Host.ActiveContainerCount ?? 0) containers</strong>
                            <div class="stack-item-meta">@DashboardFormatting.Integer(_monitoring.DockerHost?.Host.VolumeCount ?? 0) volumes / @DashboardFormatting.Integer(_monitoring.DockerHost?.Host.ImageCount ?? 0) images</div>
                        </article>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_monitoring.DockerHost?.Error))
                    {
                        <div class="inline-error runtime-host-error">@_monitoring.DockerHost.Error</div>
                    }
                </section>
            </div>

            <section class="panel">
                <div class="panel-heading-row">
                    <div class="panel-title">資源趨勢</div>
                    <div class="panel-heading-meta resource-chart-panel-meta">@ResourceChartPanelNote()</div>
                </div>
                <div class="resource-chart-grid">
                    <article class="resource-chart-card">
                        <div class="resource-chart-header">
                            <div>
                                <div class="resource-chart-title">CPU 使用率 (CPU Usage)</div>
                                <div class="resource-chart-value">@DashboardFormatting.Percent(CurrentCpuPercent())</div>
                                <div class="resource-chart-summary">近期平均 @DashboardFormatting.Percent(AverageCpuPercent())</div>
                            </div>
                        </div>
                        <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="CPU usage trend">
                            @foreach (var guide in ChartGuideLines())
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line cpu" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => x.CpuPercent) ?? [], MaxCpuPercent())"></polyline>
                        </svg>
                        <div class="resource-chart-meta">Compose service 群組原始 CPU 聚合值</div>
                    </article>

                    <article class="resource-chart-card">
                        <div class="resource-chart-header">
                            <div>
                                <div class="resource-chart-title">記憶體使用量 (Memory Usage)</div>
                                <div class="resource-chart-value">@DashboardFormatting.Bytes(CurrentMemoryUsageBytes())</div>
                                <div class="resource-chart-summary">近期平均 @DashboardFormatting.Bytes(AverageMemoryUsageBytes())</div>
                            </div>
                        </div>
                        <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Memory usage trend">
                            @foreach (var guide in ChartGuideLines())
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line memory" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => (double)x.MemoryUsageBytes) ?? [], MaxMemoryUsageChartValue())"></polyline>
                        </svg>
                        <div class="resource-chart-meta">占主機 @DashboardFormatting.Percent(CurrentMemoryPercent())</div>
                    </article>

                    <article class="resource-chart-card">
                        <div class="resource-chart-header">
                            <div>
                                <div class="resource-chart-title">網路吞吐量 (Network Throughput)</div>
                                <div class="resource-chart-stats">
                                    <div class="resource-inline-stat">
                                        <span>接收 (RX)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatRate(CurrentNetworkRxBytesPerSecond())</strong>
                                            <small>平均 @FormatRate(AverageNetworkRxBytesPerSecond())</small>
                                        </div>
                                    </div>
                                    <div class="resource-inline-stat">
                                        <span>傳送 (TX)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatRate(CurrentNetworkTxBytesPerSecond())</strong>
                                            <small>平均 @FormatRate(AverageNetworkTxBytesPerSecond())</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Network throughput trend">
                            @foreach (var guide in ChartGuideLines())
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line rx" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => x.NetworkRxBytesPerSecond) ?? [], MaxNetworkRate())"></polyline>
                            <polyline class="resource-line tx" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => x.NetworkTxBytesPerSecond) ?? [], MaxNetworkRate())"></polyline>
                        </svg>
                        <div class="resource-chart-legend">
                            <span class="resource-legend-item"><i class="legend-swatch rx"></i>接收 (RX)</span>
                            <span class="resource-legend-item"><i class="legend-swatch tx"></i>傳送 (TX)</span>
                        </div>
                    </article>

                    <article class="resource-chart-card">
                        <div class="resource-chart-header">
                            <div>
                                <div class="resource-chart-title">磁碟吞吐量 (Disk Throughput)</div>
                                <div class="resource-chart-stats">
                                    <div class="resource-inline-stat">
                                        <span>讀取 (Read)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatRate(CurrentDiskReadBytesPerSecond())</strong>
                                            <small>平均 @FormatRate(AverageDiskReadBytesPerSecond())</small>
                                        </div>
                                    </div>
                                    <div class="resource-inline-stat">
                                        <span>寫入 (Write)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatRate(CurrentDiskWriteBytesPerSecond())</strong>
                                            <small>平均 @FormatRate(AverageDiskWriteBytesPerSecond())</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Disk throughput trend">
                            @foreach (var guide in ChartGuideLines())
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line read" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => x.DiskReadBytesPerSecond) ?? [], MaxDiskRate())"></polyline>
                            <polyline class="resource-line write" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => x.DiskWriteBytesPerSecond) ?? [], MaxDiskRate())"></polyline>
                        </svg>
                        <div class="resource-chart-legend">
                            <span class="resource-legend-item"><i class="legend-swatch read"></i>讀取 (Read)</span>
                            <span class="resource-legend-item"><i class="legend-swatch write"></i>寫入 (Write)</span>
                        </div>
                    </article>

                    <article class="resource-chart-card">
                        <div class="resource-chart-header">
                            <div>
                                <div class="resource-chart-title">近期呼叫趨勢 (Recent Request Traffic)</div>
                                <div class="resource-chart-stats">
                                    <div class="resource-inline-stat">
                                        <span>進站 (Inbound)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatCountRate(CurrentInboundRequestsPerSecond())</strong>
                                            <small>平均 @FormatCountRate(AverageInboundRequestsPerSecond())</small>
                                        </div>
                                    </div>
                                    <div class="resource-inline-stat">
                                        <span>傳出 (Outbound)</span>
                                        <div class="resource-inline-stat-value">
                                            <strong>@FormatCountRate(CurrentOutboundRequestsPerSecond())</strong>
                                            <small>平均 @FormatCountRate(AverageOutboundRequestsPerSecond())</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <svg class="resource-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Recent request traffic trend">
                            @foreach (var guide in ChartGuideLines())
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line inbound" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => (double)x.InboundRequests) ?? [], MaxRequestTrafficRate())"></polyline>
                            <polyline class="resource-line outbound" points="@BuildLinePoints(_monitoring.ResourceSamples?.Select(x => (double)x.OutboundRequests) ?? [], MaxRequestTrafficRate())"></polyline>
                        </svg>
                        <div class="resource-chart-legend">
                            <span class="resource-legend-item"><i class="legend-swatch inbound"></i>進站 (Inbound)</span>
                            <span class="resource-legend-item"><i class="legend-swatch outbound"></i>傳出 (Outbound)</span>
                        </div>
                    </article>
                </div>
            </section>

            @if ((_monitoring.ContextSavings ?? CreateEmptyContextSavings(_monitoring.SnapshotAtUtc)) is { } contextSavings)
            {
                <section class="panel monitoring-context-savings-panel">
                <div class="monitoring-telemetry-header">
                    <div>
                        <div class="panel-title">脈絡節省量</div>
                        <div class="settings-section-meta">@ContextSavingsStateText(contextSavings) / @ContextSavingsWindowText(contextSavings)</div>
                    </div>
                    <span class="status-badge @ContextSavingsConfidenceClass(contextSavings.Confidence)">可信度 @ContextSavingsConfidenceText(contextSavings.Confidence)</span>
                </div>
                <div class="monitoring-context-savings-grid">
                    @foreach (var window in ContextSavingsWindows(contextSavings))
                    {
                        <article class="monitoring-context-savings-window">
                            <span>@window.Label 節省率</span>
                            <strong>@DashboardFormatting.Percent(window.SavingPercent)</strong>
                            <small>
                                <span>@FormatTokenCount(window.EstimatedSavedTokens)</span>
                                <span>@DashboardFormatting.Integer(window.SampleCount) 筆樣本</span>
                            </small>
                        </article>
                    }
                    <article>
                        <span>24H 樣本</span>
                        <strong>@DashboardFormatting.Integer(contextSavings.SampleCount)</strong>
                        <small>@ContextSavingsLastSampleText(contextSavings)</small>
                    </article>
                    <article>
                        <span>快取命中率</span>
                        <strong>@DashboardFormatting.Percent(contextSavings.CacheHitPercent)</strong>
                        <small>@DashboardFormatting.Integer(contextSavings.Trend.Count) 個趨勢點</small>
                    </article>
                    <article>
                        <span>來源覆蓋率</span>
                        <strong>@DashboardFormatting.Percent(contextSavings.SourceCoveragePercent)</strong>
                        <small>@DashboardFormatting.Integer(contextSavings.ReturnedTokenEstimate) returned tokens</small>
                    </article>
                    <div class="monitoring-context-savings-trend">
                        <svg class="resource-line-chart context-savings-line-chart" viewBox="0 0 240 96" preserveAspectRatio="none" role="img" aria-label="Monitoring context saving percent trend">
                            @foreach (var guide in new[] { 14, 28, 42 })
                            {
                                <line class="resource-line-guide" x1="0" y1="@guide" x2="240" y2="@guide"></line>
                            }
                            <polyline class="resource-line savings" points="@BuildLinePoints(contextSavings.Trend.Select(x => x.SavingPercent), 100d)"></polyline>
                        </svg>
                    </div>
                </div>
                </section>
            }

            <div class="monitoring-telemetry-grid">
                <section class="panel monitoring-telemetry-panel">
                    <div class="monitoring-telemetry-header">
                        <div>
                            <div class="panel-title">Redis</div>
                            <div class="settings-section-meta">快取命中率、命中量、鍵數、命令處理量、進出流量與容器 I/O。</div>
                        </div>
                        <span class="status-badge @StatusClass(_monitoring.Redis.Status)">@StatusText(_monitoring.Redis.Status)</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_monitoring.Redis.Warning))
                    {
                        <div class="inline-error monitoring-inline-warning">@_monitoring.Redis.Warning</div>
                    }

                    <div class="runtime-dependency-kpi-grid">
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">已用記憶體 <InfoPopover Label="顯示已用記憶體說明" Icon="i" Title="已用記憶體" Text="Redis 目前配置並使用中的記憶體量。若接近 Max Memory，可能會觸發 eviction 或造成寫入壓力。" /></span>
                            <strong>@DashboardFormatting.Bytes(_monitoring.Redis.UsedMemoryBytes)</strong>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">Redis 命中率 <InfoPopover Label="顯示 Redis 命中率說明" Icon="i" Title="Redis 命中率" Text="Redis server keyspace hits / (hits + misses)。這是 Redis 端實際 key lookup 的命中率，可用來判斷 Redis 內部快取是否有效服務讀取。" /></span>
                            <strong>@DashboardFormatting.Percent(_monitoring.Redis.KeyspaceHitPercent)</strong>
                            <small>@DashboardFormatting.Integer(_monitoring.Redis.KeyspaceLookups) lookups</small>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">應用快取命中率 <InfoPopover Label="顯示應用快取命中率說明" Icon="i" Title="應用快取命中率" Text="ContextHub 透過 IRedisObjectCache 記錄的 hits / (hits + misses)。這是應用層快取使用成效，和 Redis server keyspace hit rate 互補。" /></span>
                            <strong>@DashboardFormatting.Percent(_monitoring.Redis.CacheHitPercent)</strong>
                            <small>@DashboardFormatting.Integer(_monitoring.Redis.CacheLookups) lookups</small>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">鍵數 <InfoPopover Label="顯示鍵數說明" Icon="i" Title="鍵數" Text="目前 Redis 內可見 key 的數量。突然暴增通常代表 cache key 維度過寬、TTL 不合理，或背景工作產生過多暫存資料。" /></span>
                            <strong>@DashboardFormatting.Integer(_monitoring.Redis.KeyCount)</strong>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">儲存量 <InfoPopover Label="顯示儲存量說明" Icon="i" Title="儲存量" Text="Redis Docker volume 的粗略儲存占用。若 Redis 使用 AOF/RDB 持久化，這裡可用來觀察 volume 成長。" /></span>
                            <strong>@DashboardFormatting.Bytes(_monitoring.Redis.PersistentStorageBytes)</strong>
                        </article>
                    </div>

                    <dl class="definition-grid monitoring-definition-grid">
                        <div><dt class="metric-label-with-info">記憶體上限 <InfoPopover Label="顯示記憶體上限說明" Icon="i" Title="記憶體上限" Text="Redis maxmemory 設定或容器偵測到的上限。已用記憶體接近此值時，需觀察 eviction 與命中率。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Redis.MaxMemoryBytes)</dd></div>
                        <div><dt class="metric-label-with-info">命令總量 <InfoPopover Label="顯示命令總量說明" Icon="i" Title="命令總量" Text="Redis 啟動後處理過的命令累積數。可用來對照流量尖峰、快取活動與應用重試。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.TotalCommandsProcessed)</dd></div>
                        <div><dt class="metric-label-with-info">累積進站流量 <InfoPopover Label="顯示累積進站流量說明" Icon="i" Title="累積進站流量" Text="Redis container 累積 RX。突然升高時，可對照 cache rebuild、批次查詢或背景工作。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Redis.TotalNetInputBytes)</dd></div>
                        <div><dt class="metric-label-with-info">累積傳出流量 <InfoPopover Label="顯示累積傳出流量說明" Icon="i" Title="累積傳出流量" Text="Redis container 累積 TX。高傳出量通常代表快取命中後大量回傳資料。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Redis.TotalNetOutputBytes)</dd></div>
                        <div><dt class="metric-label-with-info">即時進站 <InfoPopover Label="顯示即時進站說明" Icon="i" Title="即時進站" Text="Redis 目前每秒輸入速率。用來觀察短時間寫入或查詢流量變化。" /></dt><dd>@($"{DashboardFormatting.Decimal(_monitoring.Redis.InstantaneousInputKbps)} KB/s")</dd></div>
                        <div><dt class="metric-label-with-info">即時傳出 <InfoPopover Label="顯示即時傳出說明" Icon="i" Title="即時傳出" Text="Redis 目前每秒輸出速率。若長時間高於平常值，需對照應用快取讀取量。" /></dt><dd>@($"{DashboardFormatting.Decimal(_monitoring.Redis.InstantaneousOutputKbps)} KB/s")</dd></div>
                        <div><dt class="metric-label-with-info">Redis 命中 / 未命中 <InfoPopover Label="顯示 Redis 命中未命中說明" Icon="i" Title="Redis 命中 / 未命中" Text="Redis keyspace hits 與 misses 累積值，是 Redis 命中率的分子與分母來源。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.KeyspaceHits) / @DashboardFormatting.Integer(_monitoring.Redis.KeyspaceMisses)</dd></div>
                        <div><dt class="metric-label-with-info">應用快取命中 / 未命中 <InfoPopover Label="顯示應用快取命中未命中說明" Icon="i" Title="應用快取命中 / 未命中" Text="ContextHub 應用層快取 hits 與 misses。可用來判斷程式是否真的走快取路徑。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.CacheHits) / @DashboardFormatting.Integer(_monitoring.Redis.CacheMisses)</dd></div>
                        <div><dt class="metric-label-with-info">應用快取寫入 <InfoPopover Label="顯示應用快取寫入說明" Icon="i" Title="應用快取寫入" Text="應用層成功寫入快取的次數。若持續增加但命中率低，可能 key 設計或 TTL 需要調整。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.CacheSets)</dd></div>
                        <div><dt class="metric-label-with-info">快取略過 / 錯誤 <InfoPopover Label="顯示快取略過錯誤說明" Icon="i" Title="快取略過 / 錯誤" Text="略過快取與快取錯誤累積值。錯誤增加時，需檢查 Redis 連線、序列化或 timeout。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.CacheBypasses) / @DashboardFormatting.Integer(_monitoring.Redis.CacheErrors)</dd></div>
                        <div><dt class="metric-label-with-info">過期鍵 <InfoPopover Label="顯示過期鍵說明" Icon="i" Title="過期鍵" Text="因 TTL 到期而被 Redis 移除的 key 數。可用來判斷快取生命週期是否正常運作。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.ExpiredKeys)</dd></div>
                        <div><dt class="metric-label-with-info">淘汰鍵 <InfoPopover Label="顯示淘汰鍵說明" Icon="i" Title="淘汰鍵" Text="因記憶體壓力被 Redis eviction policy 淘汰的 key 數。正常情況應低且穩定；增加代表記憶體或 TTL 壓力。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Redis.EvictedKeys)</dd></div>
                        <div><dt class="metric-label-with-info">容器網路 <InfoPopover Label="顯示容器網路說明" Icon="i" Title="容器網路" Text="Redis container 層級累積 RX / TX，用來確認服務間傳輸量是否異常。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Redis.NetworkRxBytes) RX / @DashboardFormatting.Bytes(_monitoring.Redis.NetworkTxBytes) TX</dd></div>
                        <div><dt class="metric-label-with-info">容器磁碟 I/O <InfoPopover Label="顯示容器磁碟 I/O 說明" Icon="i" Title="容器磁碟 I/O" Text="Redis container 層級累積讀寫量。若持久化開啟，高寫入可能與 AOF/RDB 或資料重建有關。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Redis.DiskReadBytes) Read / @DashboardFormatting.Bytes(_monitoring.Redis.DiskWriteBytes) Write</dd></div>
                        <div class="monitoring-definition-span"><dt class="metric-label-with-info">儲存目標 <InfoPopover Label="顯示儲存目標說明" Icon="i" Title="儲存目標" Text="Redis 使用的 Docker volume 或 host path。清理或備份前要確認這個位置。" /></dt><dd>@_monitoring.Redis.PersistentStorageName</dd></div>
                        <div class="monitoring-definition-span"><dt class="metric-label-with-info">容器 <InfoPopover Label="顯示容器說明" Icon="i" Title="容器" Text="目前偵測到的 Redis compose container、執行狀態、健康狀態與 restart 次數。" /></dt><dd>@ContainerSummary("redis")</dd></div>
                    </dl>
                </section>

                <section class="panel monitoring-telemetry-panel">
                    <div class="monitoring-telemetry-header">
                        <div>
                            <div class="panel-title">PostgreSQL</div>
                            <div class="settings-section-meta">資料庫大小、交易次數、buffer cache 命中率、I/O 量與容器流量。</div>
                        </div>
                        <span class="status-badge @StatusClass(_monitoring.Postgres.Status)">@StatusText(_monitoring.Postgres.Status)</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_monitoring.Postgres.Warning))
                    {
                        <div class="inline-error monitoring-inline-warning">@_monitoring.Postgres.Warning</div>
                    }

                    <div class="runtime-dependency-kpi-grid">
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">DB Size <InfoPopover Label="顯示 DB Size 說明" Icon="i" Title="DB Size" Text="目前 ContextHub PostgreSQL database 的實際資料大小。持續上升通常代表記憶、log、retrieval telemetry 或 job history 正在累積，需搭配資料保留策略與 table size 一起看。" /></span>
                            <strong>@DashboardFormatting.Bytes(_monitoring.Postgres.DatabaseSizeBytes)</strong>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">Buffer Hit Rate <InfoPopover Label="顯示 Buffer Hit Rate 說明" Icon="i" Title="Buffer Hit Rate" Text="PostgreSQL shared buffer hits / (hits + disk reads)。命中率下降通常代表 working set 變大、查詢掃描過多、索引不足或資料庫 memory 配置不足。" /></span>
                            <strong>@DashboardFormatting.Percent(_monitoring.Postgres.BlockCacheHitPercent)</strong>
                            <small>@DashboardFormatting.Integer(_monitoring.Postgres.BlockAccesses) block accesses</small>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">Connections <InfoPopover Label="顯示 Connections 說明" Icon="i" Title="Connections" Text="目前連到 PostgreSQL 的 active connections 數量。短暫升高通常正常；長時間接近連線上限時，可能是連線池設定、慢查詢或未釋放連線造成。" /></span>
                            <strong>@DashboardFormatting.Integer(_monitoring.Postgres.ActiveConnections)</strong>
                        </article>
                        <article class="runtime-dependency-kpi">
                            <span class="metric-label-with-info">Storage <InfoPopover Label="顯示 Storage 說明" Icon="i" Title="Storage" Text="PostgreSQL Docker volume 的粗略儲存占用。這是容器層級估算，可能與 DB Size 不完全一致；若快速成長，優先檢查資料表大小、索引與 WAL / volume 狀態。" /></span>
                            <strong>@DashboardFormatting.Bytes(_monitoring.Postgres.PersistentStorageBytes)</strong>
                        </article>
                    </div>

                    <dl class="definition-grid monitoring-definition-grid">
                        <div><dt class="metric-label-with-info">Committed <InfoPopover Label="顯示 Committed 說明" Icon="i" Title="Committed" Text="已成功 commit 的 transaction 累積數。這是整體寫入與查詢活動量指標；單看數值大小不是問題，重點是與 rolled back、延遲和錯誤率一起判斷。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.TransactionsCommitted)</dd></div>
                        <div><dt class="metric-label-with-info">Rolled Back <InfoPopover Label="顯示 Rolled Back 說明" Icon="i" Title="Rolled Back" Text="被 rollback 的 transaction 累積數。少量可能來自正常錯誤處理；若比例上升，通常要檢查例外、交易逾時、constraint violation 或應用程式重試策略。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.TransactionsRolledBack)</dd></div>
                        <div><dt class="metric-label-with-info">Blocks Read <InfoPopover Label="顯示 Blocks Read 說明" Icon="i" Title="Blocks Read" Text="PostgreSQL 從磁碟讀取的資料 block 數。相對 Blocks Hit 偏高時，代表 buffer cache 命中不足或查詢正在掃描大量資料，可能需要檢查索引、查詢條件與 cache / memory 配置。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.BlocksRead)</dd></div>
                        <div><dt class="metric-label-with-info">Blocks Hit <InfoPopover Label="顯示 Blocks Hit 說明" Icon="i" Title="Blocks Hit" Text="PostgreSQL 從 shared buffer cache 命中的資料 block 數。通常越高越好；和 Blocks Read 搭配可估算 cache hit ratio，命中率下降時要看是否有大查詢或 working set 變大。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.BlocksHit)</dd></div>
                        <div><dt class="metric-label-with-info">Rows Returned <InfoPopover Label="顯示 Rows Returned 說明" Icon="i" Title="Rows Returned" Text="查詢掃描或返回處理過的 row 累積量，通常反映讀取工作量。若明顯高於實際頁面需求，可能有過寬查詢、缺索引或列表未限制筆數。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.RowsReturned)</dd></div>
                        <div><dt class="metric-label-with-info">Rows Fetched <InfoPopover Label="顯示 Rows Fetched 說明" Icon="i" Title="Rows Fetched" Text="透過查詢取出的 row 累積量。可用來觀察應用程式實際取資料量；與 Rows Returned 差距過大時，通常要回頭看查詢計畫與資料掃描效率。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.RowsFetched)</dd></div>
                        <div><dt class="metric-label-with-info">Rows Inserted <InfoPopover Label="顯示 Rows Inserted 說明" Icon="i" Title="Rows Inserted" Text="新增 row 的累積數。上升代表記憶、log、job、source sync 或 telemetry 正在寫入；若速度異常，需檢查背景工作是否重複寫入或資料保留策略是否不足。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.RowsInserted)</dd></div>
                        <div><dt class="metric-label-with-info">Rows Updated <InfoPopover Label="顯示 Rows Updated 說明" Icon="i" Title="Rows Updated" Text="更新 row 的累積數。高更新量可能來自 job 狀態、summary refresh、偏好設定或同步狀態；若伴隨 table bloat 或慢查詢，需評估 vacuum 與索引更新成本。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.RowsUpdated)</dd></div>
                        <div><dt class="metric-label-with-info">Rows Deleted <InfoPopover Label="顯示 Rows Deleted 說明" Icon="i" Title="Rows Deleted" Text="刪除 row 的累積數。刪除後空間不一定立刻回到作業系統，仍需 autovacuum / vacuum 回收；若刪除量大，需觀察 table bloat 與 vacuum 是否跟得上。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.RowsDeleted)</dd></div>
                        <div><dt class="metric-label-with-info">Temp Files / Bytes <InfoPopover Label="顯示 Temp Files / Bytes 說明" Icon="i" Title="Temp Files / Bytes" Text="查詢排序、hash join 或中間結果超出記憶體時建立的暫存檔數與大小。持續增加通常代表查詢太大、work_mem 不足，或缺少能降低排序 / join 成本的索引。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.TempFiles) / @DashboardFormatting.Bytes(_monitoring.Postgres.TempBytes)</dd></div>
                        <div><dt class="metric-label-with-info">Deadlocks <InfoPopover Label="顯示 Deadlocks 說明" Icon="i" Title="Deadlocks" Text="PostgreSQL 偵測到互相等待鎖而中止其中一個 transaction 的次數。正常情況應接近 0；若出現增加，通常要檢查交易順序、鎖定範圍與長交易。" /></dt><dd>@DashboardFormatting.Integer(_monitoring.Postgres.Deadlocks)</dd></div>
                        <div><dt class="metric-label-with-info">Container Network <InfoPopover Label="顯示 Container Network 說明" Icon="i" Title="Container Network" Text="PostgreSQL container 層級的累積網路 RX / TX。它反映 DB 與其他服務間的傳輸量；突然升高時可對照查詢量、匯入匯出或背景同步。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Postgres.NetworkRxBytes) RX / @DashboardFormatting.Bytes(_monitoring.Postgres.NetworkTxBytes) TX</dd></div>
                        <div><dt class="metric-label-with-info">Container Disk I/O <InfoPopover Label="顯示 Container Disk I/O 說明" Icon="i" Title="Container Disk I/O" Text="PostgreSQL container 層級的累積磁碟讀寫量。高寫入通常與資料寫入、WAL、checkpoint 或 vacuum 有關；高讀取可能表示 cache miss 或大量掃描。" /></dt><dd>@DashboardFormatting.Bytes(_monitoring.Postgres.DiskReadBytes) Read / @DashboardFormatting.Bytes(_monitoring.Postgres.DiskWriteBytes) Write</dd></div>
                        <div class="monitoring-definition-span"><dt class="metric-label-with-info">Storage Target <InfoPopover Label="顯示 Storage Target 說明" Icon="i" Title="Storage Target" Text="PostgreSQL 使用的 Docker volume 名稱。用來確認資料落在哪個持久化儲存；備份、搬移或清理 volume 前應確認這個名稱。" /></dt><dd>@_monitoring.Postgres.PersistentStorageName</dd></div>
                        <div class="monitoring-definition-span"><dt class="metric-label-with-info">Container <InfoPopover Label="顯示 Container 說明" Icon="i" Title="Container" Text="目前偵測到的 PostgreSQL compose container、執行狀態、健康狀態與 restart 次數。若 health 非 healthy 或 restart 增加，優先看 container logs。" /></dt><dd>@ContainerSummary("postgres")</dd></div>
                    </dl>
                </section>
            </div>

            <section class="panel">
                <div class="panel-title">Compose 服務資源</div>
                <div class="table-scroll-shell table-scroll-shell-tall">
                    <table class="data-table monitoring-containers-table">
                        <thead>
                            <tr>
                                <th class="monitoring-service-col">服務 (Service)</th>
                                <th class="monitoring-container-col">容器 (Container)</th>
                                <th class="monitoring-state-col">狀態 (State)</th>
                                <th class="monitoring-cpu-col">CPU</th>
                                <th class="monitoring-memory-col">記憶體 (Memory)</th>
                                <th class="monitoring-network-col">網路 (Network)</th>
                                <th class="monitoring-disk-col">磁碟 I/O (Disk I/O)</th>
                                <th class="monitoring-restart-col">重啟次數 (Restart)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var container in _monitoring.DependencyResources?.Containers ?? [])
                            {
                                <tr>
                                    <td class="monitoring-service-cell">@ServiceDisplayName(container.Service)</td>
                                    <td class="monitoring-container-cell">@container.Name</td>
                                    <td class="monitoring-state-cell">
                                        <span class="status-badge @StatusClass(container.State)">@StatusText(container.State)</span>
                                        <span class="status-badge @StatusClass(container.Health)">@StatusText(container.Health)</span>
                                    </td>
                                    <td class="monitoring-cpu-cell">@DashboardFormatting.Percent(container.CpuPercent)</td>
                                    <td class="monitoring-memory-cell">@DashboardFormatting.Bytes(container.MemoryUsageBytes) / @DashboardFormatting.Bytes(container.MemoryLimitBytes)</td>
                                    <td class="monitoring-network-cell">@DashboardFormatting.Bytes(container.NetworkRxBytes) / @DashboardFormatting.Bytes(container.NetworkTxBytes)</td>
                                    <td class="monitoring-disk-cell">@DashboardFormatting.Bytes(container.DiskReadBytes) / @DashboardFormatting.Bytes(container.DiskWriteBytes)</td>
                                    <td class="monitoring-restart-cell">@DashboardFormatting.Integer(container.RestartCount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    </ChildContent>
</PageViewport>

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollingTask;
    private DashboardMonitoringResult? _monitoring;
    private string? _loadError;
    private bool _loading;
    private DateTimeOffset? _lastUpdatedAt;
    private InstanceSettingsSnapshot? _settingsSnapshot;
    private int PollingIntervalSeconds => _settingsSnapshot?.Behavior.SnapshotPolling.DependencyResourcesSeconds ?? 5;

    protected override async Task OnInitializedAsync()
    {
        _settingsSnapshot = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        await RefreshAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pollingTask = PollAsync(PollingIntervalSeconds);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _monitoring = await ApiClient.GetMonitoringAsync(_cts.Token);
        _loadError = null;
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadAsync();
            _lastUpdatedAt = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _loadError = DashboardUiErrorFormatter.BuildLoadError("狀態監控", ex, _monitoring is not null);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task PollAsync(int intervalSeconds)
    {
        if (intervalSeconds <= 0)
        {
            return Task.CompletedTask;
        }

        return Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(intervalSeconds));
            try
            {
                while (await timer.WaitForNextTickAsync(_cts.Token))
                {
                    try
                    {
                        await RefreshAsync();
                    }
                    catch (OperationCanceledException) when (_cts.IsCancellationRequested)
                    {
                    }
                    catch (Exception ex)
                    {
                        _loadError = DashboardUiErrorFormatter.BuildLoadError("狀態監控", ex, _monitoring is not null);
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private static string StatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "healthy" or "ready" or "running" => "ok",
            "degraded" or "warning" => "warn",
            "error" or "critical" or "failed" or "unhealthy" or "exited" or "unavailable" => "bad",
            _ => "neutral"
        };

    private static string StatusText(string status)
        => DashboardText.Status(status);

    private static string ServiceDisplayName(string name)
        => DashboardText.Service(name);

    private static string ContextSavingsConfidenceClass(string confidence)
        => confidence switch
        {
            ContextSavingsEstimator.HighConfidence => "ok",
            ContextSavingsEstimator.MediumConfidence => "warn",
            ContextSavingsEstimator.LowConfidence => "neutral",
            _ => "neutral"
        };

    private static string FormatTokenCount(int value)
        => $"{DashboardFormatting.Integer(value)} tokens";

    private static DashboardContextSavingsResult CreateEmptyContextSavings(DateTimeOffset now)
        => new(
            false,
            0,
            0,
            0,
            0,
            0d,
            ContextSavingsEstimator.LowConfidence,
            0d,
            0d,
            now.AddHours(-24),
            now,
            [],
            false,
            null,
            "最近 24 小時");

    private static IReadOnlyList<DashboardContextSavingsWindowResult> ContextSavingsWindows(DashboardContextSavingsResult savings)
        => savings.Windows is { Count: > 0 }
            ? savings.Windows
            :
            [
                new DashboardContextSavingsWindowResult(
                    "24h",
                    "24H",
                    savings.HasData,
                    savings.SampleCount,
                    savings.BaselineTokenEstimate,
                    savings.ReturnedTokenEstimate,
                    savings.EstimatedSavedTokens,
                    savings.AverageSavingPercent,
                    savings.Confidence,
                    savings.SourceCoveragePercent,
                    savings.CacheHitPercent,
                    savings.WindowStartedAtUtc,
                    savings.WindowEndedAtUtc,
                    savings.LastSampleAtUtc)
            ];

    private static string ContextSavingsStateText(DashboardContextSavingsResult savings)
        => savings.HasRecentData
            ? "成功的 working-context telemetry"
            : "等待 working-context telemetry";

    private static string ContextSavingsLastSampleText(DashboardContextSavingsResult savings)
        => savings.LastSampleAtUtc.HasValue
            ? savings.LastSampleAtUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")
            : "等待樣本";

    private static string ContextSavingsWindowText(DashboardContextSavingsResult savings)
        => savings.WindowLabel.Replace("最近", "主視窗：最近", StringComparison.Ordinal);

    private static string ContextSavingsConfidenceText(string confidence)
        => confidence switch
        {
            ContextSavingsEstimator.HighConfidence => "高",
            ContextSavingsEstimator.MediumConfidence => "中",
            ContextSavingsEstimator.LowConfidence => "低",
            _ => confidence
        };

    private string ResourceChartPanelNote()
        => $"每 {DashboardFormatting.Integer(PollingIntervalSeconds)} 秒刷新 / 最近 {DashboardFormatting.Integer(_monitoring?.ResourceSamples?.Count ?? 0)} 筆樣本";

    private double CurrentCpuPercent()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.CpuPercent ?? 0d;

    private double AverageCpuPercent()
        => _monitoring?.ResourceSamples?.Count > 0
            ? _monitoring.ResourceSamples.Average(x => x.CpuPercent)
            : 0d;

    private double CurrentMemoryPercent()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.MemoryPercent ?? 0d;

    private long CurrentMemoryUsageBytes()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.MemoryUsageBytes ?? 0L;

    private long AverageMemoryUsageBytes()
        => _monitoring?.ResourceSamples?.Count > 0
            ? (long)Math.Round(_monitoring.ResourceSamples.Average(x => x.MemoryUsageBytes))
            : 0L;

    private double CurrentNetworkRxBytesPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.NetworkRxBytesPerSecond ?? 0d;

    private double CurrentNetworkTxBytesPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.NetworkTxBytesPerSecond ?? 0d;

    private double AverageNetworkRxBytesPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? _monitoring.ResourceSamples.Average(x => x.NetworkRxBytesPerSecond)
            : 0d;

    private double AverageNetworkTxBytesPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? _monitoring.ResourceSamples.Average(x => x.NetworkTxBytesPerSecond)
            : 0d;

    private double CurrentDiskReadBytesPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.DiskReadBytesPerSecond ?? 0d;

    private double CurrentDiskWriteBytesPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.DiskWriteBytesPerSecond ?? 0d;

    private double AverageDiskReadBytesPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? _monitoring.ResourceSamples.Average(x => x.DiskReadBytesPerSecond)
            : 0d;

    private double AverageDiskWriteBytesPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? _monitoring.ResourceSamples.Average(x => x.DiskWriteBytesPerSecond)
            : 0d;

    private int CurrentInboundRequestsPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.InboundRequests ?? 0;

    private int CurrentOutboundRequestsPerSecond()
        => _monitoring?.ResourceSamples?.LastOrDefault()?.OutboundRequests ?? 0;

    private int AverageInboundRequestsPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? (int)Math.Round(_monitoring.ResourceSamples.Average(x => x.InboundRequests))
            : 0;

    private int AverageOutboundRequestsPerSecond()
        => _monitoring?.ResourceSamples?.Count > 0
            ? (int)Math.Round(_monitoring.ResourceSamples.Average(x => x.OutboundRequests))
            : 0;

    private double MaxCpuPercent()
        => Math.Max(_monitoring?.ResourceSamples?.Select(x => x.CpuPercent).DefaultIfEmpty(0d).Max() ?? 0d, 5d);

    private double MaxMemoryUsageChartValue()
        => Math.Max(_monitoring?.ResourceSamples?.Select(x => (double)x.MemoryUsageBytes).DefaultIfEmpty(0d).Max() ?? 0d, 1d);

    private double MaxNetworkRate()
        => Math.Max(
            _monitoring?.ResourceSamples?.SelectMany(x => new[] { x.NetworkRxBytesPerSecond, x.NetworkTxBytesPerSecond }).DefaultIfEmpty(0d).Max() ?? 0d,
            1d);

    private double MaxDiskRate()
        => Math.Max(
            _monitoring?.ResourceSamples?.SelectMany(x => new[] { x.DiskReadBytesPerSecond, x.DiskWriteBytesPerSecond }).DefaultIfEmpty(0d).Max() ?? 0d,
            1d);

    private double MaxRequestTrafficRate()
        => Math.Max(
            _monitoring?.ResourceSamples?.SelectMany(x => new[] { (double)x.InboundRequests, (double)x.OutboundRequests }).DefaultIfEmpty(0d).Max() ?? 0d,
            1d);

    private string ContainerSummary(string serviceName)
    {
        var container = _monitoring?.DependencyResources?.Containers.FirstOrDefault(x => string.Equals(x.Service, serviceName, StringComparison.OrdinalIgnoreCase));
        return container is null
            ? "未偵測 compose 容器"
            : $"{container.Name} / {StatusText(container.State)} / {StatusText(container.Health)} / restart {DashboardFormatting.Integer(container.RestartCount)}";
    }

    private static IEnumerable<int> ChartGuideLines()
        => [12, 36, 60, 84];

    private static string BuildLinePoints(IEnumerable<double> values, double? fixedMax = null)
    {
        const double width = 240d;
        const double height = 96d;
        const double paddingX = 6d;
        const double paddingY = 8d;

        var points = values.ToArray();
        if (points.Length == 0)
        {
            return string.Empty;
        }

        var max = fixedMax ?? Math.Max(points.Max(), 1d);
        max = Math.Max(max, 1d);

        if (points.Length == 1)
        {
            var singleY = height - paddingY - ((Math.Clamp(points[0], 0d, max) / max) * (height - (paddingY * 2d)));
            return $"{paddingX:0.##},{singleY:0.##} {width - paddingX:0.##},{singleY:0.##}";
        }

        var xStep = (width - (paddingX * 2d)) / (points.Length - 1d);
        return string.Join(
            " ",
            points.Select((value, index) =>
            {
                var x = paddingX + (xStep * index);
                var y = height - paddingY - ((Math.Clamp(value, 0d, max) / max) * (height - (paddingY * 2d)));
                return $"{x:0.##},{y:0.##}";
            }));
    }

    private static string FormatRate(double bytesPerSecond)
        => $"{DashboardFormatting.Bytes((long)Math.Round(bytesPerSecond))}/s";

    private static string FormatCountRate(int value)
        => $"{DashboardFormatting.Integer(value)}/s";

    private DashboardPageSnapshotStatusResult? PageSnapshotStatus()
        => _monitoring?.SnapshotStatus;

    private DateTimeOffset? PageSnapshotAtUtc()
        => _monitoring?.SnapshotStatus?.SnapshotAtUtc ?? _monitoring?.SnapshotAtUtc;

    private string? SnapshotWarningText()
        => DashboardUiErrorFormatter.BuildSnapshotWarning(PageSnapshotStatus(), "狀態監控");

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_pollingTask is not null)
        {
            _ = CompleteDisposeAsync(_pollingTask, _cts);
            return ValueTask.CompletedTask;
        }

        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private static async Task CompleteDisposeAsync(Task pollingTask, CancellationTokenSource cts)
    {
        try
        {
            await pollingTask;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            cts.Dispose();
        }
    }
}
