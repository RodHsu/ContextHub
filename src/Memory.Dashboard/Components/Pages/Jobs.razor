@page "/jobs"
@implements IAsyncDisposable
@inject IContextHubApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject IOptions<DashboardOptions> DashboardOptionsAccessor
@inject IDashboardRuntimeSettingsAccessor RuntimeSettingsAccessor
@using Memory.Dashboard.Services

<PageTitle>Context Hub | 工作佇列</PageTitle>

<PageViewport Title="工作佇列"
              Subtitle="查看背景工作狀態，並視需要排入 reindex。"
              BodyClass="page-viewport-body jobs-page-body">
    <Actions>
        <div class="page-actions-status">
            <RefreshStatus LastUpdatedAt="_lastUpdatedAt"
                           IsRefreshing="_loading"
                           PollingIntervalSeconds="@PollingIntervalSeconds" />
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="RunReindexAsync" disabled="@_loading">執行 Reindex</button>
        </div>
    </Actions>
    <ChildContent>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="inline-error">@_loadError</div>
    }

    <div class="split-layout jobs-control-layout">
    <section class="panel detail-panel">
        <div class="panel-title">知識庫維護</div>
        @if (_maintenance is null)
        {
            <div class="empty-inline">維護狀態載入中。</div>
        }
        else
        {
            <dl class="definition-grid">
                <div><dt>階段 (Phase)</dt><dd><span class="status-badge @MaintenanceStatusClass(_maintenance.Phase)">@_maintenance.Phase</span></dd></div>
                <div><dt>Run Id</dt><dd>@(_maintenance.RunId?.ToString("D") ?? "-")</dd></div>
                <div><dt>Active Leases</dt><dd>@DashboardFormatting.Integer(_maintenance.ActiveLeaseCount)</dd></div>
                <div><dt>預估結束</dt><dd>@if (_maintenance.EstimatedEndsAtUtc.HasValue) { <ClientLocalTime Value="_maintenance.EstimatedEndsAtUtc.Value" /> } else { <span>-</span> }</dd></div>
            </dl>
        }
        <div class="form-grid">
            <label>
                <span>原因 (Reason)</span>
                <input @bind="_maintenanceReason" />
            </label>
            <label>
                <span>訊息 (Message)</span>
                <input @bind="_maintenanceMessage" />
            </label>
            <label>
                <span>Drain 等待上限 (分鐘)</span>
                <input type="number" min="1" max="1440" @bind="_maintenanceMaxDrainWaitMinutes" />
            </label>
        </div>
        <div class="detail-actions">
            <button class="ghost-button" @onclick="ScheduleMaintenanceAsync" disabled="@MaintenanceActionDisabled">排程</button>
            <button class="ghost-button" @onclick="StartDrainAsync" disabled="@MaintenanceActionDisabled">Drain</button>
            <button class="primary-button" @onclick="StartMaintenanceAsync" disabled="@MaintenanceActionDisabled">開始</button>
            <button class="ghost-button" @onclick="CompleteMaintenanceAsync" disabled="@MaintenanceActionDisabled">完成</button>
            <button class="ghost-button" @onclick="CancelMaintenanceAsync" disabled="@MaintenanceActionDisabled">取消</button>
        </div>
    </section>

    <section class="panel jobs-reindex-panel">
        <div class="panel-heading-row">
            <div>
                <div class="panel-title">重新索引</div>
                <div class="panel-heading-meta panel-heading-meta-left">留空即使用 active model 與全量記憶；指定 Id 時只重建單筆。</div>
            </div>
            <button class="primary-button jobs-reindex-inline-button" @onclick="RunReindexAsync" disabled="@_loading">排入佇列</button>
        </div>
        <div class="form-grid jobs-reindex-grid">
            <label>
                <span>模型鍵值 (Model Key)</span>
                <input @bind="_modelKey" placeholder="可留空使用 active model" />
            </label>
            <label>
                <span>記憶項目 Id (Memory Item Id)</span>
                <input @bind="_memoryItemId" placeholder="可留空表示全量" />
            </label>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <DashboardToast Message="@_message" Sequence="@_messageSequence" OnDismiss="ClearMessage" />
        }
    </section>

    <section class="panel detail-panel">
        <div class="panel-heading-row">
            <div>
                <div class="panel-title">Memory Retention</div>
                <div class="panel-heading-meta panel-heading-meta-left">每日排程只產生分類清單；刪除需人工或 agent 明確觸發。</div>
            </div>
            <span class="status-badge neutral">@RetentionModeText</span>
        </div>

        <dl class="definition-grid">
            <div><dt>最近執行</dt><dd>@if (_lastRetentionRun?.CompletedAt.HasValue == true) { <ClientLocalTime Value="_lastRetentionRun.CompletedAt.Value" /> } else { <span>-</span> }</dd></div>
            <div><dt>Auto-delete</dt><dd>@DashboardFormatting.Integer(LastRetentionAutoDeleteCount)</dd></div>
            <div><dt>Review</dt><dd>@DashboardFormatting.Integer(LastRetentionReviewCount)</dd></div>
            <div><dt>狀態</dt><dd>@(_lastRetentionRun?.Status.ToString() ?? "-")</dd></div>
        </dl>

        <div class="detail-actions">
            <button class="ghost-button" @onclick="ClassifyRetentionAsync" disabled="@RetentionActionDisabled">產生清單</button>
            <button class="ghost-button" @onclick="PreviewRetentionDeleteAsync" disabled="@RetentionActionDisabled">預覽刪除</button>
            <button class="primary-button" @onclick="ApplyRetentionDeleteAsync" disabled="@(!CanApplyRetentionDelete)">確認套用 Auto-delete</button>
            <button class="ghost-button" @onclick="CopyRetentionResultAsync" disabled="@(_retentionResult is null)">複製結果</button>
        </div>

        @if (_retentionResult is not null)
        {
            <div class="subpanel-title">目前結果</div>
            <dl class="definition-grid">
                <div><dt>模式</dt><dd>@_retentionResult.Mode</dd></div>
                <div><dt>可自動刪除</dt><dd>@DashboardFormatting.Integer(_retentionResult.AutoDeleteCandidateCount)</dd></div>
                <div><dt>需審核</dt><dd>@DashboardFormatting.Integer(_retentionResult.ReviewCandidateCount)</dd></div>
                <div><dt>已刪除 items</dt><dd>@DashboardFormatting.Integer(_retentionResult.DeletedMemoryItems)</dd></div>
            </dl>

            @if (_retentionResult.BlockedReasons.Count > 0)
            {
                <div class="compact-chip-row">
                    @foreach (var reason in _retentionResult.BlockedReasons)
                    {
                        <span class="status-badge warn">@reason</span>
                    }
                </div>
            }

            <div class="table-scroll-shell">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>類別</th>
                            <th>記憶</th>
                            <th>訊號</th>
                            <th>建議</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var candidate in _retentionResult.AutoDeleteCandidates.Take(5))
                        {
                            <tr>
                                <td><span class="status-badge bad">Auto-delete</span></td>
                                <td class="truncate-cell" title="@candidate.MemoryId.ToString("D")">@candidate.Title</td>
                                <td>@CandidateSignalText(candidate)</td>
                                <td>@candidate.RecommendedAction</td>
                            </tr>
                        }
                        @foreach (var candidate in _retentionResult.ReviewCandidates.Take(5))
                        {
                            <tr>
                                <td><span class="status-badge warn">Review</span></td>
                                <td class="truncate-cell" title="@candidate.MemoryId.ToString("D")">@candidate.Title</td>
                                <td>@CandidateSignalText(candidate)</td>
                                <td>@candidate.RecommendedAction</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel detail-panel">
        <div class="panel-title">工作篩選</div>
        <div class="filter-grid">
            <select @bind="_status">
                <option value="">全部狀態</option>
                @foreach (var status in Enum.GetValues<MemoryJobStatus>())
                {
                    <option value="@status">@DashboardText.Label(status)</option>
                }
            </select>
            <select @bind="_jobType">
                <option value="">全部類型</option>
                @foreach (var type in Enum.GetValues<MemoryJobType>())
                {
                    <option value="@type">@DashboardText.Label(type)</option>
                }
            </select>
            <button class="ghost-button" @onclick="LoadAsync">查詢</button>
        </div>
    </section>
    </div>

    <div class="split-layout jobs-workspace-layout">
    <section class="panel panel-scroll jobs-list-panel">
        <div class="panel-title">背景工作 (@(_jobs is null ? "-" : DashboardFormatting.Integer(_jobs.TotalCount)))</div>
        <div class="panel-scroll-body detail-scroll-shell">
            @if (_jobs is null)
            {
                <div class="skeleton-stack">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="skeleton-line @(i == 0 ? "skeleton-line-md" : "skeleton-line-lg")"></div>
                    }
                </div>
            }
            else
            {
                <div class="table-scroll-shell">
                    <table class="data-table jobs-table">
                        <colgroup>
                            <col class="jobs-table-col-time" />
                            <col class="jobs-table-col-id" />
                            <col class="jobs-table-col-type" />
                            <col class="jobs-table-col-status" />
                            <col class="jobs-table-col-payload" />
                            <col class="jobs-table-col-error" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>建立時間</th>
                                <th>工作 Id</th>
                                <th>類型</th>
                                <th>狀態</th>
                                <th>內容摘要</th>
                                <th>錯誤</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _jobs.Items)
                            {
                                <tr class="@SelectedClass(job.Id)" @onclick="@(() => SelectJob(job))">
                                    <td class="jobs-time-cell"><ClientLocalTime Value="job.CreatedAt" /></td>
                                    <td class="jobs-id-cell" title="@job.Id.ToString("D")">@job.Id</td>
                                    <td>@DashboardText.Label(job.JobType)</td>
                                    <td><span class="status-badge @StatusClass(job.Status.ToString())">@DashboardText.Label(job.Status)</span></td>
                                    <td class="truncate-cell jobs-payload-cell" title="@job.PayloadJson">@job.PayloadJson</td>
                                    <td class="truncate-cell jobs-error-cell" title="@job.Error">@(!string.IsNullOrWhiteSpace(job.Error) ? job.Error : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="panel detail-panel panel-scroll">
        <div class="panel-title">工作細節</div>
        <div class="panel-scroll-body detail-scroll-shell">
            @if (_selectedJob is null)
            {
                <div class="empty-inline">點選左側工作列顯示詳細內容。</div>
            }
            else
            {
                <div class="detail-actions">
                    <button class="ghost-button" @onclick="CopySelectedJobAsync">複製 JSON</button>
                    <span class="detail-actions-copy">包含 job id、status、payload 與 error，適合直接貼給 agent 分析。</span>
                </div>

                <dl class="definition-grid">
                    <div class="job-detail-id-row"><dt>工作 Id</dt><dd class="job-detail-id">@_selectedJob.Id</dd></div>
                    <div><dt>工作類型</dt><dd>@DashboardText.Label(_selectedJob.JobType)</dd></div>
                    <div><dt>狀態</dt><dd>@DashboardText.Label(_selectedJob.Status)</dd></div>
                    <div><dt>建立時間</dt><dd><ClientLocalTime Value="_selectedJob.CreatedAt" /></dd></div>
                    <div><dt>開始時間</dt><dd>@if (_selectedJob.StartedAt.HasValue) { <ClientLocalTime Value="_selectedJob.StartedAt.Value" /> } else { <span>-</span> }</dd></div>
                    <div><dt>完成時間</dt><dd>@if (_selectedJob.CompletedAt.HasValue) { <ClientLocalTime Value="_selectedJob.CompletedAt.Value" /> } else { <span>-</span> }</dd></div>
                </dl>

                <div class="subpanel-title">內容 (Payload)</div>
                <div class="code-block">@_selectedJob.PayloadJson</div>

                @if (!string.IsNullOrWhiteSpace(_selectedJob.Error))
                {
                    <div class="subpanel-title">錯誤 (Error)</div>
                    <div class="code-block">@_selectedJob.Error</div>
                }
            }
        </div>
    </section>
    </div>
    </ChildContent>
</PageViewport>

@code {
    private readonly CancellationTokenSource _cts = new();
    private Task? _pollingTask;
    private string? _status;
    private string? _jobType;
    private string? _modelKey;
    private string? _memoryItemId;
    private string _maintenanceReason = "Knowledge base update";
    private string _maintenanceMessage = "ContextHub is preparing for knowledge base maintenance. New writes may be paused while active work drains.";
    private int _maintenanceMaxDrainWaitMinutes = 15;
    private string? _message;
    private long _messageSequence;
    private PagedResult<JobListItemResult>? _jobs;
    private MaintenanceStatusResult? _maintenance;
    private IReadOnlyList<MaintenanceRunResult> _maintenanceRuns = [];
    private MaintenanceRunResult? _lastRetentionRun;
    private MemoryDataRetentionRunResult? _retentionResult;
    private JobListItemResult? _selectedJob;
    private bool _loading;
    private bool _maintenanceBusy;
    private bool _retentionBusy;
    private DateTimeOffset? _lastUpdatedAt;
    private string? _loadError;
    private InstanceSettingsSnapshot? _settingsSnapshot;
    private int PollingIntervalSeconds => _settingsSnapshot?.Behavior.JobsPollingSeconds ?? DashboardOptionsAccessor.Value.Polling.JobsSeconds;
    private bool MaintenanceActionDisabled => _loading || _maintenanceBusy;
    private bool RetentionActionDisabled => _loading || _retentionBusy;
    private bool CanApplyRetentionDelete => !RetentionActionDisabled &&
        _retentionResult?.Mode == MemoryDataRetentionRunMode.PreviewDelete &&
        _retentionResult.AutoDeleteCandidateCount > 0;
    private string RetentionModeText => _retentionResult?.Mode.ToString() ?? "Classification";
    private long LastRetentionAutoDeleteCount => _retentionResult?.AutoDeleteCandidateCount ?? ReadRetentionCount(_lastRetentionRun, "autoDeleteCandidateCount");
    private long LastRetentionReviewCount => _retentionResult?.ReviewCandidateCount ?? ReadRetentionCount(_lastRetentionRun, "reviewCandidateCount");

    protected override async Task OnInitializedAsync()
    {
        _settingsSnapshot = await RuntimeSettingsAccessor.GetCurrentAsync(_cts.Token);
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pollingTask = PollAsync(PollingIntervalSeconds);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _maintenance = await ApiClient.GetMaintenanceStatusAsync(_cts.Token);
            _maintenanceRuns = await ApiClient.GetMaintenanceRunsAsync(25, _cts.Token);
            _lastRetentionRun = _maintenanceRuns
                .Where(x => x.MaintenanceType == MaintenanceRunType.MemoryDataRetention)
                .OrderByDescending(x => x.StartedAt)
                .FirstOrDefault();
            _jobs = await ApiClient.GetJobsAsync(
                new JobListRequest(
                    Parse<MemoryJobStatus>(_status),
                    Parse<MemoryJobType>(_jobType),
                    1,
                    25),
                _cts.Token);
            _selectedJob = _selectedJob is null
                ? _jobs.Items.FirstOrDefault()
                : _jobs.Items.FirstOrDefault(x => x.Id == _selectedJob.Id) ?? _jobs.Items.FirstOrDefault();
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _loadError = null;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _loadError = DashboardUiErrorFormatter.BuildLoadError("工作佇列", ex, _jobs is not null);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunReindexAsync()
    {
        try
        {
            Guid? memoryItemId = Guid.TryParse(_memoryItemId, out var parsed) ? parsed : null;
            var result = await ApiClient.EnqueueReindexAsync(new EnqueueReindexRequest(_modelKey, memoryItemId), _cts.Token);
            ShowMessage($"已建立 reindex job: {result.JobId}");
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            ShowMessage(DashboardUiErrorFormatter.BuildActionError("建立 Reindex 工作", ex));
        }
    }

    private async Task ScheduleMaintenanceAsync()
    {
        await RunMaintenanceActionAsync(
            "排程維護",
            () => ApiClient.ScheduleMaintenanceAsync(
                new MaintenanceWindowRequest(
                    Reason: _maintenanceReason,
                    Message: _maintenanceMessage,
                    MaxDrainWaitMinutes: _maintenanceMaxDrainWaitMinutes),
                _cts.Token));
    }

    private async Task StartDrainAsync()
        => await RunMaintenanceActionAsync("開始 Drain", () => ApiClient.StartMaintenanceDrainAsync(_maintenance?.RunId, _cts.Token));

    private async Task StartMaintenanceAsync()
        => await RunMaintenanceActionAsync("開始維護", () => ApiClient.StartMaintenanceAsync(_maintenance?.RunId, _cts.Token));

    private async Task CompleteMaintenanceAsync()
        => await RunMaintenanceActionAsync("完成維護", () => ApiClient.CompleteMaintenanceAsync(_maintenance?.RunId, _cts.Token));

    private async Task CancelMaintenanceAsync()
        => await RunMaintenanceActionAsync("取消維護", () => ApiClient.CancelMaintenanceAsync(_maintenance?.RunId, _cts.Token));

    private async Task RunMaintenanceActionAsync(string actionName, Func<Task<MaintenanceStatusResult>> action)
    {
        _maintenanceBusy = true;
        try
        {
            _maintenance = await action();
            ShowMessage($"{actionName} 已送出，目前階段: {_maintenance.Phase}");
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            ShowMessage(DashboardUiErrorFormatter.BuildActionError(actionName, ex));
        }
        finally
        {
            _maintenanceBusy = false;
        }
    }

    private async Task ClassifyRetentionAsync()
        => await RunRetentionAsync(
            "產生 retention 清單",
            new MemoryDataRetentionRunRequest(
                TriggeredBy: "dashboard",
                Mode: MemoryDataRetentionRunMode.Classify,
                IncludeCandidateDetails: true));

    private async Task PreviewRetentionDeleteAsync()
        => await RunRetentionAsync(
            "預覽 auto-delete",
            new MemoryDataRetentionRunRequest(
                TriggeredBy: "dashboard",
                Mode: MemoryDataRetentionRunMode.PreviewDelete,
                IncludeCandidateDetails: true));

    private async Task ApplyRetentionDeleteAsync()
        => await RunRetentionAsync(
            "套用 auto-delete",
            new MemoryDataRetentionRunRequest(
                TriggeredBy: "dashboard",
                Mode: MemoryDataRetentionRunMode.ApplyAutoDelete,
                IncludeCandidateDetails: true));

    private async Task RunRetentionAsync(string actionName, MemoryDataRetentionRunRequest request)
    {
        _retentionBusy = true;
        try
        {
            _retentionResult = await ApiClient.RunMemoryDataRetentionAsync(request, _cts.Token);
            ShowMessage($"{actionName} 已完成：Auto-delete {_retentionResult.AutoDeleteCandidateCount}，Review {_retentionResult.ReviewCandidateCount}。");
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            ShowMessage(DashboardUiErrorFormatter.BuildActionError(actionName, ex));
        }
        finally
        {
            _retentionBusy = false;
        }
    }

    private void SelectJob(JobListItemResult job)
        => _selectedJob = job;

    private async Task CopySelectedJobAsync()
    {
        if (_selectedJob is null)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("contextHubDashboard.copyText", JobClipboardFormatter.Format(_selectedJob));
            ShowMessage($"已複製工作 {_selectedJob.Id} 的 JSON。");
        }
        catch (JSException)
        {
            ShowMessage("複製失敗，請改用手動複製工作內容。");
        }
    }

    private async Task CopyRetentionResultAsync()
    {
        if (_retentionResult is null)
        {
            return;
        }

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_retentionResult, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)
            {
                WriteIndented = true
            });
            await JsRuntime.InvokeVoidAsync("contextHubDashboard.copyText", json);
            ShowMessage("已複製 retention 結果，可交給 agent 進一步判斷。");
        }
        catch (JSException)
        {
            ShowMessage("複製失敗，請改用手動複製 retention 結果。");
        }
    }

    private void ShowMessage(string message)
    {
        _message = message;
        _messageSequence++;
    }

    private void ClearMessage()
        => _message = null;

    private Task PollAsync(int intervalSeconds)
    {
        if (intervalSeconds <= 0)
        {
            return Task.CompletedTask;
        }

        return Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(intervalSeconds));
            try
            {
                while (await timer.WaitForNextTickAsync(_cts.Token))
                {
                    try
                    {
                        await LoadAsync();
                    }
                    catch (OperationCanceledException) when (_cts.IsCancellationRequested)
                    {
                    }
                    catch (Exception ex)
                    {
                        _loadError = DashboardUiErrorFormatter.BuildLoadError("工作佇列", ex, _jobs is not null);
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private static TEnum? Parse<TEnum>(string? value)
        where TEnum : struct, Enum
        => Enum.TryParse<TEnum>(value, true, out var parsed) ? parsed : null;

    private static string StatusClass(string status)
        => status.ToLowerInvariant() switch
        {
            "completed" => "ok",
            "pending" or "running" => "warn",
            "failed" => "bad",
            _ => "neutral"
        };

    private static string MaintenanceStatusClass(MaintenancePhase phase)
        => phase switch
        {
            MaintenancePhase.Inactive => "ok",
            MaintenancePhase.Scheduled => "warn",
            MaintenancePhase.Draining => "warn",
            MaintenancePhase.Running => "bad",
            MaintenancePhase.Completed => "ok",
            MaintenancePhase.Cancelled => "neutral",
            _ => "bad"
        };

    private string SelectedClass(Guid id)
        => _selectedJob?.Id == id ? "selected-row" : string.Empty;

    private static string CandidateSignalText(MemoryDataRetentionCandidateResult candidate)
        => $"hit {DashboardFormatting.Integer(candidate.RecentHitCount)}、link {DashboardFormatting.Integer(candidate.LinkDegree)}、I {candidate.Importance:0.##}、C {candidate.Confidence:0.##}";

    private static long ReadRetentionCount(MaintenanceRunResult? run, string propertyName)
    {
        if (run is null || string.IsNullOrWhiteSpace(run.ResultJson))
        {
            return 0;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(run.ResultJson);
            return document.RootElement.TryGetProperty(propertyName, out var value) && value.TryGetInt64(out var count)
                ? count
                : 0;
        }
        catch (System.Text.Json.JsonException)
        {
            return 0;
        }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_pollingTask is not null)
        {
            _ = CompleteDisposeAsync(_pollingTask, _cts);
            return ValueTask.CompletedTask;
        }

        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    private static async Task CompleteDisposeAsync(Task pollingTask, CancellationTokenSource cts)
    {
        try
        {
            await pollingTask;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            cts.Dispose();
        }
    }
}
