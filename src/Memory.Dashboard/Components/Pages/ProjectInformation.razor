@page "/project-information"
@inject IContextHubApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Context Hub | 專案資訊</PageTitle>

<PageViewport Title="專案資訊"
              Subtitle="為協作與 build_working_context 維護專案的固定背景。">
    <Actions>
        <div class="page-actions-secondary">
            <button class="ghost-button" @onclick="LoadAsync" disabled="@(_loading || string.IsNullOrWhiteSpace(_projectId))">重新載入</button>
            <button class="ghost-button" @onclick="EnableEditing" disabled="@(_loading || string.IsNullOrWhiteSpace(_projectId))">編輯內容</button>
        </div>
        <div class="page-actions-primary">
            <button class="primary-button" @onclick="SaveAsync" disabled="@(_loading || !_editing)">儲存變更</button>
        </div>
    </Actions>
    <ChildContent>
        <section class="project-studio">
            <aside class="project-identity">
                <div class="studio-eyebrow">目前專案</div>
                <label class="project-picker-label">
                    <span>專案</span>
                    <select class="project-select" @bind="_projectId" @bind:after="SelectProjectAsync" disabled="@_loading" aria-label="選擇專案">
                            <option value="">選擇專案</option>
                            @foreach (var project in _projects)
                            {
                                <option value="@project.Information.ProjectId">@ProjectLabel(project.Information)</option>
                            }
                    </select>
                    <small>從清單切換專案</small>
                </label>
                <label class="inactive-toggle">
                    <input type="checkbox" @bind="_includeInactive" @bind:after="RefreshProjectsAsync" disabled="@_loading" />
                    顯示已隱藏或封存項目
                </label>
                <dl class="project-facts">
                    <div><dt>Project ID</dt><dd>@_projectId</dd></div>
                    <div><dt>最後更新</dt><dd>@(_information?.UpdatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm") ?? "尚未建立")</dd></div>
                </dl>
                <section class="project-context-contract">
                    <span>Context contract</span>
                    <p><code>system:project-information</code></p>
                    <small>每次建立 working context 時，會先載入這份固定背景。</small>
                </section>
                <section class="project-context-contract">
                    <span>下屬專案</span>
                    <details class="child-projects-picker" aria-label="選擇下屬專案">
                        <summary><span>@ChildProjectsSelectionText</span><small>展開複選</small></summary>
                        <div class="child-projects-picker-options">
                            @foreach (var project in _projects.Where(project => !string.Equals(project.Information.ProjectId, _projectId, StringComparison.OrdinalIgnoreCase)))
                            {
                                var childProjectId = project.Information.ProjectId;
                                <label>
                                    <input type="checkbox"
                                           checked="@_childProjectIds.Contains(childProjectId, StringComparer.OrdinalIgnoreCase)"
                                           @onchange="@(() => ToggleChildProject(childProjectId))"
                                           disabled="@(_loading || string.IsNullOrWhiteSpace(_projectId))" />
                                    <span>@ProjectLabel(project.Information)</span>
                                </label>
                            }
                        </div>
                    </details>
                    <button class="lifecycle-action" @onclick="SaveChildrenAsync" disabled="@(_loading || string.IsNullOrWhiteSpace(_projectId))">儲存下屬專案</button>
                    <small>按住 Ctrl／Cmd 可複選。用於表示此專案管理哪些 repo；不會自動授權、共享記憶或加入討論。</small>
                </section>
            </aside>

            <main class="project-editor">
                <div class="studio-eyebrow">專案概覽</div>
                <label class="display-name-field">
                    <span>顯示名稱</span>
                    <input @bind="_displayName" disabled="@(!_editing)" placeholder="ContextHub" />
                </label>
                <div class="editor-divider"></div>
                <label class="description-field">
                    <span>專案描述</span>
                    <small>這段資料會在每次建立 working context 時先提供給代理人。</small>
                    <textarea @bind="_description" disabled="@(!_editing)" placeholder="產品目標、系統邊界、主要技術選擇與工作時必須遵守的固定背景。"></textarea>
                </label>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <p class="project-feedback">@_message</p>
                }
            </main>

            <aside class="lifecycle-inspector">
                <div class="studio-eyebrow">專案生命週期</div>
                <div class="lifecycle-status"><span class="status-dot"></span><span>@LifecycleStatusLabel</span></div>
                <p>@LifecycleDescription</p>
                <dl class="lifecycle-facts">
                    <div><dt>背景注入</dt><dd>@ContextAvailabilityDescription</dd></div>
                    <div><dt>顯示範圍</dt><dd>@VisibilityDescription</dd></div>
                </dl>
                <div class="lifecycle-rule">
                    <span>封存後規則</span>
                    <strong>7 天後符合安全刪除資格</strong>
                    <small>@SafeDeleteDescription（本階段不執行刪除）</small>
                </div>
                <div class="lifecycle-actions">
                    <button class="lifecycle-action" @onclick="ToggleHiddenAsync" disabled="@_loading">@(_information?.IsHidden == true ? "取消隱藏專案" : "隱藏專案")</button>
                    <button class="lifecycle-action" @onclick="ToggleArchivedAsync" disabled="@_loading">@(_information?.IsArchived == true ? "還原專案" : "封存專案")</button>
                </div>
            </aside>
        </section>
    </ChildContent>
</PageViewport>

@code {
    private string _projectId = string.Empty;
    private string _displayName = string.Empty;
    private string _description = string.Empty;
    private IReadOnlyList<ProjectInformationListItem> _projects = [];
    private ProjectInformationResult? _information;
    private string? _message;
    private bool _loading;
    private bool _editing;
    private bool _includeInactive;
    private string[] _childProjectIds = [];
    private bool _initialized;

    [SupplyParameterFromQuery(Name = "projectId")]
    public string? ProjectIdQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshProjectsAsync();
        _projectId = ResolveProjectId(ProjectIdQuery);
        _initialized = true;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            return;
        }

        var projectId = ResolveProjectId(ProjectIdQuery);
        if (string.Equals(_projectId, projectId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _projectId = projectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_projectId))
        {
            return;
        }

        _loading = true;
        try
        {
            var result = await ApiClient.GetProjectInformationAsync(_projectId.Trim(), CancellationToken.None);
            _displayName = result?.DisplayName ?? _projectId.Trim();
            _description = result?.Description ?? string.Empty;
            _information = result;
            var hierarchy = await ApiClient.GetProjectChildrenAsync(_projectId.Trim(), CancellationToken.None);
            _childProjectIds = hierarchy.ChildProjectIds.ToArray();
            _editing = false;
            _message = result is null ? "尚未建立此專案的資訊。" : $"最後更新：{result.UpdatedAt.LocalDateTime:g}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectProjectAsync()
    {
        var projectId = ResolveProjectId(_projectId);
        if (string.IsNullOrWhiteSpace(projectId))
        {
            return;
        }

        Navigation.NavigateTo($"/project-information?projectId={Uri.EscapeDataString(projectId)}", forceLoad: true);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_projectId))
        {
            _message = "請先輸入 ProjectId。";
            return;
        }

        _loading = true;
        try
        {
            var result = await ApiClient.UpsertProjectInformationAsync(
                new ProjectInformationUpdateRequest(_projectId.Trim(), _displayName, _description),
                CancellationToken.None);
            _displayName = result.DisplayName;
            _description = result.Description;
            _information = result;
            _editing = false;
            _message = "專案資訊已儲存，後續工作上下文會自動帶入。";
        }
        finally
        {
            _loading = false;
        }
    }

    private void EnableEditing()
    {
        _editing = true;
        _message = "已進入編輯模式。";
    }

    private async Task ToggleHiddenAsync()
    {
        await UpdateLifecycleAsync(_information?.IsHidden == true ? ProjectLifecycleAction.Unhide : ProjectLifecycleAction.Hide);
    }

    private async Task ToggleArchivedAsync()
    {
        await UpdateLifecycleAsync(_information?.IsArchived == true ? ProjectLifecycleAction.Restore : ProjectLifecycleAction.Archive);
    }

    private async Task UpdateLifecycleAsync(ProjectLifecycleAction action)
    {
        if (string.IsNullOrWhiteSpace(_projectId))
        {
            return;
        }

        _loading = true;
        try
        {
            _information = await ApiClient.UpdateProjectLifecycleAsync(new ProjectLifecycleUpdateRequest(_projectId.Trim(), action), CancellationToken.None);
            _displayName = _information.DisplayName;
            _description = _information.Description;
            _message = action switch
            {
                ProjectLifecycleAction.Hide => "專案已從一般選單隱藏。",
                ProjectLifecycleAction.Unhide => "專案已恢復顯示。",
                ProjectLifecycleAction.Archive => "專案已封存，預設搜尋與工作脈絡不再讀取其記憶。",
                _ => "專案已還原，預設搜尋與工作脈絡會重新讀取其記憶。"
            };
            await RefreshProjectsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveChildrenAsync()
    {
        _loading = true;
        try
        {
            var childProjectIds = _childProjectIds
                .Where(projectId => !string.IsNullOrWhiteSpace(projectId))
                .Where(projectId => !string.Equals(projectId, _projectId, StringComparison.OrdinalIgnoreCase))
                .Select(projectId => projectId.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            var hierarchy = await ApiClient.SetProjectChildrenAsync(new ProjectHierarchySetChildrenRequest(_projectId.Trim(), childProjectIds), CancellationToken.None);
            _childProjectIds = hierarchy.ChildProjectIds.ToArray();
            _message = "下屬專案設定已儲存；權限與資料範圍維持不變。";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task RefreshProjectsAsync()
        => RefreshProjectsCoreAsync();

    private async Task RefreshProjectsCoreAsync()
        => _projects = await ApiClient.GetProjectInformationProjectsAsync(_includeInactive, CancellationToken.None);

    private string ResolveProjectId(string? requestedProjectId)
        => _projects.FirstOrDefault(project => string.Equals(project.Information.ProjectId, requestedProjectId, StringComparison.OrdinalIgnoreCase))?.Information.ProjectId
            ?? _projects.FirstOrDefault()?.Information.ProjectId
            ?? string.Empty;

    private static string ProjectLabel(ProjectInformationResult project)
        => string.Equals(project.DisplayName, project.ProjectId, StringComparison.OrdinalIgnoreCase)
            ? project.ProjectId
            : $"{project.DisplayName} ({project.ProjectId})";

    private string ChildProjectsSelectionText => _childProjectIds.Length switch
    {
        0 => "選擇下屬專案",
        1 => _childProjectIds[0],
        _ => $"已選擇 {_childProjectIds.Length} 個下屬專案"
    };

    private void ToggleChildProject(string projectId)
    {
        _childProjectIds = _childProjectIds.Contains(projectId, StringComparer.OrdinalIgnoreCase)
            ? _childProjectIds.Where(item => !string.Equals(item, projectId, StringComparison.OrdinalIgnoreCase)).ToArray()
            : [.. _childProjectIds, projectId];
    }

    private string LifecycleDescription => _information switch
    {
        { IsArchived: true } => "已封存：一般搜尋與工作脈絡不會讀取此專案記憶。",
        { IsHidden: true } => "已隱藏：資料保留，僅不顯示於一般專案選單。",
        _ => "使用中：資料會參與一般搜尋與工作脈絡。"
    };

    private string LifecycleStatusLabel => _information switch
    {
        { IsArchived: true } => "已封存",
        { IsHidden: true } => "已隱藏",
        _ => "使用中"
    };

    private string ContextAvailabilityDescription
        => _information?.IsArchived == true ? "暫停" : "啟用";

    private string VisibilityDescription
        => _information?.IsHidden == true ? "僅於進階選單顯示" : "一般專案選單顯示";

    private string SafeDeleteDescription => _information?.SafeDeleteEligibleAt is not { } eligibleAt
        ? "尚未封存"
        : eligibleAt <= DateTimeOffset.UtcNow
            ? "已符合資格"
            : $"{eligibleAt.LocalDateTime:g} 起可用";
}
