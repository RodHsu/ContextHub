@using Memory.Application

<label>
    <span>@Label</span>
    <select value="@Value" @onchange="OnChanged" disabled="@Disabled">
        <option value="@ProjectContext.AllProjectIdsSentinel">全部</option>
        @if (!IsKnownValue && !string.IsNullOrWhiteSpace(Value))
        {
            <option value="@Value">自訂：@Value</option>
        }
        @foreach (var option in NormalizedOptions)
        {
            <option value="@option">@option</option>
        }
    </select>
</label>

@code {
    [Parameter]
    public string Label { get; set; } = "Allowed ProjectIds";

    [Parameter]
    public string Value { get; set; } = ProjectContext.DefaultProjectId;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> Options { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    private IReadOnlyList<string> NormalizedOptions
        => Options
            .Append(ProjectContext.DefaultProjectId)
            .Where(projectId => !string.IsNullOrWhiteSpace(projectId))
            .Where(projectId => !string.Equals(projectId, ProjectContext.AllProjectIdsSentinel, StringComparison.OrdinalIgnoreCase))
            .Select(projectId => ProjectContext.Normalize(projectId))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(projectId => projectId, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private bool IsKnownValue
        => string.Equals(Value, ProjectContext.AllProjectIdsSentinel, StringComparison.OrdinalIgnoreCase) ||
           NormalizedOptions.Any(option => string.Equals(option, Value, StringComparison.OrdinalIgnoreCase));

    private async Task OnChanged(ChangeEventArgs args)
        => await ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
