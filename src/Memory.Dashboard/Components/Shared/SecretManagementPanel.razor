@implements IDisposable
@inject IContextHubApiClient ApiClient

<section class="panel" aria-label="Credential 管理資訊">
    <div class="panel-title">管理資訊</div>
    <p>僅既有管理讀者可取得；不顯示操作者、用途、目標或拒絕細節。紀錄為安全投影，並非完整稽核證據。</p>
    <div class="button-row" role="group" aria-label="管理資訊頁籤">
        <button class="ghost-button" @onclick="@(() => ReadAsync(SecretManagementTab.Expiry))">版本期限</button>
        <button class="ghost-button" @onclick="@(() => ReadAsync(SecretManagementTab.Leases))">租約狀態</button>
        <button class="ghost-button" @onclick="@(() => ReadAsync(SecretManagementTab.History))">使用歷史</button>
    </div>
    @if (State.Loading)
    {
        <DashboardAsyncState State="loading" Title="讀取管理資訊" Message="正在驗證目前所選 credential 的管理讀取範圍。" />
    }
    else if (State.Error is { } error)
    {
        <DashboardAsyncState State="error" Title="管理資訊不可用" Message="@error" />
    }
    else if (State.Expiry is { } expiry)
    {
        <dl class="definition-grid">
            <div><dt>讀回 revision</dt><dd>@expiry.Revision</dd></div>
            <div><dt>Current version</dt><dd>@(expiry.CurrentVersion?.ToString() ?? "未知／尚無版本")</dd></div>
            <div><dt>Version state</dt><dd>@(expiry.VersionState?.ToString() ?? "未知")</dd></div>
            <div><dt>Expires</dt><dd>@if (expiry.ExpiresAt is { } expires) { <ClientLocalTime Value="expires" /> } else { <span>未設定／未知；不代表永久有效</span> }</dd></div>
        </dl>
    }
    else if (State.Leases is { } leases)
    {
        <div class="table-scroll-shell" tabindex="0" aria-label="安全租約狀態">
            <table class="data-table"><thead><tr><th>Kind</th><th>State</th><th>Expires</th><th>Expired</th><th>Used</th><th>Remaining</th><th>Active</th></tr></thead><tbody>
            @foreach (var lease in leases.Items)
            {
                <tr><td>@lease.Kind</td><td>@lease.State</td><td><ClientLocalTime Value="lease.ExpiresAt" /></td><td>@lease.IsExpired</td><td>@lease.UsedCount</td><td>@lease.RemainingUses</td><td>@lease.ActiveUses</td></tr>
            }
            </tbody></table>
        </div>
        @if (leases.Items.Count == 0) { <p>本頁沒有可顯示的租約；不表示存在可使用能力。</p> }
    }
    else if (State.History is { } history)
    {
        <div class="table-scroll-shell" tabindex="0" aria-label="遮罩後使用歷史">
            <table class="data-table"><thead><tr><th>Operation</th><th>Time</th></tr></thead><tbody>
            @foreach (var entry in history.Items) { <tr><td>@entry.Operation</td><td><ClientLocalTime Value="entry.CreatedAt" /></td></tr> }
            </tbody></table>
        </div>
        <p>操作者、用途、目標及拒絕細節保持遮罩；空頁不代表沒有其他稽核紀錄。</p>
    }
    @if (!State.Loading && (State.Leases is not null || State.History is not null))
    {
        <div class="button-row">
            <button class="ghost-button" disabled="@(State.Offset == 0)" @onclick="@(() => State.LoadAsync(State.Tab, Math.Max(0, State.Offset - SecretManagementReadState.PageSize)))">上一頁</button>
            <button class="ghost-button" disabled="@(!State.HasMore)" @onclick="@(() => State.LoadAsync(State.Tab, State.Offset + SecretManagementReadState.PageSize))">下一頁</button>
        </div>
        <p>分頁是即時查詢，資料變動時可能移動；不提供全量計數或不可變快照。</p>
    }
</section>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [Parameter] public Guid SecretId { get; set; }
    [Parameter] public long Revision { get; set; }
    private SecretManagementReadState? _state;
    private SecretManagementReadState State => _state ??= new(ApiClient);
    protected override void OnParametersSet() => State.Bind(ProjectId, SecretId, Revision);
    private Task ReadAsync(SecretManagementTab tab) => State.LoadAsync(tab);
    public void Dispose() => _state?.Dispose();
}
