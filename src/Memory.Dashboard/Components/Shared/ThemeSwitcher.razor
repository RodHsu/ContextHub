@inject IJSRuntime JsRuntime

<label class="theme-switcher">
    <span class="theme-switcher-toggle-label">主題</span>
    <select class="theme-switcher-toggle" aria-label="主題" @bind="_preference" @bind:after="SetThemeAsync">
        <option value="light">淺色</option>
        <option value="dark">深色</option>
        <option value="black">純黑</option>
        <option value="system">跟隨系統</option>
    </select>
</label>

@code {
    private string _preference = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _preference = await JsRuntime.InvokeAsync<string>("contextHubTheme.initialize");
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            _preference = "dark";
        }
    }

    private async Task SetThemeAsync()
        => await JsRuntime.InvokeVoidAsync("contextHubTheme.setPreference", _preference);
}
