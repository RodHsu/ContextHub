{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=contexthub;Username=contexthub;Password=contexthub",
    "Redis": "localhost:6379"
  },
  "Memory": {
    "Namespace": "contexthub"
  },
  "ProjectArtifacts": {
    "ObjectStorage": {
      "Enabled": false,
      "Provider": "r2",
      "Endpoint": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Bucket": "",
      "Region": "auto",
      "PublicBaseUrl": "",
      "MaxObjectBytes": 10485760
    }
  },
  "ChatGptGateway": {
    "OAuth": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email" ],
      "SubjectClaim": "sub",
      "EmailClaim": "email",
      "NameClaim": "name",
      "SelfHosted": false,
      "SelfHostedIssuer": "",
      "SelfHostedSigningKey": "",
      "AllowedRedirectUris": [],
      "AllowedRedirectUriPrefixes": [],
      "AuthorizationCodeLifetimeMinutes": 5,
      "AccessTokenLifetimeMinutes": 60,
      "IncludeIssuerInAuthorizationResponse": false,
      "TestMode": false,
      "TestBearerToken": ""
    },
    "ContextHub": {
      "BaseUrl": "http://localhost:8080",
      "ServiceToken": ""
    },
    "PublicMcpUrl": "",
    "PublicResourceMetadataUrl": "",
    "MaxResponseCharacters": 120000
  },
  "AutonomousGovernance": {
    "RetentionPolicyVersion": "2026-08-28-v1",
    "MachineExecutionEvidenceGraceDays": 7,
    "RuntimeNoiseGraceDays": 14,
    "AutomatedEpisodeGraceDays": 30,
    "TemporaryArtifactGraceDays": 30,
    "HitWindowDays": 30,
    "MaxRecentHitCount": 0,
    "MaxLinkDegree": 0,
    "MaxImportance": 0.35,
    "MaxConfidence": 0.60
  },
  "Embeddings": {
    "Provider": "Deterministic",
    "Profile": "compact",
    "ModelKey": "",
    "Dimensions": 0,
    "MaxTokens": 0,
    "InferenceThreads": 0,
    "BatchSize": 0
  },
  "DatabaseLogging": {
    "MinimumLevel": "Warning",
    "BatchSize": 50,
    "FlushIntervalSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
