  "orchestration": {
    "prompt": "At each scheduled run, obtain the published contract, create a new run identifier, review the complete server scope, and obey only the server decision. Use the reversible operation only when the decision authorizes it; then read the receipt, replay the identical request only after outcome recovery requires it, and perform a same-run review. Stop and report on a human-decision or incomplete-coverage decision. Never invent scope, endpoint, authority, or operation controls.",
    "runIdPolicy": "fresh-per-schedule",
    "scopePolicy": "server-resolved-complete-authorized-scope",
    "projectSelection": "server-only",
    "branches": [
      {
        "decision": "NoOpConverged",
        "calls": ["scheduled_governance_run_get"],
        "terminalAction": "read-receipt-and-finish"
      },
      {
        "decision": "ReversibleExecutionRequired",
        "calls": [
          "scheduled_governance_execute",
          "scheduled_governance_run_get",
          "scheduled_governance_review",
          "scheduled_governance_run_get"
        ],
        "terminalAction": "bounded-execute-recover-re-review"
      },
      {
        "decision": "HumanDecisionOnly",
        "calls": [],
        "terminalAction": "stop-and-report"
      },
      {
        "decision": "CoverageIncomplete",
        "calls": [],
        "terminalAction": "fail-closed-and-report"
      }
    ]
  },
